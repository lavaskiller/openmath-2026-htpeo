def RH2F.DMS : Prop :=
∀ (G : MGraph), G.Subcubic → G.Loopless → ∀ (P : Fin G.m → Prop), MGraph.Colourable P 6
RH2Fid.fidelity_bundle : ((RH2F.Hyp ↔ RH2Fid.HP) ∧ (RH2F.II ↔ RH2Fid.IIP) ∧ (RH2F.DMS ↔ RH2Fid.DMSP)) ∧
  (RH2Fid.HP → RH2Fid.IIP → RH2Fid.DMSP) ∧
    (RH2Fid.LooplessP (RH2Fid.fullEn RH2Fid.wK4) ∧
        RH2Fid.CubicP (RH2Fid.fullEn RH2Fid.wK4) ∧
          RH2Fid.BridgelessP (RH2Fid.fullEn RH2Fid.wK4) ∧
            RH2Fid.ConnectedP (RH2Fid.fullEn RH2Fid.wK4) ∧
              RH2Fid.StarP (RH2Fid.fullEn RH2Fid.wK4) RH2Fid.cK4 ∧
                ¬RH2Fid.StarP (RH2Fid.fullEn RH2Fid.wK4) RH2Fid.cK4bad) ∧
      (RH2Fid.StarP (RH2Fid.fullEn MGraph.k33) MGraph.k33Col ∧
          ¬RH2Fid.StarP (RH2Fid.fullEn MGraph.k33) RH2Fid.cK33bad ∧ RH2Fid.TwoCutReducedP (RH2Fid.fullEn MGraph.k33)) ∧
        (RH2Fid.StarP (RH2Fid.fullEn RH2Fid.wPrism) RH2Fid.cPrism ∧
            ¬RH2Fid.StarP (RH2Fid.fullEn RH2Fid.wPrism) RH2Fid.cPrismBad) ∧
          (RH2Fid.CubicP (RH2Fid.fullEn RH2Fid.wDig) ∧
              RH2Fid.BridgelessP (RH2Fid.fullEn RH2Fid.wDig) ∧
                RH2Fid.StarP (RH2Fid.fullEn RH2Fid.wDig) RH2Fid.cDig ∧
                  ¬RH2Fid.StarP (RH2Fid.fullEn RH2Fid.wDig) RH2Fid.cDigBad) ∧
            (RH2Fid.Star6P (RH2Fid.enT (RH2Fid.fullEn RH2Fid.wK4) RH2Fid.g0 ⟨0, ⋯⟩ ⟨1, ⋯⟩) ∧
                ¬RH2Fid.CubicP (RH2Fid.enT (RH2Fid.fullEn RH2Fid.wK4) RH2Fid.g0 ⟨0, ⋯⟩ ⟨1, ⋯⟩) ∧
                  RH2Fid.IsBridge (RH2Fid.enT (RH2Fid.fullEn RH2Fid.wK4) RH2Fid.g0 ⟨0, ⋯⟩ ⟨1, ⋯⟩) (Sum.inr 2)) ∧
              ((RH2F.InG RH2Fid.wD8 fun x => True) ∧ ¬RH2Fid.TwoCutReducedP (RH2Fid.fullEn RH2Fid.wD8)) ∧
                (RH2F.InG RH2Fid.wPet fun x => True) ∧
                  (10 ≤ RH2F.vcount fun x => True) ∧ RH2F.TwoCutReducedOn fun x => True
