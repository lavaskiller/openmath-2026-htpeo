  have pBG : X.c (X.S.copy i).eBC ≠ X.c (X.S.copy i).eCX :=
    hs.1 _ _ (PiRigidLean.adjOf (jsymm (X.S.copy i).jBC) (X.S.copy i).jCX (X.S.copy i).dBX (X.S.copy i).dCX)
  have eY : X.c' (X.S.ey i) = Fin.castSucc (PiRigidLean.twin (X.S.copy i) X.c) := X.hC.hy i
  have eP : X.c' (X.S.pp i) = Fin.castSucc (X.c (X.S.copy i).eAu) := by
    rw [X.hC.hold _ (X.S.Ppp i) (pp_old X.S i), ← X.S.cAu i]
  have eQ : X.c' (X.S.pq i) = Fin.castSucc (X.c (X.S.copy i).eBv) := by
    rw [X.hC.hold _ (X.S.Ppq i) (pq_old X.S i), ← X.S.cBv i]
  have jAC : H.Joins (X.S.copy i).eAC (X.S.copy i).C (X.S.φ (X.S.p i)) := by
    have h := jsymm (X.S.copy i).jAC; rw [X.S.cA i] at h; exact h
  have jAY : H.Joins (X.S.copy i).eAY (X.S.copy i).Y (X.S.φ (X.S.p i)) := by
    have h := jsymm (X.S.copy i).jAY; rw [X.S.cA i] at h; exact h
  have jBC : H.Joins (X.S.copy i).eBC (X.S.copy i).C (X.S.φ (X.S.q i)) := by
    have h := jsymm (X.S.copy i).jBC; rw [X.S.cB i] at h; exact h
  have jBZ : H.Joins (X.S.copy i).eBZ (X.S.copy i).Z (X.S.φ (X.S.q i)) := by
    have h := jsymm (X.S.copy i).jBZ; rw [X.S.cB i] at h; exact h
  rcases PiRigidLean.pi_rigidity (X.S.copy i) X.c X.hc with
    ⟨⟨hε1, hε2, hε3⟩, ⟨h1, _, _, h4, h5, h6, h7, h8, h9⟩ | ⟨_, _, _, h4, h5, h6, h7, h8, h9⟩⟩
  · -- type T1: twin = c(BC), c(Bv) = γ, c(Au) ∈ {δ, ε}
    have tw := PiSubLean.twin_eq_of (P := X.S.copy i) (c := X.c) h1
    rcases h9 with hA | hA
    · -- c(Au) = δ: κA = a, κB = 6, λ = ε
      exact dig_AB X i hg (Fin.castSucc (X.c (X.S.copy i).eAC)) (Fin.last 5) (Fin.castSucc (X.c (X.S.copy i).eYZ))
        (castSucc_ne_last _) (csne (Ne.symm hε1)) (lcs _)
        ⟨by rw [eY, tw]; exact csne pAB, by rw [eP, hA]; exact csne (Ne.symm h5)⟩
        ⟨by rw [eY]; exact lcs _, by rw [eQ]; exact lcs _⟩
        (by rw [eQ, h4]; exact csne pAG) (by rw [eP]; exact lcs _)
        (Or.inr ⟨_, _, jAC, X.S.newC i, rfl⟩) (Or.inl rfl)
        ⟨by rw [eY, tw]; exact csne hε2, by rw [eP, hA]; exact csne (Ne.symm h8), by rw [eQ, h4]; exact csne hε3⟩
    · -- c(Au) = ε: κA = 6, κB = δ, λ = a
      exact dig_AB X i hg (Fin.last 5) (Fin.castSucc (X.c (X.S.copy i).eBZ)) (Fin.castSucc (X.c (X.S.copy i).eAC))
        (lcs _) (lcs _) (csne h5)
