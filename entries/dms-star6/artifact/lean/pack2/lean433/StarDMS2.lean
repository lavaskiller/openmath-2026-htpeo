variable {G : MGraph}

/-- looplessness (same body as `MGraph.Loopless` of the library fact modules) -/
def Loopless (G : MGraph) : Prop := ∀ f : Fin G.m, (G.ends f).1 ≠ (G.ends f).2

theorem joins_symm {f : Fin G.m} {x y : Fin G.n} (h : G.Joins f x y) : G.Joins f y x := Or.symm h

theorem adjOf {e f : Fin G.m} {x y z : Fin G.n} (h1 : G.Joins e x y) (h2 : G.Joins f x z)
    (hyz : y ≠ z) (hxz : x ≠ z) : G.Adj e f := by
  refine ⟨?_, x, joins_inc_left h1, joins_inc_left h2⟩
  intro hef
  subst hef
  rcases joins_unique h1 h2 with ⟨_, h⟩ | ⟨h, _⟩
  · exact hyz h
  · exact hxz h

theorem inc_joins {f : Fin G.m} {x : Fin G.n} (h : G.Inc f x) : ∃ y, G.Joins f y x := by
  rcases h with h | h
  · subst h
    exact ⟨(G.ends f).2, Or.inr rfl⟩
  · subst h
    exact ⟨(G.ends f).1, Or.inl rfl⟩

theorem joins_ne (hl : Loopless G) {f : Fin G.m} {x y : Fin G.n} (h : G.Joins f x y) : x ≠ y := by
  intro hxy
  subst hxy
  rcases h with h | h <;> exact hl f (by rw [h])

/-- if all edges at `s` are `e1 e2 e3` (joining `s` to `p1 p2 p3`) and `f` joins `w` to `u` with `u ∉ {s,p1,p2,p3}`,
    then `w ≠ s` -/
theorem far_ne3 {f e1 e2 e3 : Fin G.m} {w u s p1 p2 p3 : Fin G.n}
    (hf : G.Joins f w u) (hs : ∀ g, G.Inc g s → g = e1 ∨ g = e2 ∨ g = e3)
    (j1 : G.Joins e1 s p1) (j2 : G.Joins e2 s p2) (j3 : G.Joins e3 s p3)
    (hus : u ≠ s) (h1 : u ≠ p1) (h2 : u ≠ p2) (h3 : u ≠ p3) : w ≠ s := by
  intro hw
  rw [hw] at hf
  rcases hs f (joins_inc_left hf) with h | h | h
  · rw [h] at hf
    rcases joins_unique hf j1 with ⟨_, h'⟩ | ⟨_, h'⟩
    · exact h1 h'
    · exact hus h'
  · rw [h] at hf
    rcases joins_unique hf j2 with ⟨_, h'⟩ | ⟨_, h'⟩
    · exact h2 h'
    · exact hus h'
  · rw [h] at hf
    rcases joins_unique hf j3 with ⟨_, h'⟩ | ⟨_, h'⟩
    · exact h3 h'
    · exact hus h'

/-- variant where the third edge at `s` is excluded (`f ≠ e3`) -/
theorem far_ne2 {f e1 e2 e3 : Fin G.m} {w u s p1 p2 : Fin G.n}
    (hf : G.Joins f w u) (hs : ∀ g, G.Inc g s → g = e1 ∨ g = e2 ∨ g = e3) (hne : f ≠ e3)
    (j1 : G.Joins e1 s p1) (j2 : G.Joins e2 s p2)
    (hus : u ≠ s) (h1 : u ≠ p1) (h2 : u ≠ p2) : w ≠ s := by
  intro hw
  rw [hw] at hf
  rcases hs f (joins_inc_left hf) with h | h | h
  · rw [h] at hf
    rcases joins_unique hf j1 with ⟨_, h'⟩ | ⟨_, h'⟩
    · exact h1 h'
    · exact hus h'
  · rw [h] at hf
    rcases joins_unique hf j2 with ⟨_, h'⟩ | ⟨_, h'⟩
    · exact h2 h'
    · exact hus h'
  · exact hne h

/-- a copy of Π (prism K₃□K₂ minus the triangle edge AB) with ports A, B and port edges Au, Bv -/
structure PiCopy (G : MGraph) where
  A : Fin G.n
  B : Fin G.n
  C : Fin G.n
  X : Fin G.n
  Y : Fin G.n
  Z : Fin G.n
  u : Fin G.n
  v : Fin G.n
  eAC : Fin G.m
  eBC : Fin G.m
  eCX : Fin G.m
  eAY : Fin G.m
  eBZ : Fin G.m
  eXY : Fin G.m
  eYZ : Fin G.m
  eXZ : Fin G.m
  eAu : Fin G.m
  eBv : Fin G.m
  jAC : G.Joins eAC A C
  jBC : G.Joins eBC B C
  jCX : G.Joins eCX C X
  jAY : G.Joins eAY A Y
  jBZ : G.Joins eBZ B Z
  jXY : G.Joins eXY X Y
  jYZ : G.Joins eYZ Y Z
  jXZ : G.Joins eXZ X Z
  jAu : G.Joins eAu A u
  jBv : G.Joins eBv B v
  dAB : A ≠ B
  dAC : A ≠ C
  dAX : A ≠ X
  dAY : A ≠ Y
  dAZ : A ≠ Z
  dBC : B ≠ C
  dBX : B ≠ X
  dBY : B ≠ Y
  dBZ : B ≠ Z
  dCX : C ≠ X
  dCY : C ≠ Y
  dCZ : C ≠ Z
  dXY : X ≠ Y
  dXZ : X ≠ Z
  dYZ : Y ≠ Z
  duA : u ≠ A
  duB : u ≠ B
  duC : u ≠ C
  duX : u ≠ X
  duY : u ≠ Y
  duZ : u ≠ Z
  dvA : v ≠ A
  dvB : v ≠ B
  dvC : v ≠ C
  dvX : v ≠ X
  dvY : v ≠ Y
  dvZ : v ≠ Z

/-- the only edges at A, B, C, X, Y, Z are the ten listed edges -/
structure PiLocal (P : PiCopy G) : Prop where
  incA : ∀ f, G.Inc f P.A → f = P.eAC ∨ f = P.eAY ∨ f = P.eAu
  incB : ∀ f, G.Inc f P.B → f = P.eBC ∨ f = P.eBZ ∨ f = P.eBv
  incC : ∀ f, G.Inc f P.C → f = P.eAC ∨ f = P.eBC ∨ f = P.eCX
  incX : ∀ f, G.Inc f P.X → f = P.eCX ∨ f = P.eXY ∨ f = P.eXZ
  incY : ∀ f, G.Inc f P.Y → f = P.eAY ∨ f = P.eXY ∨ f = P.eYZ
  incZ : ∀ f, G.Inc f P.Z → f = P.eBZ ∨ f = P.eXZ ∨ f = P.eYZ

/-- the twin colour y of fact 4e2aa0cd3acb025a -/
def twin (P : PiCopy G) (c : Fin G.m → Fin 5) : Fin 5 := if c P.eAY = c P.eBC then c P.eBC else c P.eAC

/-- the conclusion of Π-rigidity (fact 09009674d378cc27, with fact b4814b38654ccf72 (a)): ε := c(YZ) ∉ {a,b,γ}, and
    T1: c AY = b, c XZ = a, c XY = c BZ = δ ∉ {a,b,γ,ε}, c Bv = γ, c Au ∈ {δ, ε};  or
    T2: c BZ = a, c XY = b, c XZ = c AY = δ ∉ {a,b,γ,ε}, c Au = γ, c Bv ∈ {δ, ε}. -/
def RigidConcl (P : PiCopy G) (c : Fin G.m → Fin 5) : Prop :=
  ((c P.eYZ ≠ c P.eAC ∧ c P.eYZ ≠ c P.eBC ∧ c P.eYZ ≠ c P.eCX) ∧ ((c P.eAY = c P.eBC ∧ c P.eXZ = c P.eAC ∧ c P.eXY = c P.eBZ ∧ c P.eBv = c P.eCX ∧ c P.eBZ ≠ c P.eAC ∧ c P.eBZ ≠ c P.eBC ∧ c P.eBZ ≠ c P.eCX ∧ c P.eBZ ≠ c P.eYZ ∧ (c P.eAu = c P.eBZ ∨ c P.eAu = c P.eYZ)) ∨ (c P.eBZ = c P.eAC ∧ c P.eXY = c P.eBC ∧ c P.eXZ = c P.eAY ∧ c P.eAu = c P.eCX ∧ c P.eAY ≠ c P.eAC ∧ c P.eAY ≠ c P.eBC ∧ c P.eAY ≠ c P.eCX ∧ c P.eAY ≠ c P.eYZ ∧ (c P.eBv = c P.eAY ∨ c P.eBv = c P.eYZ))))

/-- **Π-rigidity** (facts b4814b38654ccf72 (a) and 09009674d378cc27). -/
theorem pi_rigidity (P : PiCopy G) (c : Fin G.m → Fin 5) (hc : G.Star 5 c) : RigidConcl P c := by
  have hs := (star_iff 5 c).1 hc
  have q0 : c P.eAC ≠ c P.eBC := hs.1 _ _ (adjOf (joins_symm P.jAC) (joins_symm P.jBC) P.dAB (Ne.symm P.dBC))
