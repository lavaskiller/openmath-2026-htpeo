            ([(0,3),(1,3),(2,3),(0,4),(1,4),(2,4),(0,5),(1,5),(2,5)] : List (Fin 6 × Fin 6)).getD i.val (0,0) })
            (pe f) (pv x) (pv y)) →
        (∀ (x : Fin G.n) (f f' : Fin G.m), G.Inc f x → G.Inc f' x → pe f = pe f' → f = f') →
        (∀ (x y y' : Fin G.n) (f f' : Fin G.m), G.Joins f x y → G.Joins f' x y' → pv y = pv y' → y = y') →
        ∃ c : Fin G.m → Fin 6, MGraph.Star (G := G) 6 c) ∧
      (∀ (G : MGraph) (pv : Fin G.n → Fin 10) (pe : Fin G.m → Fin 15),
        (∀ (f : Fin G.m) (x y : Fin G.n), G.Joins f x y →
          MGraph.Joins (G := { n := 10, m := 15, ends := fun i =>
            ([(0,1),(1,2),(2,3),(3,4),(4,0),(0,5),(1,6),(2,7),(3,8),(4,9),(5,7),(7,9),(9,6),(6,8),(8,5)] :
              List (Fin 10 × Fin 10)).getD i.val (0,0) })
            (pe f) (pv x) (pv y)) →
        (∀ (x : Fin G.n) (f f' : Fin G.m), G.Inc f x → G.Inc f' x → pe f = pe f' → f = f') →
        (∀ (x y y' : Fin G.n) (f f' : Fin G.m), G.Joins f x y → G.Joins f' x y' → pv y = pv y' → y = y') →
        ∃ c : Fin G.m → Fin 5, MGraph.Star (G := G) 5 c)
    := by
  refine ⟨?_, ?_, ?_⟩
  · intro G H pv pe k c hl ha hb hc hH
    exact star_pullback pv pe hl ha hb hc hH
  · intro G pv pe ha hb hc
    exact ⟨fun f => k33c (pe f), star_pullback (H := K33) pv pe k33_loopless ha hb hc k33_star⟩
