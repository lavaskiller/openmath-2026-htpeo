-- Lean proof of fact d9fbe3906514b798 (PiSubLean.pi_subst); added by fact_submit, do not edit
/-
  PiSub.lean — Lean formalisation (core Lean 4, no Mathlib) of the replacement lemma (A) of fact 85bb5f970f208c0b
  (Π-substitution): a star 5-colouring `c` of `H = G^Π(𝒟)` gives a star 6-colouring `c'` of `G`, where every digon
  of `𝒟` gets colour 6 (`Fin.last 5`) on one edge and its twin colour on the other, and every other edge of `G`
  keeps its `H`-colour.

  `G^Π(𝒟)` is described relationally (`PiSubst G H k`): an injective vertex map `φ : V(G) → V(H)`, the `k` digons
  (vertices `p i ≠ q i`, six-edge `e6 i`, twin-edge `ey i`, port edges `pp i` at `p i` and `pq i` at `q i`, and
  these are the only edges at `p i`, `q i`), a map `old` sending every non-digon edge of `G` injectively to an edge of
  `H` with the `φ`-images of its ends, and for every digon a copy `copy i : PiCopy H` of Π with ports `φ (p i)`,
  `φ (q i)`, port edges `old (pp i)`, `old (pq i)` and new vertices `C, Y, Z` outside the image of `φ`.
  Main theorem: `PiSubLean.pi_subst`.
-/

namespace PiSubLean
open MGraph PiRigidLean

variable {G H : MGraph}

/-! ### colour consequences of Π-rigidity -/

theorem port_ne {P : PiCopy H} {c : Fin H.m → Fin 5} (h : RigidConcl P c) : c P.eAu ≠ c P.eBv := by
  rcases h with ⟨⟨_, _, hε3⟩, ⟨_, _, _, h4, _, _, h7, _, h9⟩ | ⟨_, _, _, h4, _, _, h7, _, h9⟩⟩
  · rw [h4]
    rcases h9 with h | h <;> rw [h]
    · exact h7
    · exact hε3
  · rw [h4]
    rcases h9 with h | h <;> rw [h]
    · exact fun e => h7 e.symm
    · exact fun e => hε3 e.symm

theorem twin_eq_of {P : PiCopy H} {c : Fin H.m → Fin 5} (h : c P.eAY = c P.eBC) : twin P c = c P.eBC := if_pos h

theorem twin_eq_of_not {P : PiCopy H} {c : Fin H.m → Fin 5} (h : ¬ c P.eAY = c P.eBC) : twin P c = c P.eAC :=
  if_neg h

theorem portA_ne_twin {c : Fin H.m → Fin 5} (hc : H.Star 5 c) (P : PiCopy H) : c P.eAu ≠ twin P c := by
  have hs := (star_iff 5 c).1 hc
  have hr := pi_rigidity P c hc
  have hACX : c P.eAC ≠ c P.eCX := hs.1 _ _ (adjOf (joins_symm P.jAC) P.jCX P.dAX P.dCX)
  rcases hr with ⟨⟨_, hε2, _⟩, ⟨h1, _, _, _, _, h6, _, _, h9⟩ | ⟨_, _, _, h4, _, h6, _, _, _⟩⟩
  · rw [twin_eq_of h1]
    rcases h9 with h | h <;> rw [h]
    · exact h6
    · exact hε2
  · rw [twin_eq_of_not h6, h4]
    exact fun e => hACX e.symm

theorem portB_ne_twin {c : Fin H.m → Fin 5} (hc : H.Star 5 c) (P : PiCopy H) : c P.eBv ≠ twin P c := by
  have hs := (star_iff 5 c).1 hc
  have hr := pi_rigidity P c hc
  have hBCX : c P.eBC ≠ c P.eCX := hs.1 _ _ (adjOf (joins_symm P.jBC) P.jCX P.dBX P.dCX)
  rcases hr with ⟨⟨hε1, _, _⟩, ⟨h1, _, _, h4, _, _, _, _, _⟩ | ⟨_, _, _, _, h5, h6, _, _, h9⟩⟩
  · rw [twin_eq_of h1, h4]
    exact fun e => hBCX e.symm
  · rw [twin_eq_of_not h6]
    rcases h9 with h | h <;> rw [h]
    · exact h5
    · exact hε1

/-- a Π-edge at the port `A` with the twin colour; its other end is `C` or `Y` -/
theorem twinA (P : PiCopy H) (c : Fin H.m → Fin 5) :
    ∃ τ σ, H.Joins τ P.A σ ∧ c τ = twin P c ∧ (σ = P.C ∨ σ = P.Y) := by
  rcases Classical.em (c P.eAY = c P.eBC) with h | h
  · exact ⟨P.eAY, P.Y, P.jAY, by rw [twin_eq_of h]; exact h, Or.inr rfl⟩
  · exact ⟨P.eAC, P.C, P.jAC, by rw [twin_eq_of_not h], Or.inl rfl⟩

/-- a Π-edge at the port `B` with the twin colour; its other end is `C` or `Z` -/
theorem twinB {c : Fin H.m → Fin 5} (hc : H.Star 5 c) (P : PiCopy H) :
    ∃ τ σ, H.Joins τ P.B σ ∧ c τ = twin P c ∧ (σ = P.C ∨ σ = P.Z) := by
  rcases Classical.em (c P.eAY = c P.eBC) with h | h
  · exact ⟨P.eBC, P.C, P.jBC, by rw [twin_eq_of h], Or.inl rfl⟩
  · have hr := pi_rigidity P c hc
    rcases hr with ⟨_, ⟨h1, _⟩ | ⟨h1, _⟩⟩
    · exact absurd h1 h
    · exact ⟨P.eBZ, P.Z, P.jBZ, by rw [twin_eq_of_not h]; exact h1, Or.inr rfl⟩

/-! ### the relational description of `G^Π(𝒟)` -/

structure PiSubst (G H : MGraph) (k : Nat) where
  φ : Fin G.n → Fin H.n
  φinj : ∀ x y, φ x = φ y → x = y
  p : Fin k → Fin G.n
  q : Fin k → Fin G.n
  e6 : Fin k → Fin G.m
  ey : Fin k → Fin G.m
  pp : Fin k → Fin G.m
  pq : Fin k → Fin G.m
  hpq : ∀ i, p i ≠ q i
  j6 : ∀ i, G.Joins (e6 i) (p i) (q i)
  jy : ∀ i, G.Joins (ey i) (p i) (q i)
  incp : ∀ i f, G.Inc f (p i) → f = e6 i ∨ f = ey i ∨ f = pp i
  incq : ∀ i f, G.Inc f (q i) → f = e6 i ∨ f = ey i ∨ f = pq i
  disj : ∀ i j, i ≠ j → p i ≠ p j ∧ p i ≠ q j ∧ q i ≠ p j ∧ q i ≠ q j
  ppOld : ∀ i j, pp i ≠ e6 j ∧ pp i ≠ ey j
  pqOld : ∀ i j, pq i ≠ e6 j ∧ pq i ≠ ey j
  old : Fin G.m → Fin H.m
  oldJ : ∀ f x y, (∀ i, f ≠ e6 i ∧ f ≠ ey i) → G.Joins f x y → H.Joins (old f) (φ x) (φ y)
  oldInj : ∀ f g, (∀ i, f ≠ e6 i ∧ f ≠ ey i) → (∀ i, g ≠ e6 i ∧ g ≠ ey i) → old f = old g → f = g
  copy : Fin k → PiCopy H
  cA : ∀ i, (copy i).A = φ (p i)
  cB : ∀ i, (copy i).B = φ (q i)
  cAu : ∀ i, (copy i).eAu = old (pp i)
  cBv : ∀ i, (copy i).eBv = old (pq i)
  newC : ∀ i x, (copy i).C ≠ φ x
  newY : ∀ i x, (copy i).Y ≠ φ x
  newZ : ∀ i x, (copy i).Z ≠ φ x

variable {k : Nat}

/-- an edge of `G` that is not a digon edge of `𝒟` -/
def PiSubst.IsOld (S : PiSubst G H k) (f : Fin G.m) : Prop := ∀ i, f ≠ S.e6 i ∧ f ≠ S.ey i

/-- the colouring `c'` of (A): colour 6 (`Fin.last 5`) on `e6 i`, the twin colour on `ey i`, `c ∘ old` elsewhere -/
structure SubColour (S : PiSubst G H k) (c : Fin H.m → Fin 5) (c' : Fin G.m → Fin 6) : Prop where
  h6 : ∀ i, c' (S.e6 i) = Fin.last 5
  hy : ∀ i, c' (S.ey i) = Fin.castSucc (twin (S.copy i) c)
  hold : ∀ f, S.IsOld f → c' f = Fin.castSucc (c (S.old f))

variable {S : PiSubst G H k} {c : Fin H.m → Fin 5} {c' : Fin G.m → Fin 6}

theorem six_of_last (hC : SubColour S c c') {f : Fin G.m} (h : c' f = Fin.last 5) : ∃ i, f = S.e6 i := by
  apply Classical.byContradiction
  intro hno
  rcases Classical.em (∃ i, f = S.ey i) with ⟨i, hi⟩ | hy
  · rw [hi, hC.hy i] at h
    exact castSucc_ne_last _ h
  · have hold : S.IsOld f := fun i => ⟨fun e => hno ⟨i, e⟩, fun e => hy ⟨i, e⟩⟩
    rw [hC.hold f hold] at h
    exact castSucc_ne_last _ h

theorem pp_old (S : PiSubst G H k) (i : Fin k) : S.IsOld (S.pp i) := fun j => S.ppOld i j
theorem pq_old (S : PiSubst G H k) (i : Fin k) : S.IsOld (S.pq i) := fun j => S.pqOld i j

/-- the two port edges of a digon have different `c'`-colours -/
theorem port_colour_ne (hc : H.Star 5 c) (hC : SubColour S c c') (j : Fin k) {x y : Fin G.n}
    (hxy : (x = S.p j ∧ y = S.q j) ∨ (x = S.q j ∧ y = S.p j)) {f g : Fin G.m}
    (hf : G.Inc f x) (hg : G.Inc g y) (hf6 : f ≠ S.e6 j) (hfy : f ≠ S.ey j)
    (hg6 : g ≠ S.e6 j) (hgy : g ≠ S.ey j) : c' f ≠ c' g := by
  have hpn := port_ne (pi_rigidity (S.copy j) c hc)
  rw [S.cAu, S.cBv] at hpn
  rcases hxy with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · have hf' : f = S.pp j := by
      rcases S.incp j f hf with h | h | h
      · exact absurd h hf6
      · exact absurd h hfy
      · exact h
    have hg' : g = S.pq j := by
      rcases S.incq j g hg with h | h | h
      · exact absurd h hg6
      · exact absurd h hgy
      · exact h
    rw [hf', hg', hC.hold _ (pp_old S j), hC.hold _ (pq_old S j)]
    intro h
    exact hpn (castSucc_inj' h)
  · have hf' : f = S.pq j := by
      rcases S.incq j f hf with h | h | h
      · exact absurd h hf6
      · exact absurd h hfy
      · exact h
    have hg' : g = S.pp j := by
      rcases S.incp j g hg with h | h | h
      · exact absurd h hg6
      · exact absurd h hgy
      · exact h
    rw [hf', hg', hC.hold _ (pq_old S j), hC.hold _ (pp_old S j)]
    intro h
    exact hpn (castSucc_inj' h).symm

/-- orientation of an edge joining the two vertices of digon `j` -/
theorem digon_orient {f : Fin G.m} {x y : Fin G.n} (j : Fin k) (hf : G.Joins f x y)
    (hd : G.Joins f (S.p j) (S.q j)) : (x = S.p j ∧ y = S.q j) ∨ (x = S.q j ∧ y = S.p j) := by
  rcases joins_unique hf hd with ⟨a, b⟩ | ⟨a, b⟩
  · exact Or.inl ⟨a, b⟩
  · exact Or.inr ⟨a, b⟩

/-- Step 1 core: in a bicoloured walk, the third edge is not a six-edge -/
theorem no_six_third (hc : H.Star 5 c) (hC : SubColour S c c') {a1 a2 a3 a4 : Fin G.n} {f2 f3 f4 : Fin G.m}
    (h2 : G.Joins f2 a1 a2) (h3 : G.Joins f3 a2 a3) (h4 : G.Joins f4 a3 a4)
    (d13 : a1 ≠ a3) (d24 : a2 ≠ a4) (n23 : f2 ≠ f3) (n34 : f3 ≠ f4)
    (hb : c' f2 = c' f4) (j : Fin k) (h6 : f3 = S.e6 j) : False := by
  rw [h6] at h3 n23 n34
  have hor := digon_orient j h3 (S.j6 j)
  have hpq := S.hpq j
  have hf2y : f2 ≠ S.ey j := by
    intro e
    rw [e] at h2
    have h2o := digon_orient j h2 (S.jy j)
    rcases hor with ⟨e2, e3⟩ | ⟨e2, e3⟩ <;> rcases h2o with ⟨e1, e2'⟩ | ⟨e1, e2'⟩
    · exact hpq (e2.symm.trans e2')
    · exact d13 (e1.trans e3.symm)
    · exact d13 (e1.trans e3.symm)
    · exact hpq (e2'.symm.trans e2)
  have hf4y : f4 ≠ S.ey j := by
    intro e
    rw [e] at h4
    have h4o := digon_orient j h4 (S.jy j)
    rcases hor with ⟨e2, e3⟩ | ⟨e2, e3⟩ <;> rcases h4o with ⟨e3', e4⟩ | ⟨e3', e4⟩
    · exact hpq (e3'.symm.trans e3)
    · exact d24 (e2.trans e4.symm)
    · exact d24 (e2.trans e4.symm)
    · exact hpq (e3.symm.trans e3')
  exact port_colour_ne hc hC j hor (joins_inc_right h2) (joins_inc_left h4) n23 hf2y (Ne.symm n34) hf4y hb

/-- Step 2 core: in a bicoloured walk without six-edges, the second edge is not a twin edge -/
theorem no_twin_second (hc : H.Star 5 c) (hC : SubColour S c c') {a0 a1 a2 a3 : Fin G.n} {f1 f2 f3 : Fin G.m}
    (h1 : G.Joins f1 a0 a1) (h2 : G.Joins f2 a1 a2) (h3 : G.Joins f3 a2 a3)
    (n12 : f1 ≠ f2) (n23 : f2 ≠ f3) (ns1 : ∀ i, f1 ≠ S.e6 i) (ns3 : ∀ i, f3 ≠ S.e6 i)
    (hb : c' f1 = c' f3) (i : Fin k) (hy : f2 = S.ey i) : False := by
  rw [hy] at h2 n12 n23
  have hor := digon_orient i h2 (S.jy i)
  exact port_colour_ne hc hC i hor (joins_inc_right h1) (joins_inc_left h3) (ns1 i) n12 (ns3 i) (Ne.symm n23) hb

/-- Step 3 core: an end edge of the walk lifts to an edge of `H` at `φ y` with the same colour, whose other end is
    `φ x` or a vertex outside the image of `φ` -/
theorem lift_end (hc : H.Star 5 c) (hC : SubColour S c c') {f : Fin G.m} {x y : Fin G.n} (hf : G.Joins f x y)
    (hns : ∀ i, f ≠ S.e6 i) :
    ∃ τ z, H.Joins τ z (S.φ y) ∧ Fin.castSucc (c τ) = c' f ∧ (z = S.φ x ∨ ∀ t, z ≠ S.φ t) := by
  rcases Classical.em (∃ i, f = S.ey i) with ⟨i, hi⟩ | hy
  · rw [hi] at hf
    rcases digon_orient i hf (S.jy i) with ⟨_, ey⟩ | ⟨_, ey⟩
    · obtain ⟨τ, σ, hτ, hcτ, hσ⟩ := twinB hc (S.copy i)
      rw [S.cB i, ← ey] at hτ
      refine ⟨τ, σ, joins_symm hτ, by rw [hcτ, hi, hC.hy i], Or.inr ?_⟩
      intro t
      rcases hσ with h | h <;> rw [h]
      · exact S.newC i t
      · exact S.newZ i t
    · obtain ⟨τ, σ, hτ, hcτ, hσ⟩ := twinA (S.copy i) c
      rw [S.cA i, ← ey] at hτ
      refine ⟨τ, σ, joins_symm hτ, by rw [hcτ, hi, hC.hy i], Or.inr ?_⟩
      intro t
      rcases hσ with h | h <;> rw [h]
      · exact S.newC i t
      · exact S.newY i t
  · have hold : S.IsOld f := fun i => ⟨hns i, fun e => hy ⟨i, e⟩⟩
    exact ⟨S.old f, S.φ x, S.oldJ f x y hold hf, (hC.hold f hold).symm, Or.inl rfl⟩

theorem lift_ne {z : Fin H.n} {x y : Fin G.n} (hz : z = S.φ x ∨ ∀ t, z ≠ S.φ t) (hxy : x ≠ y) : z ≠ S.φ y := by
  rcases hz with h | h
  · rw [h]
    exact fun e => hxy (S.φinj _ _ e)
  · exact h y

theorem phi_ne {x y : Fin G.n} (h : x ≠ y) : S.φ x ≠ S.φ y := fun e => h (S.φinj _ _ e)

/-- a twin edge and a different non-six edge at a common vertex have different colours -/
theorem twin_proper (hc : H.Star 5 c) (hC : SubColour S c c') (i : Fin k) {b : Fin G.m} {x : Fin G.n}
    (hax : G.Inc (S.ey i) x) (hbx : G.Inc b x) (hne : S.ey i ≠ b) (hb6 : ∀ j, b ≠ S.e6 j) :
    c' (S.ey i) ≠ c' b := by
  rcases inc_of_joins (S.jy i) hax with rfl | rfl
  · have hb : b = S.pp i := by
      rcases S.incp i b hbx with h | h | h
      · exact absurd h (hb6 i)
      · exact absurd h.symm hne
      · exact h
    rw [hb, hC.hy i, hC.hold _ (pp_old S i)]
    intro e
    have e' := castSucc_inj' e
    rw [← S.cAu i] at e'
    exact portA_ne_twin hc (S.copy i) e'.symm
  · have hb : b = S.pq i := by
      rcases S.incq i b hbx with h | h | h
      · exact absurd h (hb6 i)
      · exact absurd h.symm hne
      · exact h
    rw [hb, hC.hy i, hC.hold _ (pq_old S i)]
    intro e
    have e' := castSucc_inj' e
    rw [← S.cBv i] at e'
    exact portB_ne_twin hc (S.copy i) e'.symm

/-- two six-edges at a common vertex are equal -/
theorem six_six (i j : Fin k) {x : Fin G.n} (hx : G.Inc (S.e6 i) x) (hy : G.Inc (S.e6 j) x) : i = j := by
  apply Classical.byContradiction
  intro hij
  have hd := S.disj i j hij
  rcases inc_of_joins (S.j6 i) hx with rfl | rfl <;> rcases inc_of_joins (S.j6 j) hy with h | h
  · exact hd.1 h
  · exact hd.2.1 h
  · exact hd.2.2.1 h
  · exact hd.2.2.2 h

/-- **Replacement lemma (A) of fact 85bb5f970f208c0b.** -/
theorem pi_subst (S : PiSubst G H k) (c : Fin H.m → Fin 5) (hc : H.Star 5 c) (c' : Fin G.m → Fin 6)
    (hC : SubColour S c c') : G.Star 6 c' := by
  have hs := (star_iff 5 c).1 hc
  refine (star_iff 6 c').2 ⟨?_, ?_⟩
  · -- properness
    intro a b hab heq
    obtain ⟨hne, x, hax, hbx⟩ := hab
    rcases Classical.em (∃ i, a = S.e6 i) with ⟨i, hi⟩ | ha6
    · have hb6 : c' b = Fin.last 5 := by rw [← heq, hi, hC.h6]
      obtain ⟨j, hj⟩ := six_of_last hC hb6
      rw [hi] at hax
      rw [hj] at hbx
      have hij := six_six i j hax hbx
      exact hne (by rw [hi, hj, hij])
    · rcases Classical.em (∃ j, b = S.e6 j) with ⟨j, hj⟩ | hb6
      · have ha : c' a = Fin.last 5 := by rw [heq, hj, hC.h6]
        exact ha6 (six_of_last hC ha)
      · have ha6' : ∀ i, a ≠ S.e6 i := fun i e => ha6 ⟨i, e⟩
        have hb6' : ∀ j, b ≠ S.e6 j := fun j e => hb6 ⟨j, e⟩
        rcases Classical.em (∃ i, a = S.ey i) with ⟨i, hi⟩ | hay
        · rw [hi] at hax hne heq
          exact twin_proper hc hC i hax hbx hne hb6' heq
        · rcases Classical.em (∃ j, b = S.ey j) with ⟨j, hj⟩ | hby
          · rw [hj] at hbx hne heq
            exact twin_proper hc hC j hbx hax (Ne.symm hne) ha6' heq.symm
          · have oa : S.IsOld a := fun i => ⟨ha6' i, fun e => hay ⟨i, e⟩⟩
            have ob : S.IsOld b := fun i => ⟨hb6' i, fun e => hby ⟨i, e⟩⟩
            rw [hC.hold a oa, hC.hold b ob] at heq
            obtain ⟨ya, hja⟩ := inc_joins hax
            obtain ⟨yb, hjb⟩ := inc_joins hbx
            have ja := S.oldJ a ya x oa hja
            have jb := S.oldJ b yb x ob hjb
            exact hs.1 (S.old a) (S.old b)
              ⟨fun e => hne (S.oldInj a b oa ob e), S.φ x, joins_inc_right ja, joins_inc_right jb⟩
              (castSucc_inj' heq)
  · -- bicoloured walks
    intro w hb
    obtain ⟨v0, v1, v2, v3, v4, e1, e2, e3, e4, h1, h2, h3, h4, d01, d02, d03, d12, d13, d14, d23, d24, d34⟩ := w
    have hb1 : c' e1 = c' e3 := hb.1
    have hb2 : c' e2 = c' e4 := hb.2
    have n12 : e1 ≠ e2 := Walk4.e1_ne_e2 ⟨v0, v1, v2, v3, v4, e1, e2, e3, e4, h1, h2, h3, h4, d01, d02, d03, d12, d13, d14, d23, d24, d34⟩
    have n23 : e2 ≠ e3 := Walk4.e2_ne_e3 ⟨v0, v1, v2, v3, v4, e1, e2, e3, e4, h1, h2, h3, h4, d01, d02, d03, d12, d13, d14, d23, d24, d34⟩
    have n34 : e3 ≠ e4 := Walk4.e3_ne_e4 ⟨v0, v1, v2, v3, v4, e1, e2, e3, e4, h1, h2, h3, h4, d01, d02, d03, d12, d13, d14, d23, d24, d34⟩
    -- Step 1: no six-edges
    have ns3 : ∀ j, e3 ≠ S.e6 j := fun j e =>
      no_six_third hc hC h2 h3 h4 d13 d24 n23 n34 hb2 j e
    have ns2 : ∀ j, e2 ≠ S.e6 j := fun j e =>
      no_six_third hc hC (joins_symm h3) (joins_symm h2) (joins_symm h1) (Ne.symm d13) (Ne.symm d02)
        (Ne.symm n23) (Ne.symm n12) hb1.symm j e
    have ns1 : ∀ j, e1 ≠ S.e6 j := fun j e => by
      have h3l : c' e3 = Fin.last 5 := by rw [← hb1, e, hC.h6]
      obtain ⟨j', hj'⟩ := six_of_last hC h3l
      exact ns3 j' hj'
    have ns4 : ∀ j, e4 ≠ S.e6 j := fun j e => by
      have h2l : c' e2 = Fin.last 5 := by rw [hb2, e, hC.h6]
      obtain ⟨j', hj'⟩ := six_of_last hC h2l
      exact ns2 j' hj'
    -- Step 2: no twin edge in the middle
    have nt2 : ∀ i, e2 ≠ S.ey i := fun i e =>
      no_twin_second hc hC h1 h2 h3 n12 n23 ns1 ns3 hb1 i e
    have nt3 : ∀ i, e3 ≠ S.ey i := fun i e =>
      no_twin_second hc hC (joins_symm h4) (joins_symm h3) (joins_symm h2) (Ne.symm n34) (Ne.symm n23)
        ns4 ns2 hb2.symm i e
    have o2 : S.IsOld e2 := fun i => ⟨ns2 i, nt2 i⟩
    have o3 : S.IsOld e3 := fun i => ⟨ns3 i, nt3 i⟩
    -- Step 3: lift to H
    obtain ⟨τ1, z0, hτ1, hc1, hz0⟩ := lift_end hc hC h1 ns1
    obtain ⟨τ4, z4, hτ4, hc4, hz4⟩ := lift_end hc hC (joins_symm h4) ns4
    have j2 := S.oldJ e2 v1 v2 o2 h2
