    intro i
    obtain ⟨e, he, hei⟩ := hinc i
    obtain ⟨e', rfl⟩ := (hP e).1 he
    obtain ⟨a, -, ha⟩ := iso_inc hj hei
    exact ⟨a, ha⟩
  apply pigeon 6 (fun i => Fin.cast hn (Classical.choose (hpre i)))
  intro i j hij
  apply hv
  have h1 : Classical.choose (hpre i) = Classical.choose (hpre j) := by
    have h := congrArg Fin.val hij
    exact Fin.ext h
  rw [← Classical.choose_spec (hpre i), ← Classical.choose_spec (hpre j), h1]

