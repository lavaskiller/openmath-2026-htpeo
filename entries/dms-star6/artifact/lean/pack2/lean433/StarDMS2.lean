    · exact n23 (he2.trans he3.symm)
    · subst hv3
      exact n34 (leaf_two q3 q4 (joins_inc_right h3) (joins_inc_left h4))
  · subst hv1
    exact n12 (leaf_two q1 q2 (joins_inc_right h1) (joins_inc_left h2))

/-- **Claim W** of fact b22aa11289e61f4c: under the conditions `LeafConds`, `leafCol` is a star 6-colouring of `Q`. -/
theorem claimW (L : LeafSetup G Q) (c2 : Fin (addEdge G L.u L.w).m → Fin 6) (σ τ lam : Fin 6)
    (C : LeafConds L c2 σ τ lam) : StarOn Q 6 (leafCol L c2 σ τ lam) := by
  constructor
  · -- properness
    rintro a b ⟨hab, x, hax, hbx⟩ hQa hQb
    by_cases hay : G.Inc a L.y <;> by_cases hby : G.Inc b L.y
    · rcases L.hy a hQa hay with ha | ha | ha <;> rcases L.hy b hQb hby with hb | hb | hb <;>
        rw [ha, hb] <;> simp only [col1, col2, col3]
      · exact absurd (ha.trans hb.symm) hab
      · exact C.pST
      · exact C.pSL
      · exact Ne.symm C.pST
      · exact absurd (ha.trans hb.symm) hab
      · exact C.pTL
      · exact Ne.symm C.pSL
      · exact Ne.symm C.pTL
      · exact absurd (ha.trans hb.symm) hab
    · have ob : L.O b := ⟨hQb, hby⟩
      rw [colO ob]
      have hxy : x ≠ L.y := fun h => hby (h ▸ hbx)
      have hja : G.Joins a L.y x := joins_of_inc_ne hay hax (Ne.symm hxy)
      rcases atY hQa hja with ⟨he, hx⟩ | ⟨he, hx⟩ | ⟨he, hx⟩
      · rw [he, col1]
        exact Ne.symm (C.pS b ob (hx ▸ hbx))
      · rw [he, col2]
        exact Ne.symm (C.pT b ob (hx ▸ hbx))
      · exfalso
        have := L.hl b hQb (hx ▸ hbx)
        exact hby (this ▸ joins_inc_left L.hf3)
    · have oa : L.O a := ⟨hQa, hay⟩
      rw [colO oa]
      have hxy : x ≠ L.y := fun h => hay (h ▸ hax)
      have hjb : G.Joins b L.y x := joins_of_inc_ne hby hbx (Ne.symm hxy)
      rcases atY hQb hjb with ⟨he, hx⟩ | ⟨he, hx⟩ | ⟨he, hx⟩
      · rw [he, col1]
        exact C.pS a oa (hx ▸ hax)
      · rw [he, col2]
        exact C.pT a oa (hx ▸ hax)
      · exfalso
        have := L.hl a hQa (hx ▸ hax)
        exact hay (this ▸ joins_inc_left L.hf3)
    · have oa : L.O a := ⟨hQa, hay⟩
      have ob : L.O b := ⟨hQb, hby⟩
      rw [colO oa, colO ob]
      exact C.star.1 _ _ ⟨fun h => hab (Fin.castSucc_inj.1 h), x, addEdge_inc_old.2 hax, addEdge_inc_old.2 hbx⟩
        (inSupp oa) (inSupp ob)
  · -- walks
    intro wk q1 q2 q3 q4 hb
    obtain ⟨v0, v1, v2, v3, v4, e1, e2, e3, e4, h1, h2, h3, h4, d01, d02, d03, d12, d13, d14, d23, d24, d34⟩ := wk
    have hb1 : leafCol L c2 σ τ lam e1 = leafCol L c2 σ τ lam e3 := hb.1
    have hb2 : leafCol L c2 σ τ lam e2 = leafCol L c2 σ τ lam e4 := hb.2
    have n12 : e1 ≠ e2 := Walk4.e1_ne_e2 ⟨v0, v1, v2, v3, v4, e1, e2, e3, e4, h1, h2, h3, h4, d01, d02, d03, d12, d13, d14, d23, d24, d34⟩
    have n23 : e2 ≠ e3 := Walk4.e2_ne_e3 ⟨v0, v1, v2, v3, v4, e1, e2, e3, e4, h1, h2, h3, h4, d01, d02, d03, d12, d13, d14, d23, d24, d34⟩
    have n34 : e3 ≠ e4 := Walk4.e3_ne_e4 ⟨v0, v1, v2, v3, v4, e1, e2, e3, e4, h1, h2, h3, h4, d01, d02, d03, d12, d13, d14, d23, d24, d34⟩
    by_cases y0 : v0 = L.y
    · subst y0
      exact caseV0 C q1 q2 q3 q4 h1 h2 h3 h4 d01 d02 d03 d12 d13 d14 d23 d24 d34 n12 n34 hb1 hb2
    by_cases y1 : v1 = L.y
    · subst y1
      exact caseV1 C q1 q2 q3 q4 h1 h2 h3 h4 d01 d02 d03 d12 d13 d14 d23 d24 d34 n12 n23 hb1 hb2
    by_cases y2 : v2 = L.y
    · subst y2
      exact caseV2 C q1 q2 q3 q4 h1 h2 h3 h4 d01 d02 d03 d12 d13 d14 d23 d24 d34 n12 n23 n34 hb1 hb2
    by_cases y3 : v3 = L.y
    · -- reversed walk v4 v3 v2 v1 v0 has y in position 1
      subst y3
      exact caseV1 C q4 q3 q2 q1 (jsymm h4) (jsymm h3) (jsymm h2) (jsymm h1) (Ne.symm d34) (Ne.symm d24)
        (Ne.symm d14) (Ne.symm d23) (Ne.symm d13) (Ne.symm d03) (Ne.symm d12) (Ne.symm d02) (Ne.symm d01)
        (Ne.symm n34) (Ne.symm n23) hb2.symm hb1.symm
    by_cases y4 : v4 = L.y
    · -- reversed walk has y in position 0 (and v0 ≠ y)
      subst y4
      exact caseV0 C q4 q3 q2 q1 (jsymm h4) (jsymm h3) (jsymm h2) (jsymm h1) (Ne.symm d34) (Ne.symm d24)
        (Ne.symm d14) (Ne.symm d23) (Ne.symm d13) (Ne.symm d03) (Ne.symm d12) (Ne.symm d02) (Ne.symm d01)
        (Ne.symm n34) (Ne.symm n12) hb2.symm hb1.symm
    -- y is not on the walk: a K-walk
    have o1 : L.O e1 := oldOf q1 h1 y0 y1
    have o2 : L.O e2 := oldOf q2 h2 y1 y2
    have o3 : L.O e3 := oldOf q3 h3 y2 y3
    have o4 : L.O e4 := oldOf q4 h4 y3 y4
    rw [colO o1, colO o3] at hb1
    rw [colO o2, colO o4] at hb2
    exact kwalk C o1 o2 o3 o4 h1 h2 h3 h4 d01 d02 d03 d12 d13 d14 d23 d24 d34 hb1 hb2

end

