      · exact S.newZ i t
    · obtain ⟨τ, σ, hτ, hcτ, hσ⟩ := PiSubLean.twinA (S.copy i) c
      rw [S.cA i, ← ey] at hτ
      refine ⟨τ, σ, joins_symm hτ, by rw [hcτ, hi, hC.hy i], Or.inr ?_⟩
      intro t
      rcases hσ with h | h <;> rw [h]
      · exact S.newC i t
      · exact S.newY i t
  · have hold : S.IsOld f := fun i => ⟨hns i, fun e => hy ⟨i, e⟩⟩
    exact ⟨S.old f, S.φ x, S.oldJ f x y pf hold hf, (hC.hold f pf hold).symm, Or.inl rfl⟩

theorem lift_ne {z : Fin H.n} {x y : Fin G.n} (hz : z = S.φ x ∨ ∀ t, z ≠ S.φ t) (hxy : x ≠ y) : z ≠ S.φ y := by
  rcases hz with h | h
  · rw [h]
    exact fun e => hxy (S.φinj _ _ e)
  · exact h y

theorem phi_ne {x y : Fin G.n} (h : x ≠ y) : S.φ x ≠ S.φ y := fun e => h (S.φinj _ _ e)

/-- a twin edge and a different non-six edge at a common vertex have different colours -/
theorem twin_proper (hc : H.Star 5 c) (hC : SubColourOn S c c') (i : Fin k) {b : Fin G.m} {x : Fin G.n}
    (pb : P b) (hax : G.Inc (S.ey i) x) (hbx : G.Inc b x) (hne : S.ey i ≠ b) (hb6 : ∀ j, b ≠ S.e6 j) :
    c' (S.ey i) ≠ c' b := by
  rcases inc_of_joins (S.jy i) hax with rfl | rfl
  · have hb : b = S.pp i := by
      rcases S.incp i b pb hbx with h | h | h
      · exact absurd h (hb6 i)
      · exact absurd h.symm hne
      · exact h
    rw [hb, hC.hy i, hC.hold _ (S.Ppp i) (pp_old S i)]
    intro e
    have e' := castSucc_inj' e
    rw [← S.cAu i] at e'
    exact PiSubLean.portA_ne_twin hc (S.copy i) e'.symm
  · have hb : b = S.pq i := by
      rcases S.incq i b pb hbx with h | h | h
      · exact absurd h (hb6 i)
      · exact absurd h.symm hne
      · exact h
    rw [hb, hC.hy i, hC.hold _ (S.Ppq i) (pq_old S i)]
    intro e
    have e' := castSucc_inj' e
    rw [← S.cBv i] at e'
    exact PiSubLean.portB_ne_twin hc (S.copy i) e'.symm

/-- two six-edges at a common vertex are equal -/
theorem six_six (i j : Fin k) {x : Fin G.n} (hx : G.Inc (S.e6 i) x) (hy : G.Inc (S.e6 j) x) : i = j := by
  apply Classical.byContradiction
  intro hij
  have hd := S.disj i j hij
  rcases inc_of_joins (S.j6 i) hx with rfl | rfl <;> rcases inc_of_joins (S.j6 j) hy with h | h
  · exact hd.1 h
  · exact hd.2.1 h
  · exact hd.2.2.1 h
  · exact hd.2.2.2 h

