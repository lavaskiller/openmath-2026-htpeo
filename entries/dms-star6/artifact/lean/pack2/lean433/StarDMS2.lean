      · rw [h'', ψ'e1] at hb1; exact g1 hb1.symm
      · exact w.e2_ne_e3 (h'.trans h''.symm)
      · rw [h'', ψ'ne _ (fun h3 => nc1 (Or.inr h3)), ψold _ nc1] at hb1; exact g2 hb1.symm
