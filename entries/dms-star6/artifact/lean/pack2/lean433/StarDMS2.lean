/-- facts about the glued matching of two F-type covers -/
theorem Cut2.glueF_facts (C : Cut2 P) (hG : InG X P) {NA NB : Fin X.m → Prop} (hcovA : C.CoverA NA False)
    (hcovB : C.flip.CoverA NB False) :
