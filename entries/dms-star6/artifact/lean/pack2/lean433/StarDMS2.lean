section MainTheorems

/-- **DMS, the target statement** (not proved here): every loopless multigraph of maximum degree at most 3 is star
    6-edge-colourable; stated for every edge set `P` of `G` (`P = fun _ => True` is `G` itself). -/
example : RH2F.DMS = (∀ (G : MGraph), MGraph.Subcubic G → MGraph.Loopless G →
    ∀ P : Fin G.m → Prop, MGraph.Colourable P 6) := rfl

/-- **Theorem RH2 (conditional).** DMS follows from the five named statements
    `PStat` (every edge of a connected bridgeless cubic multigraph lies in a perfect matching and outside one),
    `SmallFacts` and `B8S` (finite statements about graphs with at most 8 vertices),
    `Hyp` (every 2-cut-reduced connected bridgeless cubic multigraph on at least 10 vertices is EX1-good) and
    `II` (the leaf graphs T(P, g) are star 6-edge-colourable). -/
theorem star6_rh2_conditional :
    RH2F.PStat → RH2F.SmallFacts → RH2F.B8S → RH2F.Hyp → RH2F.II → RH2F.DMS :=
  RH2F.layer4.2

/-- **Theorem EX1-RED (conditional).** Under `PStat`, `SmallFacts` and `Hyp`, every connected bridgeless loopless
    cubic multigraph on at least 10 vertices is EX1-good (the 2-cut-reducedness assumption of `Hyp` is removed). -/
theorem star6_ex1red_conditional :
    RH2F.PStat → RH2F.SmallFacts → RH2F.Hyp →
      ∀ (X : MGraph) (P : Fin X.m → Prop), RH2F.InG X P → 10 ≤ RH2F.vcount P → RH2F.EX1On P :=
  RH2F.layer4.1

end MainTheorems

