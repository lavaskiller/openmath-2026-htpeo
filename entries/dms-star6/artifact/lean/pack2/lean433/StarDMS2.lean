/-! ### transfer of a star colouring with a hole along an isomorphism -/

section transfer
variable {G H : MGraph}

/-- the colouring of `G` induced by `cH` along the edge map `ψ` (arbitrary off the image) -/
noncomputable def isoCol (ψ : Fin H.m → Fin G.m) (cH : Fin H.m → Fin 6) : Fin G.m → Fin 6 := by
  classical
  exact fun f => if h : ∃ e, ψ e = f then cH (Classical.choose h) else 0

theorem isoCol_psi {ψ : Fin H.m → Fin G.m} (hψ : ∀ e e', ψ e = ψ e' → e = e') (cH : Fin H.m → Fin 6)
    (e : Fin H.m) : isoCol ψ cH (ψ e) = cH e := by
  classical
  have hex : ∃ e', ψ e' = ψ e := ⟨e, rfl⟩
  unfold isoCol
  simp only [dif_pos hex]
  rw [hψ _ _ (Classical.choose_spec hex)]

/-- **Transfer with a hole.**  If `P ≅ H` and for every vertex `a` of `H` there is a star 6-colouring of `H` with hole
    colour `5` at `a`, then every vertex `t` of `P` has a star 6-colouring of `P` with a hole at `t`. -/
theorem hole_of_iso {P : Fin G.m → Prop} (hiso : IsoTo H P) (cH : Fin H.n → Fin H.m → Fin 6)
    (hstar : ∀ a, Star (G := H) 6 (cH a))
    (hhole : ∀ a e v, H.Inc e v → (v = a ∨ ∃ f, H.Joins f a v) → cH a e ≠ 5)
    (t : Fin G.n) (ht : ∃ f, P f ∧ G.Inc f t) :
    ∃ c : Fin G.m → Fin 6, ∃ β : Fin 6, StarOn P 6 c ∧ HoleOn P c t β := by
  obtain ⟨φ, ψ, hφ, hψ, hj, hP⟩ := hiso
  obtain ⟨f0, hf0, hf0t⟩ := ht
  obtain ⟨e0, rfl⟩ := (hP f0).1 hf0
  obtain ⟨a, -, rfl⟩ := iso_inc hj hf0t
  have hc : ∀ e, isoCol ψ (cH a) (ψ e) = cH a e := isoCol_psi hψ (cH a)
  refine ⟨isoCol ψ (cH a), 5, ⟨?_, ?_⟩, ?_⟩
  · intro x y hxy hx hy heq
    obtain ⟨ex, rfl⟩ := (hP x).1 hx
    obtain ⟨ey, rfl⟩ := (hP y).1 hy
    obtain ⟨hne, z, hxz, hyz⟩ := hxy
    obtain ⟨b, hb, hbz⟩ := iso_inc hj hxz
    obtain ⟨b', hb', hb'z⟩ := iso_inc hj hyz
    have hbb : b = b' := hφ _ _ (hbz.trans hb'z.symm)
    subst hbb
    have hadj : H.Adj ex ey := ⟨fun h => hne (by rw [h]), b, hb, hb'⟩
    rw [hc, hc] at heq
    exact (hstar a).1 ex ey hadj trivial trivial heq
  · intro w h1 h2 h3 h4 hb
    obtain ⟨ε1, hε1⟩ := (hP _).1 h1
    obtain ⟨ε2, hε2⟩ := (hP _).1 h2
    obtain ⟨ε3, hε3⟩ := (hP _).1 h3
    obtain ⟨ε4, hε4⟩ := (hP _).1 h4
    obtain ⟨u0, -, hu0⟩ := iso_inc hj (hε1 ▸ w.inc_e1_v0)
    obtain ⟨u1, -, hu1⟩ := iso_inc hj (hε1 ▸ w.inc_e1_v1)
    obtain ⟨u2, -, hu2⟩ := iso_inc hj (hε2 ▸ w.inc_e2_v2)
    obtain ⟨u3, -, hu3⟩ := iso_inc hj (hε3 ▸ w.inc_e3_v3)
    obtain ⟨u4, -, hu4⟩ := iso_inc hj (hε4 ▸ w.inc_e4_v4)
    have j1 : H.Joins ε1 u0 u1 := iso_joins hφ hj (by rw [hε1, hu0, hu1]; exact w.h1)
    have j2 : H.Joins ε2 u1 u2 := iso_joins hφ hj (by rw [hε2, hu1, hu2]; exact w.h2)
    have j3 : H.Joins ε3 u2 u3 := iso_joins hφ hj (by rw [hε3, hu2, hu3]; exact w.h3)
    have j4 : H.Joins ε4 u3 u4 := iso_joins hφ hj (by rw [hε4, hu3, hu4]; exact w.h4)
    let w' : H.Walk4 :=
      { v0 := u0, v1 := u1, v2 := u2, v3 := u3, v4 := u4, e1 := ε1, e2 := ε2, e3 := ε3, e4 := ε4,
        h1 := j1, h2 := j2, h3 := j3, h4 := j4,
        d01 := fun h => w.d01 (by rw [← hu0, ← hu1, h])
        d02 := fun h => w.d02 (by rw [← hu0, ← hu2, h])
        d03 := fun h => w.d03 (by rw [← hu0, ← hu3, h])
        d12 := fun h => w.d12 (by rw [← hu1, ← hu2, h])
        d13 := fun h => w.d13 (by rw [← hu1, ← hu3, h])
        d14 := fun h => w.d14 (by rw [← hu1, ← hu4, h])
        d23 := fun h => w.d23 (by rw [← hu2, ← hu3, h])
        d24 := fun h => w.d24 (by rw [← hu2, ← hu4, h])
        d34 := fun h => w.d34 (by rw [← hu3, ← hu4, h]) }
    apply (hstar a).2 w' trivial trivial trivial trivial
    obtain ⟨b13, b24⟩ := hb
    rw [← hε1, ← hε3, hc, hc] at b13
    rw [← hε2, ← hε4, hc, hc] at b24
    exact ⟨b13, b24⟩
  · intro e v he hev hnear
    obtain ⟨e', rfl⟩ := (hP e).1 he
    obtain ⟨b, hb, rfl⟩ := iso_inc hj hev
    rw [hc]
    apply hhole a e' b hb
    rcases hnear with h | ⟨f, hf, hfj⟩
    · exact Or.inl (hφ _ _ h)
    · obtain ⟨f', rfl⟩ := (hP f).1 hf
      exact Or.inr ⟨f', iso_joins hφ hj hfj⟩

end transfer

/-! ### from 5 colours to 6 colours -/

section five
variable {G : MGraph}

theorem castSucc_inj5 {a b : Fin 5} (h : Fin.castSucc a = (Fin.castSucc b : Fin 6)) : a = b := by
  have h' := congrArg Fin.val h
  exact Fin.ext h'

/-- a star 5-colouring is a star 6-colouring that avoids colour 6 -/
theorem five_six {P : Fin G.m → Prop} {c : Fin G.m → Fin 5} (hc : StarOn P 5 c) :
    StarOn P 6 (fun f => Fin.castSucc (c f)) :=
  ⟨fun a b hab ha hb heq => hc.1 a b hab ha hb (castSucc_inj5 heq),
   fun w h1 h2 h3 h4 hb => hc.2 w h1 h2 h3 h4 ⟨castSucc_inj5 hb.1, castSucc_inj5 hb.2⟩⟩

theorem five_hole {P : Fin G.m → Prop} (c : Fin G.m → Fin 5) (t : Fin G.n) :
    HoleOn P (fun f => Fin.castSucc (c f)) t 5 :=
  fun e _ _ _ _ h => absurd (congrArg Fin.val h) (Nat.ne_of_lt (c e).isLt)

end five

/-! ### DMS_I and DMS_II from CubicSharp5 -/

/-- CubicSharp5, as in the frozen statement of the contract -/
def CS5 : Prop :=
  ∀ (X : MGraph) (P : Fin X.m → Prop), MGraph.Loopless X → MGraph.ConnectedOn P → MGraph.BridgelessOn P →
    MGraph.CubicOn P → ¬ MGraph.IsoTo MGraph.k33 P → ¬ MGraph.IsoTo prismG P → ¬ MGraph.IsoTo m6G P →
    MGraph.Colourable P 5

theorem prism_colourable {X : MGraph} {P : Fin X.m → Prop} (h : IsoTo prismG P) : Colourable P 6 :=
  colourable_of_iso h (prismCol 0) (prism_star ⟨0, by decide⟩) (by decide)

theorem m6_colourable {X : MGraph} {P : Fin X.m → Prop} (h : IsoTo m6G P) : Colourable P 6 :=
  colourable_of_iso h (m6Col 0) (m6_star ⟨0, by decide⟩) (by decide)

theorem dmsI_of_cs5 (hCS : CS5) : DMS_I := by
  intro X P hL hC hB hK hk33
  by_cases hp : IsoTo prismG P
  · exact prism_colourable hp
  by_cases hm : IsoTo m6G P
  · exact m6_colourable hm
  obtain ⟨c, hc⟩ := hCS X P hL hC hB hK hk33 hp hm
  exact ⟨fun f => Fin.castSucc (c f), five_six hc⟩

/-- a vertex of an edge set `P` has a star 6-colouring of `P` with a hole, if `P` is one of the exceptions or
    CubicSharp5 applies -/
theorem hole_of_cs5 (hCS : CS5) {X : MGraph} {P : Fin X.m → Prop} (hL : Loopless X) (hC : ConnectedOn P)
    (hB : BridgelessOn P) (hK : CubicOn P) (hk33 : ¬ IsoTo k33 P) (t : Fin X.n) (ht : ∃ f, P f ∧ X.Inc f t) :
    ∃ c : Fin X.m → Fin 6, ∃ β : Fin 6, StarOn P 6 c ∧ HoleOn P c t β := by
  by_cases hp : IsoTo prismG P
  · exact hole_of_iso hp (fun a => prismCol a.val) prism_star (fun a => prism_hole_raw a) t ht
  by_cases hm : IsoTo m6G P
  · exact hole_of_iso hm (fun a => m6Col a.val) m6_star (fun a => m6_hole_raw a) t ht
  obtain ⟨c, hc⟩ := hCS X P hL hC hB hK hk33 hp hm
  exact ⟨fun f => Fin.castSucc (c f), 5, five_six hc, five_hole c t⟩

theorem dmsII_of_cs5 (hCS : CS5) : DMS_II := by
  intro G Q S hsub hloop huw hC hB hK hk33
  have hL := addEdge_loopless hloop huw
  obtain ⟨c2, β, hc2, hhole⟩ := hole_of_cs5 hCS hL hC hB hK hk33 S.w
    ⟨Fin.last G.m, S.supp_new, addEdge_inc_new.2 (Or.inr rfl)⟩
  exact hole_extend hsub hloop S.hf1 S.hf2 huw S.hQ1 S.hQ2 S.hy S.hl S.hlu S.hlw c2 β hc2 hhole

/-- part (b) of fact 336b55e302a0259e in Lean: CubicSharp5 implies HOLE (library definition `MGraph.HOLE`) -/
theorem hole_of_cubicSharp5 (hCS : CS5) : MGraph.HOLE :=
  fun _ _ hL hC hB hK hk33 t ht => hole_of_cs5 hCS hL hC hB hK hk33 t ht

