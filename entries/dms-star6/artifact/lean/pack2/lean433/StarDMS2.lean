theorem kpi_main (hl : MGraph.Loopless X) (D : DigonList X P k) :
    MGraph.Loopless (kpi D) ∧ SimpleOn (R D) ∧ (CubicOn P → CubicOn (R D)) ∧
    (ConnectedOn P → ConnectedOn (R D)) ∧ (BridgelessOn P → BridgelessOn (R D)) ∧
    (∀ i, PiLocal ((kpi_subst hl D).copy i)) ∧
    (∀ c : Fin (kpi D).m → Fin 5, StarOn (R D) 5 c → Colourable P 6) :=
  ⟨kpi_loopless hl, kpi_simple, kpi_cubic, kpi_connected, kpi_bridgeless, kpi_local hl,
    fun _ hc => kpi_colour hl D hc⟩

