/-! ===================== module MhFact_f3a50a27efdf0d7f ===================== -/
section Module_MhFact_f3a50a27efdf0d7f
-- Lean proof of fact f3a50a27efdf0d7f (DigonsLean.exists_digonList); added by fact_submit, do not edit
/-
  Digons.lean — every cubic edge set without a triple edge has a `DigonList` containing all its digons
  (Lean 4.20 core, no Mathlib; also builds under Lean 4.33.1).

  For a loopless multigraph `X` and an edge set `P` that is cubic (`CubicOn P`) and has no three pairwise distinct
  edges joining the same two vertices (`NoTriple P`), and for any edge `g0` (the preferred edge), we build a
  `KPiLean.DigonList X P k` (fact 7bae7837ff8807e2) listing every digon of `P` exactly once, such that `g0` is never
  the second edge `ey i` of a digon, and `k > 0` as soon as `P` has two distinct parallel edges.
  Main theorem: `DigonsLean.exists_digonList`.
-/

namespace DigonsLean
open MGraph KPiLean

attribute [local instance] Classical.propDecidable

/-! ### small list lemmas (self-contained, so that they do not depend on the core `List` API version) -/

section lists
variable {α : Type}

theorem get_mem' : ∀ (l : List α) (i : Fin l.length), l.get i ∈ l
  | _ :: _, ⟨0, _⟩ => List.Mem.head _
  | _ :: l, ⟨i + 1, h⟩ => List.Mem.tail _ (get_mem' l ⟨i, Nat.lt_of_succ_lt_succ h⟩)

theorem mem_get' : ∀ (l : List α) (a : α), a ∈ l → ∃ i : Fin l.length, l.get i = a
  | _ :: _, _, List.Mem.head _ => ⟨⟨0, Nat.succ_pos _⟩, rfl⟩
  | _ :: l, a, List.Mem.tail _ h => by
      obtain ⟨⟨i, hi⟩, hia⟩ := mem_get' l a h
      exact ⟨⟨i + 1, Nat.succ_lt_succ hi⟩, hia⟩

theorem get_inj' : ∀ (l : List α), l.Pairwise (· ≠ ·) → ∀ i j : Fin l.length, l.get i = l.get j → i = j
  | [], _, i, _, _ => i.elim0
  | _ :: _, _, ⟨0, _⟩, ⟨0, _⟩, _ => rfl
  | _ :: l, hp, ⟨0, _⟩, ⟨j + 1, hj⟩, h => by
      cases hp with
      | cons h1 _ => exact absurd h (h1 _ (get_mem' l ⟨j, Nat.lt_of_succ_lt_succ hj⟩))
  | _ :: l, hp, ⟨i + 1, hi⟩, ⟨0, _⟩, h => by
      cases hp with
      | cons h1 _ => exact absurd h.symm (h1 _ (get_mem' l ⟨i, Nat.lt_of_succ_lt_succ hi⟩))
  | _ :: l, hp, ⟨i + 1, hi⟩, ⟨j + 1, hj⟩, h => by
      cases hp with
      | cons _ h2 =>
        have e := get_inj' l h2 ⟨i, Nat.lt_of_succ_lt_succ hi⟩ ⟨j, Nat.lt_of_succ_lt_succ hj⟩ h
        have e' := congrArg Fin.val e
        exact Fin.ext (by show i + 1 = j + 1; exact congrArg (· + 1) e')

end lists

/-! ### pigeonhole for three slots -/

section slots
variable {α : Type}

theorem three_in_two {a b x y z : α} (hx : x = a ∨ x = b) (hy : y = a ∨ y = b) (hz : z = a ∨ z = b)
    (hxy : x ≠ y) (hxz : x ≠ z) (hyz : y ≠ z) : False := by
  rcases hx with rfl | rfl <;> rcases hy with rfl | rfl <;> rcases hz with rfl | rfl <;>
    first | exact hxy rfl | exact hxz rfl | exact hyz rfl

theorem four_in_three {a b c x y z w : α} (hx : x = a ∨ x = b ∨ x = c) (hy : y = a ∨ y = b ∨ y = c)
    (hz : z = a ∨ z = b ∨ z = c) (hw : w = a ∨ w = b ∨ w = c)
    (hxy : x ≠ y) (hxz : x ≠ z) (hxw : x ≠ w) (hyz : y ≠ z) (hyw : y ≠ w) (hzw : z ≠ w) : False := by
  rcases hx with rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl <;> rcases hz with rfl | rfl | rfl <;>
    rcases hw with rfl | rfl | rfl <;>
    first | exact hxy rfl | exact hxz rfl | exact hxw rfl | exact hyz rfl | exact hyw rfl | exact hzw rfl

end slots

variable {X : MGraph} {P : Fin X.m → Prop}

/-! ### parallel edges -/

/-- `f` and `g` are distinct parallel `P`-edges -/
def Par (P : Fin X.m → Prop) (f g : Fin X.m) : Prop :=
  f ≠ g ∧ P f ∧ P g ∧ X.Joins g (X.ends f).1 (X.ends f).2

/-- no three pairwise distinct `P`-edges join the same two vertices -/
def NoTriple (P : Fin X.m → Prop) : Prop :=
  ∀ a b c x y, P a → P b → P c → a ≠ b → a ≠ c → b ≠ c → X.Joins a x y → X.Joins b x y → X.Joins c x y → False

theorem joins_of_joins_ends {f g : Fin X.m} {x y : Fin X.n} (hg : X.Joins g (X.ends f).1 (X.ends f).2)
    (hf : X.Joins f x y) : X.Joins g x y := by
  rcases joins_unique (joins_ends f) hf with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · rw [← h1, ← h2]; exact hg
  · rw [← h1, ← h2]; exact Or.symm hg

theorem par_joins {f g : Fin X.m} (h : Par P f g) {x y : Fin X.n} (hf : X.Joins f x y) : X.Joins g x y :=
  joins_of_joins_ends h.2.2.2 hf

theorem par_symm {f g : Fin X.m} (h : Par P f g) : Par P g f := by
  refine ⟨fun e => h.1 e.symm, h.2.2.1, h.2.1, ?_⟩
  rcases joins_unique (joins_ends g) h.2.2.2 with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · rw [h1, h2]; exact joins_ends f
  · rw [h1, h2]; exact Or.symm (joins_ends f)

theorem par_of_joins {f g : Fin X.m} {x y : Fin X.n} (hfg : f ≠ g) (hf : P f) (hg : P g) (jf : X.Joins f x y)
    (jg : X.Joins g x y) : Par P f g := by
  refine ⟨hfg, hf, hg, ?_⟩
  rcases joins_unique jf (joins_ends f) with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · rw [← h1, ← h2]; exact jg
  · rw [← h1, ← h2]; exact Or.symm jg

theorem partner_unique (hnt : NoTriple P) {f g g' : Fin X.m} (h : Par P f g) (h' : Par P f g') : g = g' := by
  apply Classical.byContradiction
  intro hne
  exact hnt f g g' _ _ h.2.1 h.2.2.1 h'.2.2.1 h.1 h'.1 hne (joins_ends f) h.2.2.2 h'.2.2.2

/-! ### representatives -/

/-- `f` represents its digon: its partner is not `g0`, and `f = g0` or `f` has the smaller index -/
def IsRep (P : Fin X.m → Prop) (g0 f : Fin X.m) : Prop :=
  (∃ g, Par P f g) ∧ ∀ g, Par P f g → g ≠ g0 ∧ (f = g0 ∨ f.val < g.val)

theorem rep_exists (hnt : NoTriple P) (g0 : Fin X.m) {a b : Fin X.m} (h : Par P a b) :
    IsRep P g0 a ∨ IsRep P g0 b := by
  have hb : ∀ g, Par P a g → g = b := fun g hg => (partner_unique hnt h hg).symm
  have ha : ∀ g, Par P b g → g = a := fun g hg => (partner_unique hnt (par_symm h) hg).symm
  by_cases ha0 : a = g0
  · left
    refine ⟨⟨b, h⟩, fun g hg => ?_⟩
    rw [hb g hg]
    exact ⟨fun e => h.1 (ha0.trans e.symm), Or.inl ha0⟩
  by_cases hb0 : b = g0
  · right
    refine ⟨⟨a, par_symm h⟩, fun g hg => ?_⟩
    rw [ha g hg]
    exact ⟨ha0, Or.inl hb0⟩
  have hv : a.val ≠ b.val := fun e => h.1 (Fin.ext e)
  by_cases hlt : a.val < b.val
  · left
    refine ⟨⟨b, h⟩, fun g hg => ?_⟩
    rw [hb g hg]
    exact ⟨hb0, Or.inr hlt⟩
  · right
    refine ⟨⟨a, par_symm h⟩, fun g hg => ?_⟩
    rw [ha g hg]
    exact ⟨ha0, Or.inr (by omega)⟩

theorem rep_unique {g0 a b : Fin X.m} (h : Par P a b) (ha : IsRep P g0 a) (hb : IsRep P g0 b) : False := by
  obtain ⟨hb0, hab⟩ := ha.2 b h
  obtain ⟨ha0, hba⟩ := hb.2 a (par_symm h)
  rcases hab with e | e
  · exact ha0 e
  rcases hba with e' | e'
  · exact hb0 e'
  omega

/-- the representatives with index below `n`, in decreasing order -/
noncomputable def reps (P : Fin X.m → Prop) (g0 : Fin X.m) : Nat → List (Fin X.m)
  | 0 => []
  | n + 1 => if h : n < X.m then (if IsRep P g0 ⟨n, h⟩ then ⟨n, h⟩ :: reps P g0 n else reps P g0 n)
      else reps P g0 n

theorem mem_reps (g0 : Fin X.m) : ∀ (n : Nat) (f : Fin X.m), f ∈ reps P g0 n ↔ f.val < n ∧ IsRep P g0 f
  | 0, f => ⟨fun h => (by cases h), fun h => absurd h.1 (Nat.not_lt_zero _)⟩
  | n + 1, f => by
      have ih := mem_reps g0 n f
      unfold reps
      by_cases h : n < X.m
      · rw [dif_pos h]
        by_cases hr : IsRep P g0 ⟨n, h⟩
        · rw [if_pos hr]
          constructor
          · intro hm
            cases hm with
            | head => exact ⟨Nat.lt_succ_self n, hr⟩
            | tail _ hm => exact ⟨Nat.lt_succ_of_lt (ih.1 hm).1, (ih.1 hm).2⟩
          · intro ⟨hlt, hf⟩
            by_cases hfn : f.val = n
            · have : f = ⟨n, h⟩ := Fin.ext hfn
              rw [this]; exact List.Mem.head _
            · exact List.Mem.tail _ (ih.2 ⟨by omega, hf⟩)
        · rw [if_neg hr]
          constructor
          · intro hm; exact ⟨Nat.lt_succ_of_lt (ih.1 hm).1, (ih.1 hm).2⟩
          · intro ⟨hlt, hf⟩
            by_cases hfn : f.val = n
            · have : f = ⟨n, h⟩ := Fin.ext hfn
              exact absurd (this ▸ hf) hr
            · exact ih.2 ⟨by omega, hf⟩
      · rw [dif_neg h]
        constructor
        · intro hm; exact ⟨Nat.lt_succ_of_lt (ih.1 hm).1, (ih.1 hm).2⟩
        · intro ⟨_, hf⟩; exact ih.2 ⟨by have := f.isLt; omega, hf⟩

theorem reps_pairwise (g0 : Fin X.m) : ∀ n, (reps P g0 n).Pairwise (· ≠ ·)
  | 0 => List.Pairwise.nil
  | n + 1 => by
      unfold reps
      by_cases h : n < X.m
      · rw [dif_pos h]
        by_cases hr : IsRep P g0 ⟨n, h⟩
        · rw [if_pos hr]
          refine List.Pairwise.cons (fun a ha e => ?_) (reps_pairwise g0 n)
          have := ((mem_reps g0 n a).1 ha).1
          rw [← e] at this
          exact Nat.lt_irrefl _ this
        · rw [if_neg hr]; exact reps_pairwise g0 n
      · rw [dif_neg h]; exact reps_pairwise g0 n

/-! ### the third edge at a digon vertex -/

theorem third_exists (hcub : CubicOn P) {x : Fin X.n} {a b : Fin X.m} (ha : P a) (hax : X.Inc a x) :
    ∃ c, P c ∧ X.Inc c x ∧ c ≠ a ∧ c ≠ b := by
  obtain ⟨a', b', c', pa, pb, pc, ia, ib, ic, hab', hac', hbc', hall⟩ := hcub x ⟨a, ha, hax⟩
  apply Classical.byContradiction
  intro hno
  have cov : ∀ d, P d → X.Inc d x → d = a ∨ d = b := by
    intro d hd hdx
    apply Classical.byContradiction
    intro hn
    exact hno ⟨d, hd, hdx, fun e => hn (Or.inl e), fun e => hn (Or.inr e)⟩
  exact three_in_two (cov a' pa ia) (cov b' pb ib) (cov c' pc ic) hab' hac' hbc'

theorem at_most_three (hcub : CubicOn P) {x : Fin X.n} {a b c d : Fin X.m} (ha : P a) (hb : P b) (hc : P c)
    (hd : P d) (hax : X.Inc a x) (hbx : X.Inc b x) (hcx : X.Inc c x) (hdx : X.Inc d x)
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) : False := by
  obtain ⟨a', b', c', -, -, -, -, -, -, -, -, -, hall⟩ := hcub x ⟨a, ha, hax⟩
  exact four_in_three (hall a ha hax) (hall b hb hbx) (hall c hc hcx) (hall d hd hdx) hab hac had hbc hbd hcd

theorem joins_of_inc_inc {f : Fin X.m} {x y : Fin X.n} (hx : X.Inc f x) (hy : X.Inc f y)
    (hxy : x ≠ y) : X.Joins f x y := by
  rcases hx with hx | hx <;> rcases hy with hy | hy
  · exact absurd (hx.symm.trans hy) hxy
  · exact Or.inl (Prod.ext hx hy)
  · exact Or.inr (Prod.ext hy hx)
  · exact absurd (hx.symm.trans hy) hxy

/-! ### the digon list -/

section build
variable (g0 : Fin X.m)

/-- the list of representatives -/
noncomputable abbrev R : List (Fin X.m) := reps P g0 X.m

theorem R_rep (i : Fin (R (P := P) g0).length) : IsRep P g0 ((R g0).get i) :=
  ((mem_reps g0 X.m _).1 (get_mem' _ i)).2

noncomputable def e6f (i : Fin (R (P := P) g0).length) : Fin X.m := (R g0).get i
noncomputable def eyf (i : Fin (R (P := P) g0).length) : Fin X.m := Classical.choose (R_rep g0 i).1

theorem par6y (i : Fin (R (P := P) g0).length) : Par P (e6f g0 i) (eyf g0 i) := Classical.choose_spec (R_rep g0 i).1

noncomputable def pf (i : Fin (R (P := P) g0).length) : Fin X.n := (X.ends (e6f g0 i)).1
noncomputable def qf (i : Fin (R (P := P) g0).length) : Fin X.n := (X.ends (e6f g0 i)).2

theorem j6f (i : Fin (R (P := P) g0).length) : X.Joins (e6f g0 i) (pf g0 i) (qf g0 i) := joins_ends _
theorem jyf (i : Fin (R (P := P) g0).length) : X.Joins (eyf g0 i) (pf g0 i) (qf g0 i) := (par6y g0 i).2.2.2

theorem ppex (hcub : CubicOn P) (i : Fin (R (P := P) g0).length) :
    ∃ c, P c ∧ X.Inc c (pf g0 i) ∧ c ≠ e6f g0 i ∧ c ≠ eyf g0 i :=
  third_exists hcub (par6y g0 i).2.1 (joins_inc_left (j6f g0 i))

theorem pqex (hcub : CubicOn P) (i : Fin (R (P := P) g0).length) :
    ∃ c, P c ∧ X.Inc c (qf g0 i) ∧ c ≠ e6f g0 i ∧ c ≠ eyf g0 i :=
  third_exists hcub (par6y g0 i).2.1 (joins_inc_right (j6f g0 i))

noncomputable def ppf (hcub : CubicOn P) (i : Fin (R (P := P) g0).length) : Fin X.m :=
  Classical.choose (ppex g0 hcub i)
noncomputable def pqf (hcub : CubicOn P) (i : Fin (R (P := P) g0).length) : Fin X.m :=
  Classical.choose (pqex g0 hcub i)

theorem ppf_spec (hcub : CubicOn P) (i : Fin (R (P := P) g0).length) :
    P (ppf g0 hcub i) ∧ X.Inc (ppf g0 hcub i) (pf g0 i) ∧ ppf g0 hcub i ≠ e6f g0 i ∧ ppf g0 hcub i ≠ eyf g0 i :=
  Classical.choose_spec (ppex g0 hcub i)

theorem pqf_spec (hcub : CubicOn P) (i : Fin (R (P := P) g0).length) :
    P (pqf g0 hcub i) ∧ X.Inc (pqf g0 hcub i) (qf g0 i) ∧ pqf g0 hcub i ≠ e6f g0 i ∧ pqf g0 hcub i ≠ eyf g0 i :=
  Classical.choose_spec (pqex g0 hcub i)

/-- all `P`-edges at a vertex of digon `i` -/
theorem inc_cover (hcub : CubicOn P) {i : Fin (R (P := P) g0).length} {x : Fin X.n} {t : Fin X.m} (ht : P t) (htx : X.Inc t x)
    (hx6 : X.Inc (e6f g0 i) x) (hne6 : t ≠ e6f g0 i) (hney : t ≠ eyf g0 i) :
    ∀ f, P f → X.Inc f x → f = e6f g0 i ∨ f = eyf g0 i ∨ f = t := by
  intro f hf hfx
  have hxy : X.Inc (eyf g0 i) x := by
    rcases inc_of_joins (j6f g0 i) hx6 with e | e
    · rw [e]; exact joins_inc_left (jyf g0 i)
    · rw [e]; exact joins_inc_right (jyf g0 i)
  apply Classical.byContradiction
  intro hn
  have h1 : f ≠ e6f g0 i := fun e => hn (Or.inl e)
  have h2 : f ≠ eyf g0 i := fun e => hn (Or.inr (Or.inl e))
  have h3 : f ≠ t := fun e => hn (Or.inr (Or.inr e))
  exact at_most_three hcub (par6y g0 i).2.1 (par6y g0 i).2.2.1 ht hf hx6 hxy htx hfx (par6y g0 i).1
    (fun e => hne6 e.symm) (fun e => h1 e.symm) (fun e => hney e.symm) (fun e => h2 e.symm) (fun e => h3 e.symm)

/-- a vertex meeting digons `i` and `j` forces `i = j` -/
theorem rep6 (i : Fin (R (P := P) g0).length) : IsRep P g0 (e6f g0 i) := R_rep g0 i

theorem digon_meet (hcub : CubicOn P) (hnt : NoTriple P) {i j : Fin (R (P := P) g0).length} {x : Fin X.n} (hi : X.Inc (e6f g0 i) x)
    (hj : X.Inc (e6f g0 j) x) : i = j := by
  have incy : ∀ l : Fin (R (P := P) g0).length, X.Inc (e6f g0 l) x → X.Inc (eyf g0 l) x := by
    intro l hlx
    rcases inc_of_joins (j6f g0 l) hlx with e | e
    · rw [e]; exact joins_inc_left (jyf g0 l)
    · rw [e]; exact joins_inc_right (jyf g0 l)
  have hij6 : e6f g0 i = e6f g0 j → i = j := get_inj' _ (reps_pairwise g0 X.m) i j
  have pi := par6y g0 i
  have pj := par6y g0 j
  by_cases a1 : e6f g0 i = e6f g0 j
  · exact hij6 a1
  by_cases a2 : e6f g0 i = eyf g0 j
  · -- the pair of `j` is `{e6 j, e6 i}`, both representatives
    have pj' : Par P (e6f g0 j) (e6f g0 i) := by rw [a2]; exact pj
    exact (rep_unique pj' (rep6 g0 j) (rep6 g0 i)).elim
  by_cases a3 : eyf g0 i = e6f g0 j
  · have pi' : Par P (e6f g0 i) (e6f g0 j) := by rw [← a3]; exact pi
    exact (rep_unique pi' (rep6 g0 i) (rep6 g0 j)).elim
  by_cases a4 : eyf g0 i = eyf g0 j
  · apply hij6
    have pj' : Par P (eyf g0 i) (e6f g0 j) := by rw [a4]; exact par_symm pj
    exact partner_unique hnt (par_symm pi) pj'
  exfalso
  exact at_most_three hcub pi.2.1 pi.2.2.1 pj.2.1 pj.2.2.1 hi (incy i hi) hj (incy j hj) pi.1 a1 a2 a3 a4 pj.1

theorem disj_f (hcub : CubicOn P) (hnt : NoTriple P) (i j : Fin (R (P := P) g0).length) (hij : i ≠ j) :
    pf g0 i ≠ pf g0 j ∧ pf g0 i ≠ qf g0 j ∧ qf g0 i ≠ pf g0 j ∧ qf g0 i ≠ qf g0 j := by
  have pi := joins_inc_left (j6f g0 i)
  have qi := joins_inc_right (j6f g0 i)
  have pj := joins_inc_left (j6f g0 j)
  have qj := joins_inc_right (j6f g0 j)
  refine ⟨fun e => hij ?_, fun e => hij ?_, fun e => hij ?_, fun e => hij ?_⟩
  · exact digon_meet g0 hcub hnt pi (e ▸ pj)
  · exact digon_meet g0 hcub hnt pi (e ▸ qj)
  · exact digon_meet g0 hcub hnt qi (e ▸ pj)
  · exact digon_meet g0 hcub hnt qi (e ▸ qj)

/-- an edge at a vertex of digon `i` that is a digon edge of `j` forces `i = j` -/
theorem old_meet (hcub : CubicOn P) (hnt : NoTriple P) {i j : Fin (R (P := P) g0).length} {x : Fin X.n} (hx : X.Inc (e6f g0 i) x) {f : Fin X.m}
    (hfx : X.Inc f x) (hf : f = e6f g0 j ∨ f = eyf g0 j) : i = j := by
  rcases hf with rfl | rfl
  · exact digon_meet g0 hcub hnt hx hfx
  · have : X.Inc (e6f g0 j) x := by
      rcases inc_of_joins (jyf g0 j) hfx with e | e
      · rw [e]; exact joins_inc_left (j6f g0 j)
      · rw [e]; exact joins_inc_right (j6f g0 j)
    exact digon_meet g0 hcub hnt hx this

/-- **The digon list of all digons of `P`.** -/
noncomputable def digonList (hl : MGraph.Loopless X) (hcub : CubicOn P) (hnt : NoTriple P) : DigonList X P (R (P := P) g0).length where
  p := pf g0
  q := qf g0
  e6 := e6f g0
  ey := eyf g0
  pp := ppf g0 hcub
  pq := pqf g0 hcub
  hpq := fun i => ne_of_joins hl (j6f g0 i)
  j6 := j6f g0
  jy := jyf g0
  P6 := fun i => (par6y g0 i).2.1
  Py := fun i => (par6y g0 i).2.2.1
  Ppp := fun i => (ppf_spec g0 hcub i).1
  Ppq := fun i => (pqf_spec g0 hcub i).1
  ipp := fun i => (ppf_spec g0 hcub i).2.1
  ipq := fun i => (pqf_spec g0 hcub i).2.1
  incp := fun i => inc_cover g0 hcub (ppf_spec g0 hcub i).1 (ppf_spec g0 hcub i).2.1 (joins_inc_left (j6f g0 i))
    (ppf_spec g0 hcub i).2.2.1 (ppf_spec g0 hcub i).2.2.2
  incq := fun i => inc_cover g0 hcub (pqf_spec g0 hcub i).1 (pqf_spec g0 hcub i).2.1 (joins_inc_right (j6f g0 i))
    (pqf_spec g0 hcub i).2.2.1 (pqf_spec g0 hcub i).2.2.2
  disj := disj_f g0 hcub hnt
  ppOld := fun i j => by
    have hx := joins_inc_left (j6f g0 i)
    have hpp := (ppf_spec g0 hcub i).2.1
    constructor
    · intro e
      have hij := old_meet g0 hcub hnt hx hpp (Or.inl e)
      subst hij
      exact (ppf_spec g0 hcub i).2.2.1 e
    · intro e
      have hij := old_meet g0 hcub hnt hx hpp (Or.inr e)
      subst hij
      exact (ppf_spec g0 hcub i).2.2.2 e
  pqOld := fun i j => by
    have hx := joins_inc_right (j6f g0 i)
    have hpq := (pqf_spec g0 hcub i).2.1
    constructor
    · intro e
      have hij := old_meet g0 hcub hnt hx hpq (Or.inl e)
      subst hij
      exact (pqf_spec g0 hcub i).2.2.1 e
    · intro e
      have hij := old_meet g0 hcub hnt hx hpq (Or.inr e)
      subst hij
      exact (pqf_spec g0 hcub i).2.2.2 e
  ppq := fun i e => by
    have hp := (ppf_spec g0 hcub i).2.1
    have hq := (pqf_spec g0 hcub i).2.1
    rw [← e] at hq
    have hj := joins_of_inc_inc hp hq (ne_of_joins hl (j6f g0 i))
    exact hnt _ _ _ _ _ (par6y g0 i).2.1 (par6y g0 i).2.2.1 (ppf_spec g0 hcub i).1 (par6y g0 i).1
      (fun e' => (ppf_spec g0 hcub i).2.2.1 e'.symm) (fun e' => (ppf_spec g0 hcub i).2.2.2 e'.symm)
      (j6f g0 i) (jyf g0 i) hj
  h6y := fun i => (par6y g0 i).1
  allDig := fun f g x y hf hg hfg jf jg => by
    have hp : Par P f g := par_of_joins hfg hf hg jf jg
    rcases rep_exists hnt g0 hp with hr | hr
    · obtain ⟨i, hi⟩ := mem_get' _ f ((mem_reps g0 X.m f).2 ⟨f.isLt, hr⟩)
      exact ⟨i, Or.inl hi.symm⟩
    · obtain ⟨i, hi⟩ := mem_get' _ g ((mem_reps g0 X.m g).2 ⟨g.isLt, hr⟩)
      refine ⟨i, Or.inr ?_⟩
      have h1 : Par P (e6f g0 i) f := by
        show Par P ((R g0).get i) f
        rw [hi]; exact par_symm hp
      exact partner_unique hnt h1 (par6y g0 i)

theorem digonList_ey (hl : MGraph.Loopless X) (hcub : CubicOn P) (hnt : NoTriple P) (i : Fin (R (P := P) g0).length) : (digonList g0 hl hcub hnt).ey i ≠ g0 :=
  ((R_rep g0 i).2 _ (par6y g0 i)).1

theorem digonList_pos (hnt : NoTriple P) {a b : Fin X.m} (h : Par P a b) : 0 < (R (P := P) g0).length := by
  rcases rep_exists hnt g0 h with hr | hr
  · obtain ⟨i, -⟩ := mem_get' _ a ((mem_reps g0 X.m a).2 ⟨a.isLt, hr⟩)
    exact Nat.lt_of_le_of_lt (Nat.zero_le _) i.isLt
  · obtain ⟨i, -⟩ := mem_get' _ b ((mem_reps g0 X.m b).2 ⟨b.isLt, hr⟩)
    exact Nat.lt_of_le_of_lt (Nat.zero_le _) i.isLt

end build

/-- **Existence of the digon list.**  For a loopless `X` and a cubic edge set `P` without triple edges, and any
    edge `g0`, there is a digon list of `P` (every pair of distinct parallel `P`-edges contains a listed digon edge)
    in which `g0` is never the second digon edge, and which is non-empty if `P` has two distinct parallel edges. -/
theorem exists_digonList (hl : MGraph.Loopless X) (hcub : CubicOn P) (hnt : NoTriple P) (g0 : Fin X.m) :
    ∃ k, ∃ D : DigonList X P k, (∀ i, D.ey i ≠ g0) ∧ ((∃ a b, Par P a b) → 0 < k) :=
  ⟨_, digonList g0 hl hcub hnt, digonList_ey g0 hl hcub hnt, fun ⟨_, _, h⟩ => digonList_pos g0 hnt h⟩

end DigonsLean
