/-- **P05-LEAN-CUBIC5.**  CubicSharp5 implies that every finite loopless multigraph with maximum degree at most 3 has
    a star edge colouring with 6 colours. -/
theorem cubicSharp5_dms :
    (∀ (X : MGraph) (P : Fin X.m → Prop), MGraph.Loopless X → MGraph.ConnectedOn P → MGraph.BridgelessOn P →
      MGraph.CubicOn P → ¬ MGraph.IsoTo MGraph.k33 P →
      ¬ MGraph.IsoTo (MGraph.ofList 6 [(0,2),(0,3),(1,3),(0,4),(1,4),(2,4),(1,5),(2,5),(3,5)] (by decide)) P →
      ¬ MGraph.IsoTo (MGraph.ofList 6 [(0,2),(0,3),(0,5),(1,3),(1,4),(1,5),(2,4),(2,4),(3,5)] (by decide)) P →
      MGraph.Colourable P 5) →
    ∀ (G : MGraph), MGraph.Subcubic G → MGraph.Loopless G → ∀ (P : Fin G.m → Prop), MGraph.Colourable P 6 := by
  intro hCS
  exact dms_of_I_II (dmsI_of_cs5 hCS) (dmsII_of_cs5 hCS)

