section Module_MhFact_63b9e393de697bd5
-- Lean proof of fact 63b9e393de697bd5 (P05Lean.cubicSharp5_dms); added by fact_submit, do not edit
/-
  P05.lean — contract P05-LEAN-CUBIC5: CubicSharp5 implies that every loopless subcubic multigraph is star
  6-edge-colourable (Lean 4.20 core, no Mathlib; the module also builds under Lean 4.33.1).

  Route: the reduction `DmsIILean.dms_of_I_II` (fact 974f7197c1be8069) needs
  * DMS_I  (every connected, bridgeless, cubic edge set not ≅ K₃,₃ is star 6-colourable) and
  * DMS_II (every suppression configuration `SuppData Q` whose suppressed edge set `supp Q y u w` is connected,
    bridgeless, cubic and not ≅ K₃,₃ is star 6-colourable).
  For DMS_I, CubicSharp5 gives a star 5-colouring unless P ≅ prism or P ≅ M₆; those two get explicit certificates.
  For DMS_II, `hole_extend` (fact 5c1eb3f583cf643f) needs a star 6-colouring of `supp` with a hole at `w`.
  A star 5-colouring (CubicSharp5) has the hole colour 6 everywhere. For supp ≅ prism or M₆ we transfer, along the
  isomorphism, an explicit star 6-colouring of the prism / M₆ with hole colour 6 at the vertex corresponding to `w`
  (12 certificates, checked by kernel `decide`).
  Main theorem: `P05Lean.cubicSharp5_dms` (the frozen Lean statement of the contract).  Also
  `P05Lean.hole_of_cubicSharp5 : CS5 → MGraph.HOLE`.
-/

namespace P05Lean
open MGraph DmsIILean

/-! ### the two exceptional graphs, exactly as in the contract -/

/-- the prism K₃□K₂ with the edge list of the contract -/
def prismG : MGraph := MGraph.ofList 6 [(0,2),(0,3),(1,3),(0,4),(1,4),(2,4),(1,5),(2,5),(3,5)] (by decide)

/-- M₆ with the edge list of the contract (two parallel edges 24) -/
def m6G : MGraph := MGraph.ofList 6 [(0,2),(0,3),(0,5),(1,3),(1,4),(1,5),(2,4),(2,4),(3,5)] (by decide)

/-! ### star 6-colourings with hole colour 6 (= `5 : Fin 6`) at a prescribed vertex -/

/-- `prismL t`: colours of the nine prism edges; colour 5 is on no edge meeting N[t] -/
def prismL : List (List Nat) :=
  [[0, 1, 0, 2, 3, 4, 5, 2, 3], [5, 0, 1, 1, 2, 3, 3, 0, 4], [0, 1, 5, 2, 0, 3, 1, 4, 3],
   [0, 1, 0, 2, 3, 5, 4, 2, 3], [0, 1, 2, 2, 3, 4, 4, 1, 5], [0, 1, 2, 5, 0, 3, 1, 4, 3]]

/-- `m6L t`: colours of the nine M₆ edges; colour 5 is on no edge meeting N[t] -/
def m6L : List (List Nat) :=
  [[0, 1, 2, 0, 5, 3, 2, 3, 4], [5, 0, 1, 1, 2, 3, 0, 1, 4], [0, 1, 2, 0, 2, 5, 3, 4, 3],
   [0, 1, 2, 0, 2, 3, 4, 5, 4], [0, 1, 2, 0, 3, 4, 2, 4, 5], [0, 1, 2, 0, 2, 3, 4, 5, 4]]

def prismCol (t : Nat) : Fin prismG.m → Fin 6 := colOf prismG (prismL.getD t [])
def m6Col (t : Nat) : Fin m6G.m → Fin 6 := colOf m6G (m6L.getD t [])

theorem prism_check0 : prismG.starCheck (fun _ => true) (prismCol 0) = true := by decide +kernel
theorem prism_check1 : prismG.starCheck (fun _ => true) (prismCol 1) = true := by decide +kernel
theorem prism_check2 : prismG.starCheck (fun _ => true) (prismCol 2) = true := by decide +kernel
