    have nt3 : ∀ i, e3 ≠ S.ey i := fun i e =>
      no_twin_second hc hC p4 p2 (joins_symm h4) (joins_symm h3) (joins_symm h2) (Ne.symm n34) (Ne.symm n23)
        ns4 ns2 hb2.symm i e
    have o2 : S.IsOld e2 := fun i => ⟨ns2 i, nt2 i⟩
    have o3 : S.IsOld e3 := fun i => ⟨ns3 i, nt3 i⟩
    -- Step 3: lift to H
    obtain ⟨τ1, z0, hτ1, hc1, hz0⟩ := lift_end hc hC p1 h1 ns1
    obtain ⟨τ4, z4, hτ4, hc4, hz4⟩ := lift_end hc hC p4 (joins_symm h4) ns4
