  constructor
  · rintro ⟨i, hi, hiv⟩
    refine ⟨?_, C.clo_side hi hiv⟩
    rcases hi with rfl | ⟨d, rfl, hd⟩
    · rcases (C.inc_new_iff).1 hiv with rfl | rfl
      · exact ⟨C.e1, C.P1, joins_inc_left C.j1⟩
      · exact ⟨C.e2, C.P2, joins_inc_left C.j2⟩
    · exact ⟨d, hd.1, addEdge_inc_old.1 hiv⟩
