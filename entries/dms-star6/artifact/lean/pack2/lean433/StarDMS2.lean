/-! ### three parallel edges -/

section theta
variable {X : MGraph} {P : Fin X.m → Prop}

theorem theta_col (hL : MGraph.Loopless X) (hC : ConnectedOn P) (hK : CubicOn P) (hnt : ¬ NoTriple P) :
    ∃ c : Fin X.m → Fin 6, StarOn P 6 c ∧ ∀ e, c e ≠ 5 := by
  obtain ⟨a, b, c, x, y, pa, pb, pc, hab, hac, hbc, ja, jb, jc⟩ : ∃ a b c x y, P a ∧ P b ∧ P c ∧ a ≠ b ∧ a ≠ c ∧
      b ≠ c ∧ X.Joins a x y ∧ X.Joins b x y ∧ X.Joins c x y := by
    apply Classical.byContradiction
    intro hno
    apply hnt
    intro a b c x y pa pb pc hab hac hbc ja jb jc
    exact hno ⟨a, b, c, x, y, pa, pb, pc, hab, hac, hbc, ja, jb, jc⟩
  -- the P-edges at `x` (or `y`) are a, b, c
  have cover : ∀ z, X.Inc a z → X.Inc b z → X.Inc c z → ∀ d, P d → X.Inc d z → d = a ∨ d = b ∨ d = c := by
    intro z az bz cz d hd dz
    apply Classical.byContradiction
    intro hn
    exact at_most_three hK pa pb pc hd az bz cz dz hab hac (fun e => hn (Or.inl e.symm)) hbc
      (fun e => hn (Or.inr (Or.inl e.symm))) (fun e => hn (Or.inr (Or.inr e.symm)))
  have atx := cover x (joins_inc_left ja) (joins_inc_left jb) (joins_inc_left jc)
  have aty := cover y (joins_inc_right ja) (joins_inc_right jb) (joins_inc_right jc)
  have jxy : ∀ d, d = a ∨ d = b ∨ d = c → X.Joins d x y := by
    intro d hd
    rcases hd with rfl | rfl | rfl
    · exact ja
    · exact jb
    · exact jc
  -- every P-edge is a, b or c (connectivity)
  have allP : ∀ d, P d → d = a ∨ d = b ∨ d = c := by
    let U : Fin X.n → Bool := fun v => if v = x ∨ v = y then true else false
    have hU : ∀ f, P f → U (X.ends f).1 = U (X.ends f).2 := by
      intro f hf
      have near : ∀ v, X.Inc f v → (v = x ∨ v = y) → X.Joins f x y := by
        intro v hv hvxy
        rcases hvxy with rfl | rfl
        · exact jxy f (atx f hf hv)
        · exact jxy f (aty f hf hv)
      by_cases h1 : (X.ends f).1 = x ∨ (X.ends f).1 = y
      · have hj := near _ (Or.inl rfl) h1
        have h2 : (X.ends f).2 = x ∨ (X.ends f).2 = y := by
          rcases inc_of_joins hj (Or.inr rfl) with e | e
          · exact Or.inl e
          · exact Or.inr e
        simp only [U, if_pos h1, if_pos h2]
      · by_cases h2 : (X.ends f).2 = x ∨ (X.ends f).2 = y
        · have hj := near _ (Or.inr rfl) h2
          exfalso
          rcases inc_of_joins hj (Or.inl rfl) with e | e
          · exact h1 (Or.inl e)
          · exact h1 (Or.inr e)
        · simp only [U, if_neg h1, if_neg h2]
    intro d hd
    have e := hC U hU d a hd pa
    have ha1 : (X.ends a).1 = x ∨ (X.ends a).1 = y := by
      rcases inc_of_joins ja (Or.inl rfl) with e | e
      · exact Or.inl e
      · exact Or.inr e
    have hUa : U (X.ends a).1 = true := by simp only [U, if_pos ha1]
    rw [hUa] at e
    have hd1 : (X.ends d).1 = x ∨ (X.ends d).1 = y := by
      apply Classical.byContradiction
      intro hn
      have : U (X.ends d).1 = false := by simp only [U, if_neg hn]
      rw [this] at e
      exact Bool.false_ne_true e
    rcases hd1 with h | h
    · exact atx d hd (Or.inl h)
    · exact aty d hd (Or.inl h)
  let col : Fin X.m → Fin 6 := fun e => if e = a then 0 else if e = b then 1 else if e = c then 2 else 3
  have ca : col a = 0 := by simp [col]
  have cb : col b = 1 := by simp [col, Ne.symm hab]
  have cc : col c = 2 := by simp [col, Ne.symm hac, Ne.symm hbc]
  have col_inj : ∀ d d', P d → P d' → col d = col d' → d = d' := by
    intro d d' hd hd' heq
    have e01 : (0 : Fin 6) ≠ 1 := by decide
    have e02 : (0 : Fin 6) ≠ 2 := by decide
    have e12 : (1 : Fin 6) ≠ 2 := by decide
    rcases allP d hd with h | h | h <;> rcases allP d' hd' with h' | h' | h' <;> rw [h, h'] at heq ⊢ <;>
      first | rfl | (rw [ca, cb] at heq; exact absurd heq e01) | (rw [cb, ca] at heq; exact absurd heq.symm e01) | (rw [ca, cc] at heq; exact absurd heq e02) | (rw [cc, ca] at heq; exact absurd heq.symm e02) | (rw [cb, cc] at heq; exact absurd heq e12) | (rw [cc, cb] at heq; exact absurd heq.symm e12)
  refine ⟨col, ⟨?_, ?_⟩, ?_⟩
  · intro d d' hdd hd hd' heq
    exact hdd.1 (col_inj d d' hd hd' heq)
  · intro w h1 h2 _ _ _
    have v0 := inc_of_joins (jxy _ (allP _ h1)) (joins_inc_left w.h1)
    have v1 := inc_of_joins (jxy _ (allP _ h1)) (joins_inc_right w.h1)
    have v2 := inc_of_joins (jxy _ (allP _ h2)) (joins_inc_right w.h2)
    exact three_in_two v0 v1 v2 w.d01 w.d02 w.d12
  · intro e
    simp only [col]
    split
    · exact by decide
    · split
      · exact by decide
      · split
        · exact by decide
        · exact by decide

end theta

