/-- **P06-LEAN-COVER.** -/
theorem cover_main :
    (∀ (G H : MGraph) (pv : Fin G.n → Fin H.n) (pe : Fin G.m → Fin H.m) (k : Nat) (c : Fin H.m → Fin k),
        (∀ f : Fin H.m, (H.ends f).1 ≠ (H.ends f).2) →
        (∀ (f : Fin G.m) (x y : Fin G.n), G.Joins f x y → H.Joins (pe f) (pv x) (pv y)) →
        (∀ (x : Fin G.n) (f f' : Fin G.m), G.Inc f x → G.Inc f' x → pe f = pe f' → f = f') →
