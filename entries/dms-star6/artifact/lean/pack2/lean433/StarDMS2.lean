    exact hc.1 (E.ψ a) (E.ψ b) ⟨fun h => hne (E.ψinj a b ha hb h), E.φ x, E.inc ha hax, E.inc hb hbx⟩
      (E.fwd a ha) (E.fwd b hb) heq
  · have ne : ∀ {a b : Fin X.n}, a ≠ b → E.φ a ≠ E.φ b := fun h e => h (E.φinj _ _ e)
    let w' : Y.Walk4 :=
      { v0 := E.φ w.v0, v1 := E.φ w.v1, v2 := E.φ w.v2, v3 := E.φ w.v3, v4 := E.φ w.v4,
        e1 := E.ψ w.e1, e2 := E.ψ w.e2, e3 := E.ψ w.e3, e4 := E.ψ w.e4,
        h1 := E.joins h1 w.h1, h2 := E.joins h2 w.h2, h3 := E.joins h3 w.h3, h4 := E.joins h4 w.h4,
        d01 := ne w.d01, d02 := ne w.d02, d03 := ne w.d03, d12 := ne w.d12, d13 := ne w.d13,
        d14 := ne w.d14, d23 := ne w.d23, d24 := ne w.d24, d34 := ne w.d34 }
    exact hc.2 w' (E.fwd _ h1) (E.fwd _ h2) (E.fwd _ h3) (E.fwd _ h4) hb

variable (hback : ∀ f, P' f → ∃ e, P e ∧ E.ψ e = f)
include hback

theorem EmbOn.cubic (hK : CubicOn P) : CubicOn P' := by
  intro v ⟨f, hf, hfv⟩
  obtain ⟨e, he, rfl⟩ := hback f hf
  obtain ⟨x, rfl, hex⟩ := E.inc_back he hfv
  obtain ⟨a, b, c, pa, pb, pc, ia, ib, ic, hab, hac, hbc, hall⟩ := hK x ⟨e, he, hex⟩
  refine ⟨E.ψ a, E.ψ b, E.ψ c, E.fwd a pa, E.fwd b pb, E.fwd c pc, E.inc pa ia, E.inc pb ib, E.inc pc ic,
    fun h => hab (E.ψinj _ _ pa pb h), fun h => hac (E.ψinj _ _ pa pc h), fun h => hbc (E.ψinj _ _ pb pc h), ?_⟩
  intro d hd hdv
  obtain ⟨d', hd', rfl⟩ := hback d hd
  rcases hall d' hd' ((E.inc_iff hd').1 hdv) with h | h | h <;> rw [h]
  · exact Or.inl rfl
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr rfl)

theorem EmbOn.connected (hC : ConnectedOn P) : ConnectedOn P' := by
  intro U hU f g hf hg
  have hU' : ∀ e, P e → U (E.φ (X.ends e).1) = U (E.φ (X.ends e).2) := by
    intro e he
    have := hU _ (E.fwd e he)
    rw [E.ends e he] at this
    exact this
  obtain ⟨f', hf', rfl⟩ := hback f hf
  obtain ⟨g', hg', rfl⟩ := hback g hg
  have := hC (fun x => U (E.φ x)) hU' f' g' hf' hg'
  rw [E.ends f' hf', E.ends g' hg']
  exact this

theorem EmbOn.bridgeless (hB : BridgelessOn P) : BridgelessOn P' := by
  intro e he B
  obtain ⟨e', he', rfl⟩ := hback e he
  apply hB e' he'
  refine ⟨fun x => B.U (E.φ x), ?_, ?_, ?_⟩
  · have := B.hu; rw [E.ends e' he'] at this; exact this
  · have := B.hv; rw [E.ends e' he'] at this; exact this
  · intro f hf hfe
    have := B.sep (E.ψ f) (E.fwd f hf) (fun h => hfe (E.ψinj _ _ hf he' h))
    rw [E.ends f hf] at this
    exact this

theorem EmbOn.notriple (hnt : NoTriple P) : NoTriple P' := by
  intro a b c x y pa pb pc hab hac hbc ja jb jc
  obtain ⟨a', pa', rfl⟩ := hback a pa
  obtain ⟨b', pb', rfl⟩ := hback b pb
  obtain ⟨c', pc', rfl⟩ := hback c pc
  obtain ⟨x', rfl, -⟩ := E.inc_back pa' (joins_inc_left ja)
  obtain ⟨y', rfl, -⟩ := E.inc_back pa' (joins_inc_right ja)
  have back : ∀ {d : Fin X.m}, P d → Y.Joins (E.ψ d) (E.φ x') (E.φ y') → X.Joins d x' y' := by
    intro d hd hj
    unfold Joins at hj ⊢
    rw [E.ends d hd] at hj
    rcases hj with h | h
    · exact Or.inl (Prod.ext (E.φinj _ _ (Prod.mk.inj h).1) (E.φinj _ _ (Prod.mk.inj h).2))
    · exact Or.inr (Prod.ext (E.φinj _ _ (Prod.mk.inj h).1) (E.φinj _ _ (Prod.mk.inj h).2))
  exact hnt a' b' c' x' y' pa' pb' pc' (fun h => hab (h ▸ rfl)) (fun h => hac (h ▸ rfl)) (fun h => hbc (h ▸ rfl))
    (back pa' ja) (back pb' jb) (back pc' jc)

end emb

theorem EmbOn.par {X Y : MGraph} {P : Fin X.m → Prop} {P' : Fin Y.m → Prop} (E : EmbOn X Y P P') {a b : Fin X.m}
    (h : Par P a b) : Par P' (E.ψ a) (E.ψ b) := by
  refine ⟨fun e => h.1 (E.ψinj _ _ h.2.1 h.2.2.1 e), E.fwd a h.2.1, E.fwd b h.2.2.1, ?_⟩
  have := E.joins h.2.2.1 h.2.2.2
  rw [E.ends a h.2.1]
  exact this

/-! ### the pendant case with digons -/

section leafcase
variable {G : MGraph} {Q : Fin G.m → Prop}

theorem leaf_digon (hCS : CS5s) (L : LeafSetup G Q) (hsub : Subcubic G)
    (hC : ConnectedOn (supp Q L.y L.u L.w)) (hB : BridgelessOn (supp Q L.y L.u L.w))
    (hK : CubicOn (supp Q L.y L.u L.w)) (hnt : NoTriple (supp Q L.y L.u L.w))
    (hpar : ∃ a b, Par (supp Q L.y L.u L.w) a b) : Colourable Q 6 := by
  have hl : MGraph.Loopless (addEdge G L.u L.w) := addEdge_loopless L.hloop L.huw
  obtain ⟨k, D, hey, hk⟩ := exists_digonList hl hK hnt (Fin.last G.m)
  have i0 : Fin k := ⟨0, hk hpar⟩
  obtain ⟨hlk, hsk, hcub, hcon, hbr, hloc, -⟩ := kpi_main hl D
  obtain ⟨c, hc⟩ := hCS (kpi D) (R D) hlk (hcon hC) (hbr hB) (hcub hK) hsk
    (kpi_not_small hl D i0 rfl) (kpi_not_small hl D i0 rfl)
  obtain ⟨c', hC'⟩ := subColour_exists (kpi_subst hl D) D.h6y c
  let XL : LeafPi G (kpi D) Q k := ⟨L, kpi_subst hl D, c, kpi_star hc, c', hC'⟩
  have hparU : ∀ d, XL.L.O d → G.Joins d XL.L.u XL.L.w → ∃ i, XL.L.u = XL.S.p i ∨ XL.L.u = XL.S.q i := by
    intro d hd hj
    have h1 : supp Q L.y L.u L.w (Fin.castSucc d) := Or.inr ⟨d, rfl, hd⟩
    have h2 : supp Q L.y L.u L.w (Fin.last G.m) := Or.inl rfl
    have j1 : (addEdge G L.u L.w).Joins (Fin.castSucc d) L.u L.w := addEdge_joins_old.2 hj
    obtain ⟨i, hi⟩ := D.allDig _ _ _ _ h1 h2 (castSucc_ne_last' d) j1 addEdge_joins_new
    refine ⟨i, ?_⟩
    rcases hi with hi | hi
    · have j1' : (addEdge G L.u L.w).Joins (D.e6 i) L.u L.w := by rw [← hi]; exact j1
      rcases joins_unique (D.j6 i) j1' with ⟨e1, _⟩ | ⟨_, e2⟩
      · exact Or.inl e1.symm
      · exact Or.inr e2.symm
    · have j1' : (addEdge G L.u L.w).Joins (D.ey i) L.u L.w := by rw [← hi]; exact j1
      rcases joins_unique (D.jy i) j1' with ⟨e1, _⟩ | ⟨_, e2⟩
      · exact Or.inl e1.symm
      · exact Or.inr e2.symm
  obtain ⟨c0, hc0⟩ := leaf_all XL hsub hloc (kpi_loopless' hl) (fun i e => hey i e.symm) hparU
  exact ⟨c0, hc0⟩

/-- the pendant configuration of a `SuppData` with a pendant edge `f3 = y l` -/
def leafOf (S : SuppData Q) (hloop : MGraph.Loopless G) (huw : S.u ≠ S.w) (f3 : Fin G.m) (hf3 : Q f3)
    (j3 : G.Joins f3 S.y S.l) : LeafSetup G Q where
  y := S.y
  u := S.u
  w := S.w
  l := S.l
  f1 := S.f1
  f2 := S.f2
  f3 := f3
  hloop := hloop
  hf1 := S.hf1
  hf2 := S.hf2
  hf3 := j3
  hQ1 := S.hQ1
  hQ2 := S.hQ2
  hQ3 := hf3
  huw := huw
  hlu := S.hlu
  hlw := S.hlw
  hy := fun d hd hdy => by
    rcases S.hy d hd hdy with h | h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr (S.hl f3 d hf3 j3 hd (joins_inc_right h)))
  hl := fun d hd hdl => S.hl f3 d hf3 j3 hd hdl

end leafcase

/-! ### the auxiliary multigraph `leafG G Q y` -/

section leafG
variable (G : MGraph) (Q : Fin G.m → Prop) (y : Fin G.n)

def NL : Nat := G.n + 1 + 2 * G.m

def lo (x : Fin G.n) : Fin (NL G) := ⟨x.val, by unfold NL; have := x.isLt; omega⟩
def lf : Fin (NL G) := ⟨G.n, by unfold NL; omega⟩
def ls (f : Fin G.m) (s : Nat) (hs : s < 2) : Fin (NL G) :=
  ⟨G.n + 1 + 2 * f.val + s, by unfold NL; have := f.isLt; omega⟩

/-- the Q-edges of `G` with their ends, every other edge of `G` isolated between two spare vertices, and a new
    pendant edge (index `G.m`) from `y` to the new vertex `lf` -/
@[reducible] noncomputable def leafG : MGraph where
  n := NL G
  m := G.m + 1
  ends := fun e =>
    if h : e.val < G.m then
      (if Q ⟨e.val, h⟩ then (lo G (G.ends ⟨e.val, h⟩).1, lo G (G.ends ⟨e.val, h⟩).2)
       else (ls G ⟨e.val, h⟩ 0 (by decide), ls G ⟨e.val, h⟩ 1 (by decide)))
    else (lo G y, lf G)

/-- the edge set: the Q-edges and the pendant edge -/
def Ql : Fin (leafG G Q y).m → Prop := fun e => ∀ h : e.val < G.m, Q ⟨e.val, h⟩

end leafG

section leafGfacts
variable {G : MGraph} {Q : Fin G.m → Prop} {y : Fin G.n}

theorem lo_inj {a b : Fin G.n} (h : lo G a = lo G b) : a = b := (by have h' := congrArg Fin.val h; exact Fin.ext h')
theorem lo_ne_lf {a : Fin G.n} : lo G a ≠ lf G := by
  intro h; have := congrArg Fin.val h; simp only [lo, lf] at this; have := a.isLt; omega
theorem lo_ne_ls {a : Fin G.n} {f : Fin G.m} {s : Nat} {hs : s < 2} : lo G a ≠ ls G f s hs := by
  intro h; have := congrArg Fin.val h; simp only [lo, ls] at this; have := a.isLt; omega
theorem lf_ne_ls {f : Fin G.m} {s : Nat} {hs : s < 2} : lf G ≠ ls G f s hs := by
  intro h; have := congrArg Fin.val h; simp only [lf, ls] at this; omega
theorem ls_eq {f g : Fin G.m} {s t : Nat} {hs : s < 2} {ht : t < 2} (h : ls G f s hs = ls G g t ht) :
    f = g ∧ s = t := by
  have := congrArg Fin.val h; simp only [ls] at this
  exact ⟨Fin.ext (by omega), by omega⟩

theorem ends_q {d : Fin G.m} (hd : Q d) :
    (leafG G Q y).ends (Fin.castSucc d) = (lo G (G.ends d).1, lo G (G.ends d).2) := by
  simp only [leafG, Fin.castSucc, Fin.castAdd, Fin.castLE, dif_pos d.isLt, Fin.eta, if_pos hd]

theorem ends_nq {d : Fin G.m} (hd : ¬ Q d) :
    (leafG G Q y).ends (Fin.castSucc d) = (ls G d 0 (by decide), ls G d 1 (by decide)) := by
  simp only [leafG, Fin.castSucc, Fin.castAdd, Fin.castLE, dif_pos d.isLt, Fin.eta, if_neg hd]

theorem ends_last : (leafG G Q y).ends (Fin.last G.m) = (lo G y, lf G) := by
  simp only [leafG, Fin.last, Nat.lt_irrefl, dif_neg, not_false_eq_true]

theorem edge_cases' (e : Fin (leafG G Q y).m) : e = Fin.last G.m ∨ ∃ d : Fin G.m, e = Fin.castSucc d := by
  by_cases h : e.val < G.m
  · exact Or.inr ⟨⟨e.val, h⟩, Fin.ext rfl⟩
  · left; apply Fin.ext; show e.val = G.m; have : e.val < G.m + 1 := e.isLt; omega

theorem Ql_old {d : Fin G.m} : Ql G Q y (Fin.castSucc d) ↔ Q d := ⟨fun h => h d.isLt, fun h _ => h⟩
theorem Ql_last : Ql G Q y (Fin.last G.m) := fun h => absurd h (Nat.lt_irrefl _)

/-- incidences of `leafG` -/
theorem inc_q {d : Fin G.m} (hd : Q d) {x : Fin G.n} :
    (leafG G Q y).Inc (Fin.castSucc d) (lo G x) ↔ G.Inc d x := by
  unfold Inc; rw [ends_q hd]
  constructor
  · intro h; rcases h with h | h
    · exact Or.inl (lo_inj h)
    · exact Or.inr (lo_inj h)
  · intro h; rcases h with h | h <;> rw [h]
    · exact Or.inl rfl
    · exact Or.inr rfl

theorem inc_q_back {d : Fin G.m} (hd : Q d) {v : Fin (NL G)} (h : (leafG G Q y).Inc (Fin.castSucc d) v) :
    ∃ x, v = lo G x ∧ G.Inc d x := by
  unfold Inc at h; rw [ends_q hd] at h
  rcases h with h | h
  · exact ⟨_, h.symm, Or.inl rfl⟩
  · exact ⟨_, h.symm, Or.inr rfl⟩

theorem inc_nq {d : Fin G.m} (hd : ¬ Q d) {v : Fin (NL G)} (h : (leafG G Q y).Inc (Fin.castSucc d) v) :
    ∃ s hs, v = ls G d s hs := by
  unfold Inc at h; rw [ends_nq hd] at h
  rcases h with h | h
  · exact ⟨0, by decide, h.symm⟩
  · exact ⟨1, by decide, h.symm⟩

theorem inc_last {v : Fin (NL G)} (h : (leafG G Q y).Inc (Fin.last G.m) v) : v = lo G y ∨ v = lf G := by
  unfold Inc at h; rw [ends_last] at h
  rcases h with h | h
  · exact Or.inl h.symm
  · exact Or.inr h.symm

theorem leafG_loopless (hloop : MGraph.Loopless G) : MGraph.Loopless (leafG G Q y) := by
  intro e
  rcases edge_cases' e with rfl | ⟨d, rfl⟩
  · rw [ends_last]; exact lo_ne_lf
  · by_cases hd : Q d
    · rw [ends_q hd]; exact fun h => hloop d (lo_inj h)
    · rw [ends_nq hd]; exact fun h => absurd (ls_eq (hs := by decide) (ht := by decide) h).2 (by decide)

/-- `leafG` is subcubic when `y` has at most two Q-edges -/
theorem leafG_subcubic (hsub : Subcubic G) {f1 f2 : Fin G.m} (hy2 : ∀ d, Q d → G.Inc d y → d = f1 ∨ d = f2) :
    Subcubic (leafG G Q y) := by
  intro v a b c d ha hb hc hd hab hac had hbc hbd hcd
  -- classify the incident edges of `v`
  have cls : ∀ e, (leafG G Q y).Inc e v →
      (e = Fin.last G.m ∧ (v = lo G y ∨ v = lf G)) ∨
      (∃ d', e = Fin.castSucc d' ∧ Q d' ∧ ∃ x, v = lo G x ∧ G.Inc d' x) ∨
      (∃ d', e = Fin.castSucc d' ∧ ¬ Q d' ∧ ∃ s hs, v = ls G d' s hs) := by
    intro e he
    rcases edge_cases' e with rfl | ⟨d', rfl⟩
    · exact Or.inl ⟨rfl, inc_last he⟩
    · by_cases hq : Q d'
      · exact Or.inr (Or.inl ⟨d', rfl, hq, inc_q_back hq he⟩)
      · exact Or.inr (Or.inr ⟨d', rfl, hq, inc_nq hq he⟩)
  -- at a spare vertex or at `lf` there is only one edge
  have single : ∀ e e', (leafG G Q y).Inc e v → (leafG G Q y).Inc e' v →
      ((∃ d' s hs, v = ls G d' s hs) ∨ v = lf G) → e = e' := by
    intro e e' he he' hv
    have one : ∀ e, (leafG G Q y).Inc e v → ((∃ d' s hs, v = ls G d' s hs) ∨ v = lf G) →
        (∃ d', v = ls G d' 0 (by decide) ∨ v = ls G d' 1 (by decide)) ∧ False ∨
        (∀ d' s hs, v = ls G d' s hs → e = Fin.castSucc d') ∧ (v = lf G → e = Fin.last G.m) := by
      intro e he hv
      right
      rcases cls e he with ⟨h1, h2⟩ | ⟨d', rfl, _, x, rfl, _⟩ | ⟨d', rfl, _, s', hs', rfl⟩
      · refine ⟨fun d' s hs h => ?_, fun _ => h1⟩
        rcases h2 with h2 | h2
        · exact absurd (h2.symm.trans h) lo_ne_ls
        · exact absurd (h2.symm.trans h) lf_ne_ls
      · refine ⟨fun d'' s hs h => absurd h lo_ne_ls, fun h => absurd h lo_ne_lf⟩
      · refine ⟨fun d'' s hs h => ?_, fun h => absurd h.symm lf_ne_ls⟩
        rw [(ls_eq h).1]
    rcases one e he hv with ⟨_, h⟩ | ⟨h1, h2⟩
    · exact h.elim
    rcases one e' he' hv with ⟨_, h⟩ | ⟨h1', h2'⟩
    · exact h.elim
    rcases hv with ⟨d', s, hs, hv⟩ | hv
    · rw [h1 d' s hs hv, h1' d' s hs hv]
    · rw [h2 hv, h2' hv]
  by_cases hsp : (∃ d' s hs, v = ls G d' s hs) ∨ v = lf G
  · exact hab (single a b ha hb hsp)
  -- `v = lo x`
  obtain ⟨x, rfl⟩ : ∃ x, v = lo G x := by
    rcases cls a ha with ⟨_, h | h⟩ | ⟨_, _, _, x, h, _⟩ | ⟨d', _, _, s, hs, h⟩
    · exact ⟨y, h⟩
    · exact absurd (Or.inr h) hsp
    · exact ⟨x, h⟩
    · exact absurd (Or.inl ⟨d', s, hs, h⟩) hsp
  have old : ∀ e, (leafG G Q y).Inc e (lo G x) → e ≠ Fin.last G.m → ∃ d', e = Fin.castSucc d' ∧ Q d' ∧ G.Inc d' x := by
    intro e he hne
    rcases cls e he with ⟨h1, _⟩ | ⟨d', rfl, hq, x', hx', hi⟩ | ⟨d', _, _, s, hs, h⟩
    · exact absurd h1 hne
    · exact ⟨d', rfl, hq, (lo_inj hx') ▸ hi⟩
    · exact absurd h lo_ne_ls
  have cs_inj : ∀ d1 d2 : Fin G.m, (Fin.castSucc d1 : Fin (G.m + 1)) = Fin.castSucc d2 → d1 = d2 :=
    fun d1 d2 h => (by have h' := congrArg Fin.val h; exact Fin.ext h')
  by_cases hla : a = Fin.last G.m
  · -- b, c, d are old Q-edges at `x`, and `x = y`
    subst hla
    obtain ⟨b', rfl, qb, ib⟩ := old b hb (Ne.symm hab)
    obtain ⟨c', rfl, qc, ic⟩ := old c hc (Ne.symm hac)
    obtain ⟨d', rfl, qd, id⟩ := old d hd (Ne.symm had)
    have hxy : x = y := by
      rcases inc_last ha with h | h
      · exact lo_inj h
      · exact absurd h lo_ne_lf
    subst hxy
    exact three_in_two (hy2 b' qb ib) (hy2 c' qc ic) (hy2 d' qd id) (fun e => hbc (e ▸ rfl)) (fun e => hbd (e ▸ rfl))
      (fun e => hcd (e ▸ rfl))
  by_cases hlb : b = Fin.last G.m
  · subst hlb
    obtain ⟨a', rfl, qa, ia⟩ := old a ha hla
    obtain ⟨c', rfl, qc, ic⟩ := old c hc (Ne.symm hbc)
    obtain ⟨d', rfl, qd, id⟩ := old d hd (Ne.symm hbd)
    have hxy : x = y := by
      rcases inc_last hb with h | h
      · exact lo_inj h
      · exact absurd h lo_ne_lf
    subst hxy
    exact three_in_two (hy2 a' qa ia) (hy2 c' qc ic) (hy2 d' qd id) (fun e => hac (e ▸ rfl)) (fun e => had (e ▸ rfl))
      (fun e => hcd (e ▸ rfl))
  by_cases hlc : c = Fin.last G.m
  · subst hlc
    obtain ⟨a', rfl, qa, ia⟩ := old a ha hla
    obtain ⟨b', rfl, qb, ib⟩ := old b hb hlb
    obtain ⟨d', rfl, qd, id⟩ := old d hd (Ne.symm hcd)
    have hxy : x = y := by
      rcases inc_last hc with h | h
      · exact lo_inj h
      · exact absurd h lo_ne_lf
    subst hxy
    exact three_in_two (hy2 a' qa ia) (hy2 b' qb ib) (hy2 d' qd id) (fun e => hab (e ▸ rfl)) (fun e => had (e ▸ rfl))
      (fun e => hbd (e ▸ rfl))
  by_cases hld : d = Fin.last G.m
  · subst hld
    obtain ⟨a', rfl, qa, ia⟩ := old a ha hla
    obtain ⟨b', rfl, qb, ib⟩ := old b hb hlb
    obtain ⟨c', rfl, qc, ic⟩ := old c hc hlc
    have hxy : x = y := by
      rcases inc_last hd with h | h
      · exact lo_inj h
      · exact absurd h lo_ne_lf
    subst hxy
    exact three_in_two (hy2 a' qa ia) (hy2 b' qb ib) (hy2 c' qc ic) (fun e => hab (e ▸ rfl)) (fun e => hac (e ▸ rfl))
      (fun e => hbc (e ▸ rfl))
  obtain ⟨a', rfl, _, ia⟩ := old a ha hla
  obtain ⟨b', rfl, _, ib⟩ := old b hb hlb
  obtain ⟨c', rfl, _, ic⟩ := old c hc hlc
  obtain ⟨d', rfl, _, id⟩ := old d hd hld
