section lift
variable {G H : MGraph}

theorem joins_of_inc {K : MGraph} {f : Fin K.m} {x : Fin K.n} (h : K.Inc f x) : ∃ y, K.Joins f x y := by
  rcases h with h | h
  · exact ⟨(K.ends f).2, Or.inl (by rw [← h])⟩
  · exact ⟨(K.ends f).1, Or.inr (by rw [← h])⟩

theorem ne_of_joins' {K : MGraph} (hl : ∀ f : Fin K.m, (K.ends f).1 ≠ (K.ends f).2) {f : Fin K.m} {x y : Fin K.n}
    (h : K.Joins f x y) : x ≠ y := by
  intro hxy
  subst hxy
  rcases h with h | h <;> exact hl f (by rw [h])

/-- **(1) Pull-back.**  If `H` is loopless, `(pv, pe)` is a star-lifting map from `G` to `H` and `c` is a star
    `k`-colouring of `H`, then `c ∘ pe` is a star `k`-colouring of `G`. -/
theorem star_pullback (pv : Fin G.n → Fin H.n) (pe : Fin G.m → Fin H.m)
    (hl : ∀ f : Fin H.m, (H.ends f).1 ≠ (H.ends f).2)
    (ha : ∀ (f : Fin G.m) (x y : Fin G.n), G.Joins f x y → H.Joins (pe f) (pv x) (pv y))
    (hb : ∀ (x : Fin G.n) (f f' : Fin G.m), G.Inc f x → G.Inc f' x → pe f = pe f' → f = f')
    (hc : ∀ (x y y' : Fin G.n) (f f' : Fin G.m), G.Joins f x y → G.Joins f' x y' → pv y = pv y' → y = y')
    {k : Nat} {c : Fin H.m → Fin k} (hH : Star (G := H) k c) : Star (G := G) k (fun f => c (pe f)) := by
  have hinc : ∀ f x, G.Inc f x → H.Inc (pe f) (pv x) := by
    intro f x h
    obtain ⟨y, hy⟩ := joins_of_inc h
    exact joins_inc_left (ha f x y hy)
  refine ⟨?_, ?_⟩
  · intro a b hab _ _ heq
    obtain ⟨hne, x, hax, hbx⟩ := hab
    exact hH.1 (pe a) (pe b) ⟨fun h => hne (hb x a b hax hbx h), pv x, hinc a x hax, hinc b x hbx⟩ trivial trivial heq
  · intro w _ _ _ _ hbic
    have j1 := ha _ _ _ w.h1
    have j2 := ha _ _ _ w.h2
    have j3 := ha _ _ _ w.h3
    have j4 := ha _ _ _ w.h4
    have n01 : pv w.v0 ≠ pv w.v1 := ne_of_joins' hl j1
    have n12 : pv w.v1 ≠ pv w.v2 := ne_of_joins' hl j2
    have n23 : pv w.v2 ≠ pv w.v3 := ne_of_joins' hl j3
