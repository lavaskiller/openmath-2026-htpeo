/-- **Main theorem**: Π-rigidity and twin avoidance at both ports. -/
theorem pi_rigid_twin (P : PiCopy G) (L : PiLocal P) (hl : Loopless G) (c : Fin G.m → Fin 5) (hc : G.Star 5 c) :
    RigidConcl P c ∧
    (∀ f, G.Inc f P.u → f ≠ P.eAu → c f ≠ twin P c) ∧
    (∀ f, G.Inc f P.v → f ≠ P.eBv → c f ≠ twin P c) :=
  ⟨pi_rigidity P c hc, fun f hf hne => pi_twin_u P L hl c hc f hf hne,
    fun f hf hne => pi_twin_v P L hl c hc f hf hne⟩

