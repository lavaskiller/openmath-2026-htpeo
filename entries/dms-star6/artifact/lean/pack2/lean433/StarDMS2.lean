/-! ### pigeonhole -/

theorem pigeon : ∀ (n : Nat) (f : Fin (n + 1) → Fin n), (∀ i j, f i = f j → i = j) → False
  | 0, f, _ => (f 0).elim0
  | n + 1, f, hf => by
    have hne : ∀ i : Fin (n + 1), (f (Fin.castSucc i)).val ≠ (f (Fin.last (n + 1))).val := by
      intro i e
      have h := congrArg Fin.val (hf _ _ (Fin.ext e))
      have h1 : (Fin.castSucc i).val = i.val := rfl
      have h2 : (Fin.last (n + 1)).val = n + 1 := rfl
      rw [h1, h2] at h
      have := i.isLt
      omega
    let t := (f (Fin.last (n + 1))).val
    have ht : t < n + 1 := (f (Fin.last (n + 1))).isLt
    let g : Fin (n + 1) → Fin n := fun i =>
      if h : (f (Fin.castSucc i)).val < t then ⟨(f (Fin.castSucc i)).val, by omega⟩
      else ⟨(f (Fin.castSucc i)).val - 1, by have := (f (Fin.castSucc i)).isLt; have := hne i; omega⟩
    apply pigeon n g
    intro i j hij
    have hi := hne i
    have hj := hne j
    have e : (f (Fin.castSucc i)).val = (f (Fin.castSucc j)).val := by
      have hv := congrArg Fin.val hij
      simp only [g] at hv
      split at hv <;> split at hv <;> simp only at hv <;> omega
    have e2 := congrArg Fin.val (hf _ _ (Fin.ext e))
    have h1 : (Fin.castSucc i).val = i.val := rfl
    have h2 : (Fin.castSucc j).val = j.val := rfl
    rw [h1, h2] at e2
    exact Fin.ext e2

