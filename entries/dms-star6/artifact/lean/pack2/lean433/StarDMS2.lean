      exact C.MST v3 v4 e3 e4 o3 o4 h3 h4 d03 d23 d24 d34 ⟨hb1.symm, hb2.symm⟩
    · exact n12 (he1.trans he2.symm)
    · subst hv0
      rw [he1, col3] at hb1
      exact C.LT v3 v4 e3 e4 o3 o4 h3 h4 d23 d24 d34 ⟨hb1.symm, hb2.symm⟩
  · -- e2 = f3, v2 = l: e3 is a second edge at the leaf
    subst hv2
    exact n23 (leaf_two q2 q3 (joins_inc_right h2) (joins_inc_left h3))

/-- walks with `v2 = y` -/
theorem caseV2 (C : LeafConds L c2 σ τ lam) {v0 v1 v3 v4 : Fin G.n} {e1 e2 e3 e4 : Fin G.m}
    (q1 : Q e1) (q2 : Q e2) (q3 : Q e3) (q4 : Q e4)
    (h1 : G.Joins e1 v0 v1) (h2 : G.Joins e2 v1 L.y) (h3 : G.Joins e3 L.y v3) (h4 : G.Joins e4 v3 v4)
    (d01 : v0 ≠ v1) (d02 : v0 ≠ L.y) (d03 : v0 ≠ v3) (d12 : v1 ≠ L.y) (d13 : v1 ≠ v3) (d14 : v1 ≠ v4)
    (d23 : L.y ≠ v3) (d24 : L.y ≠ v4) (d34 : v3 ≠ v4)
    (n12 : e1 ≠ e2) (n23 : e2 ≠ e3) (n34 : e3 ≠ e4)
    (hb1 : leafCol L c2 σ τ lam e1 = leafCol L c2 σ τ lam e3)
    (hb2 : leafCol L c2 σ τ lam e2 = leafCol L c2 σ τ lam e4) : False := by
  have o1 : L.O e1 := oldOf q1 h1 d02 d12
  have o4 : L.O e4 := oldOf q4 h4 (Ne.symm d23) (Ne.symm d24)
  rw [colO o1] at hb1
  rw [colO o4] at hb2
  rcases atY q2 (jsymm h2) with ⟨he2, hv1⟩ | ⟨he2, hv1⟩ | ⟨he2, hv1⟩
  · subst hv1
    rw [he2, col1] at hb2
    rcases atY q3 h3 with ⟨he3, hv3⟩ | ⟨he3, hv3⟩ | ⟨he3, hv3⟩
    · exact n23 (he2.trans he3.symm)
    · -- (C): v0, u, y, w, v4 with c(e1) = τ, c(e4) = σ
      subst hv3
      rw [he3, col2] at hb1
      exact C.CC v0 v4 e1 e4 o1 o4 h1 h4 d01 d03 d14 d34 ⟨hb1, hb2.symm⟩
    · subst hv3
      exact n34 (leaf_two q3 q4 (joins_inc_right h3) (joins_inc_left h4))
  · subst hv1
    rw [he2, col2] at hb2
    rcases atY q3 h3 with ⟨he3, hv3⟩ | ⟨he3, hv3⟩ | ⟨he3, hv3⟩
    · -- (C) read backwards: v4, u, y, w, v0
      subst hv3
      rw [he3, col1] at hb1
      exact C.CC v4 v0 e4 e1 o4 o1 (jsymm h4) (jsymm h1) (Ne.symm d34) (Ne.symm d14) (Ne.symm d03)
