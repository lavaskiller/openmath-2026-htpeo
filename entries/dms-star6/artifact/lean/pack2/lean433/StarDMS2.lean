namespace LeafRecipeLean
open MGraph LeafWLean PiSubOnLean

variable {G H : MGraph} {Q : Fin G.m → Prop} {k : Nat}

structure LeafPi (G H : MGraph) (Q : Fin G.m → Prop) (k : Nat) where
  L : LeafSetup G Q
  S : PiSubstOn (addEdge G L.u L.w) H (supp Q L.y L.u L.w) k
  c : Fin H.m → Fin 5
  hc : H.Star 5 c
  c' : Fin (addEdge G L.u L.w).m → Fin 6
  hC : SubColourOn S c c'

section
variable (X : LeafPi G H Q k)

theorem starK : StarOn (supp Q X.L.y X.L.u X.L.w) 6 X.c' := pi_subst_on X.S X.c X.hc X.c' X.hC

theorem g_supp : supp Q X.L.y X.L.u X.L.w (Fin.last G.m) := Or.inl rfl

theorem g_u : (addEdge G X.L.u X.L.w).Inc (Fin.last G.m) X.L.u := addEdge_inc_new.2 (Or.inl rfl)
theorem g_w : (addEdge G X.L.u X.L.w).Inc (Fin.last G.m) X.L.w := addEdge_inc_new.2 (Or.inr rfl)

/-- properness of `c'` on K -/
theorem kprop {a b : Fin (addEdge G X.L.u X.L.w).m} (pa : supp Q X.L.y X.L.u X.L.w a)
    (pb : supp Q X.L.y X.L.u X.L.w b) (hab : a ≠ b) {x : Fin G.n}
    (ha : (addEdge G X.L.u X.L.w).Inc a x) (hb : (addEdge G X.L.u X.L.w).Inc b x) : X.c' a ≠ X.c' b :=
  (starK X).1 a b ⟨hab, x, ha, hb⟩ pa pb

/-- a K-edge at a vertex lying in no digon is not coloured 6 -/
theorem not_six {v : Fin G.n} (hv : ∀ j, v ≠ X.S.p j ∧ v ≠ X.S.q j) {f : Fin (addEdge G X.L.u X.L.w).m}
    (pf : supp Q X.L.y X.L.u X.L.w f) (hf : (addEdge G X.L.u X.L.w).Inc f v) : X.c' f ≠ Fin.last 5 := by
  intro h
  obtain ⟨j, hj⟩ := six_of_last X.hC pf h
  rw [hj] at hf
  rcases inc_of_joins (X.S.j6 j) hf with e | e
  · exact (hv j).1 e
  · exact (hv j).2 e

/-- a K-edge at a vertex lying in no digon is not a digon edge -/
theorem not_dig {v : Fin G.n} (hv : ∀ j, v ≠ X.S.p j ∧ v ≠ X.S.q j) {f : Fin (addEdge G X.L.u X.L.w).m}
    (hf : (addEdge G X.L.u X.L.w).Inc f v) (j : Fin k) : f ≠ X.S.e6 j ∧ f ≠ X.S.ey j := by
  constructor
  · intro e
    rw [e] at hf
    rcases inc_of_joins (X.S.j6 j) hf with e' | e'
    · exact (hv j).1 e'
    · exact (hv j).2 e'
  · intro e
    rw [e] at hf
    rcases inc_of_joins (X.S.jy j) hf with e' | e'
    · exact (hv j).1 e'
    · exact (hv j).2 e'

/-- two K-edges at a digon vertex that are not digon edges of that digon coincide (both are the port edge) -/
theorem port_unique (i : Fin k) {v : Fin G.n} (hv : v = X.S.p i ∨ v = X.S.q i)
    {f f' : Fin (addEdge G X.L.u X.L.w).m} (pf : supp Q X.L.y X.L.u X.L.w f) (pf' : supp Q X.L.y X.L.u X.L.w f')
    (hf : (addEdge G X.L.u X.L.w).Inc f v) (hf' : (addEdge G X.L.u X.L.w).Inc f' v)
    (h6 : f ≠ X.S.e6 i) (hy : f ≠ X.S.ey i) (h6' : f' ≠ X.S.e6 i) (hy' : f' ≠ X.S.ey i) : f = f' := by
  rcases hv with rfl | rfl
  · rcases X.S.incp i f pf hf with e | e | e
    · exact absurd e h6
    · exact absurd e hy
    · rcases X.S.incp i f' pf' hf' with e' | e' | e'
      · exact absurd e' h6'
      · exact absurd e' hy'
      · exact e.trans e'.symm
  · rcases X.S.incq i f pf hf with e | e | e
    · exact absurd e h6
    · exact absurd e hy
    · rcases X.S.incq i f' pf' hf' with e' | e' | e'
      · exact absurd e' h6'
      · exact absurd e' hy'
      · exact e.trans e'.symm

/-- the other end of a digon edge at `w` is the partner `ts` -/
theorem dig_other (i : Fin k) {w ts z : Fin G.n}
    (hw : (w = X.S.p i ∧ ts = X.S.q i) ∨ (w = X.S.q i ∧ ts = X.S.p i))
    {f : Fin (addEdge G X.L.u X.L.w).m} (hf : f = X.S.e6 i ∨ f = X.S.ey i)
    (hj : (addEdge G X.L.u X.L.w).Joins f w z) : z = ts := by
  have J : (addEdge G X.L.u X.L.w).Joins f (X.S.p i) (X.S.q i) := by
    rcases hf with rfl | rfl
    · exact X.S.j6 i
    · exact X.S.jy i
  have hpq := X.S.hpq i
  rcases joins_unique hj J with ⟨a, b⟩ | ⟨a, b⟩ <;> rcases hw with ⟨c, d⟩ | ⟨c, d⟩
  · exact b.trans d.symm
  · exact absurd (a.symm.trans c) hpq
  · exact absurd (c.symm.trans a) hpq
  · exact b.trans d.symm

end

theorem ne_path {M : MGraph} {f f' : Fin M.m} {a b c : Fin M.n} (h : M.Joins f a b) (h' : M.Joins f' b c)
    (hac : a ≠ c) : f ≠ f' := by
  intro e
  rw [← e] at h'
  rcases joins_unique h h' with ⟨e1, e2⟩ | ⟨e1, _⟩
  · exact hac (e1.trans e2)
  · exact hac e1

/-- **Case half** of Step 4 of fact b22aa11289e61f4c: `t` (= `w`) lies in digon `i`, with partner `ts`, and `s`
    (= `u`) lies in no digon.  Recipe: σ := 6, τ := α = c'(g), λ ∈ [5] avoiding α, the colours at `s` and y_D. -/
theorem case_half (X : LeafPi G H Q k) (hsub : Subcubic G) (i : Fin k) (ts : Fin G.n)
    (hw : (X.L.w = X.S.p i ∧ ts = X.S.q i) ∨ (X.L.w = X.S.q i ∧ ts = X.S.p i))
    (hu : ∀ j, X.L.u ≠ X.S.p j ∧ X.L.u ≠ X.S.q j) :
    ∃ c₀ : Fin G.m → Fin 6, StarOn Q 6 c₀ := by
  have hwD : X.L.w = X.S.p i ∨ X.L.w = X.S.q i := by
    rcases hw with ⟨e, _⟩ | ⟨e, _⟩
    · exact Or.inl e
    · exact Or.inr e
  have hwts : (X.L.w = X.S.p i ∧ ts = X.S.q i) ∨ (X.L.w = X.S.q i ∧ ts = X.S.p i) := hw
  have htsD : ts = X.S.p i ∨ ts = X.S.q i := by
    rcases hw with ⟨_, e⟩ | ⟨_, e⟩
    · exact Or.inr e
    · exact Or.inl e
  -- the port-view pairing (w, ts) as used by port_colour_ne
  obtain ⟨a, b, hab⟩ := at_most_three hsub Q X.L.u X.L.f1 (joins_inc_right X.L.hf1)
  let α := X.c' (Fin.last G.m)
  obtain ⟨lam, l1, l2, l3, l4, l5⟩ :=
    pigeon5 (Fin.last 5) α (X.c' (Fin.castSucc a)) (X.c' (Fin.castSucc b)) (X.c' (X.S.ey i))
  have gnd := not_dig X hu (g_u X)
  have hα6 : α ≠ Fin.last 5 := not_six X hu (g_supp X) (g_u X)
  have hyw : (addEdge G X.L.u X.L.w).Inc (X.S.ey i) X.L.w := by
    rcases hwD with e | e
    · have h := joins_inc_left (X.S.jy i)
      rw [← e] at h
      exact h
    · have h := joins_inc_right (X.S.jy i)
      rw [← e] at h
      exact h
  have hgy : X.c' (X.S.ey i) ≠ α :=
    twin_proper X.hc X.hC i (g_supp X) hyw (g_w X) (Ne.symm (gnd i).2) (fun j => (gnd j).1)
  have tsw : (ts = X.S.p i ∧ X.L.w = X.S.q i) ∨ (ts = X.S.q i ∧ X.L.w = X.S.p i) := by
    rcases hw with ⟨p1, p2⟩ | ⟨p1, p2⟩
    · exact Or.inr ⟨p2, p1⟩
    · exact Or.inl ⟨p2, p1⟩
  -- K-edges at w other than g are digon edges of digon i
  have atW : ∀ d, X.L.O d → G.Inc d X.L.w → Fin.castSucc d = X.S.e6 i ∨ Fin.castSucc d = X.S.ey i := by
    intro d od hd
    apply Classical.byContradiction
    intro hno
    have h6 : Fin.castSucc d ≠ X.S.e6 i := fun e => hno (Or.inl e)
    have hy : Fin.castSucc d ≠ X.S.ey i := fun e => hno (Or.inr e)
    exact castSucc_ne_last' d (port_unique X i hwD (inSupp od) (g_supp X) (addEdge_inc_old.2 hd) (g_w X) h6 hy
      (gnd i).1 (gnd i).2)
  refine ⟨leafCol X.L X.c' (Fin.last 5) α lam, claimW X.L X.c' (Fin.last 5) α lam ⟨starK X, Ne.symm hα6,
    Ne.symm l1, Ne.symm l2, ?pS, ?pT, ?ES, ?ET, ?LS, ?LT, ?MST, ?MTS, ?CC⟩⟩
  case pS =>
    intro d od hd
    exact not_six X hu (inSupp od) (addEdge_inc_old.2 hd)
  case pT =>
    intro d od hd
    rcases atW d od hd with e | e <;> rw [e]
    · rw [X.hC.h6 i]; exact Ne.symm hα6
    · exact hgy
  case ES =>
    rintro z2 z3 z4 d2 d3 d4 o2 o3 o4 h2 h3 h4 nu2 nu3 n23 nu4 n24 n34 ⟨hb3, hb4⟩
    obtain ⟨j, hj⟩ := six_of_last X.hC (inSupp o3) hb3
    exact no_six_third X.hc X.hC (inSupp o2) (inSupp o4) (addEdge_joins_old.2 h2) (addEdge_joins_old.2 h3)
      (addEdge_joins_old.2 h4) nu3 n24 (ne_path (addEdge_joins_old.2 h2) (addEdge_joins_old.2 h3) nu3)
      (ne_path (addEdge_joins_old.2 h3) (addEdge_joins_old.2 h4) n24) hb4.symm j hj
  case ET =>
    rintro z2 z3 z4 d2 d3 d4 o2 o3 o4 h2 h3 h4 nw2 nw3 n23 nw4 n24 n34 ⟨hb3, _⟩
    have hz2 : z2 = ts := dig_other X i hwts (atW d2 o2 (joins_inc_left h2)) (addEdge_joins_old.2 h2)
    subst hz2
    have d3n : Fin.castSucc d3 ≠ X.S.e6 i ∧ Fin.castSucc d3 ≠ X.S.ey i := by
      constructor
      · intro e
        exact nw3 (dig_other X i tsw (Or.inl e) (addEdge_joins_old.2 h3)).symm
      · intro e
        exact nw3 (dig_other X i tsw (Or.inr e) (addEdge_joins_old.2 h3)).symm
    exact port_colour_ne X.hc X.hC i hwts (g_supp X) (inSupp o3) (g_w X) (addEdge_inc_old.2 (joins_inc_left h3))
      (gnd i).1 (gnd i).2 d3n.1 d3n.2 hb3.symm
  case LS =>
    rintro z3 z4 d3 d4 o3 o4 h3 h4 _ _ _ ⟨hb3, _⟩
    rcases hab d3 o3.1 (joins_inc_left h3) with e | e | e
    · exact o3.2 (e ▸ joins_inc_left X.L.hf1)
    · rw [e] at hb3; exact l3 hb3.symm
    · rw [e] at hb3; exact l4 hb3.symm
  case LT =>
    rintro z3 z4 d3 d4 o3 o4 h3 h4 _ _ _ ⟨hb3, _⟩
    rcases atW d3 o3 (joins_inc_left h3) with e | e <;> rw [e] at hb3
    · rw [X.hC.h6 i] at hb3; exact l1 hb3.symm
    · exact l5 hb3.symm
  case MST =>
    rintro z3 z4 d3 d4 o3 o4 h3 h4 _ nw3 nw4 n34 ⟨hb3, hb4⟩
    rcases atW d3 o3 (joins_inc_left h3) with e | e
    · have hz3 : z3 = ts := dig_other X i hwts (Or.inl e) (addEdge_joins_old.2 h3)
      subst hz3
      have d4n : Fin.castSucc d4 ≠ X.S.e6 i ∧ Fin.castSucc d4 ≠ X.S.ey i := by
        constructor
        · intro e'
          exact nw4 (dig_other X i tsw (Or.inl e') (addEdge_joins_old.2 h4)).symm
        · intro e'
          exact nw4 (dig_other X i tsw (Or.inr e') (addEdge_joins_old.2 h4)).symm
      exact port_colour_ne X.hc X.hC i hwts (g_supp X) (inSupp o4) (g_w X)
        (addEdge_inc_old.2 (joins_inc_left h4)) (gnd i).1 (gnd i).2 d4n.1 d4n.2 hb4.symm
    · rw [e, X.hC.hy i] at hb3
      exact castSucc_ne_last' _ hb3
  case MTS =>
    rintro z3 z4 d3 d4 o3 o4 h3 h4 _ _ _ _ ⟨hb3, _⟩
    exact kprop X (inSupp o3) (g_supp X) (castSucc_ne_last' d3) (addEdge_inc_old.2 (joins_inc_left h3)) (g_u X) hb3
  case CC =>
    rintro z0 z4 d1 d4 o1 o4 h1 h4 _ _ _ _ ⟨hb1, _⟩
    exact kprop X (inSupp o1) (g_supp X) (castSucc_ne_last' d1) (addEdge_inc_old.2 (joins_inc_right h1)) (g_u X) hb1


section
variable (X : LeafPi G H Q k)

/-- in the view of digon `i` from its vertex `v` (partner `vs`, port edges `pv` at `v`, `pvs` at `vs`), the K-edges at
    `vs` are the two digon edges and `pvs` -/
theorem inc_vs (i : Fin k) {v vs : Fin G.n} {pv pvs : Fin (addEdge G X.L.u X.L.w).m}
    (hv : (v = X.S.p i ∧ vs = X.S.q i ∧ pv = X.S.pp i ∧ pvs = X.S.pq i) ∨
      (v = X.S.q i ∧ vs = X.S.p i ∧ pv = X.S.pq i ∧ pvs = X.S.pp i))
    {f : Fin (addEdge G X.L.u X.L.w).m} (pf : supp Q X.L.y X.L.u X.L.w f) (hf : (addEdge G X.L.u X.L.w).Inc f vs) :
    f = X.S.e6 i ∨ f = X.S.ey i ∨ f = pvs := by
  rcases hv with ⟨_, rfl, _, rfl⟩ | ⟨_, rfl, _, rfl⟩
  · exact X.S.incq i f pf hf
  · exact X.S.incp i f pf hf

theorem pair_of (i : Fin k) {v vs : Fin G.n} {pv pvs : Fin (addEdge G X.L.u X.L.w).m}
    (hv : (v = X.S.p i ∧ vs = X.S.q i ∧ pv = X.S.pp i ∧ pvs = X.S.pq i) ∨
      (v = X.S.q i ∧ vs = X.S.p i ∧ pv = X.S.pq i ∧ pvs = X.S.pp i)) :
    (v = X.S.p i ∧ vs = X.S.q i) ∨ (v = X.S.q i ∧ vs = X.S.p i) := by
  rcases hv with ⟨a, b, _, _⟩ | ⟨a, b, _, _⟩
  · exact Or.inl ⟨a, b⟩
  · exact Or.inr ⟨a, b⟩

theorem swap_pair (i : Fin k) {v vs : Fin G.n}
    (h : (v = X.S.p i ∧ vs = X.S.q i) ∨ (v = X.S.q i ∧ vs = X.S.p i)) :
    (vs = X.S.p i ∧ v = X.S.q i) ∨ (vs = X.S.q i ∧ v = X.S.p i) := by
  rcases h with ⟨a, b⟩ | ⟨a, b⟩
  · exact Or.inr ⟨b, a⟩
  · exact Or.inl ⟨b, a⟩

theorem mem_of_pair (i : Fin k) {v vs : Fin G.n}
    (h : (v = X.S.p i ∧ vs = X.S.q i) ∨ (v = X.S.q i ∧ vs = X.S.p i)) : v = X.S.p i ∨ v = X.S.q i := by
  rcases h with ⟨a, _⟩ | ⟨a, _⟩
  · exact Or.inl a
  · exact Or.inr a

/-- the digon edges of digon `i` are incident with each of its vertices -/
theorem dig_inc (i : Fin k) {v : Fin G.n} (hv : v = X.S.p i ∨ v = X.S.q i) :
    (addEdge G X.L.u X.L.w).Inc (X.S.e6 i) v ∧ (addEdge G X.L.u X.L.w).Inc (X.S.ey i) v := by
  rcases hv with e | e
  · have h1 := joins_inc_left (X.S.j6 i)
    have h2 := joins_inc_left (X.S.jy i)
    rw [← e] at h1 h2
    exact ⟨h1, h2⟩
  · have h1 := joins_inc_right (X.S.j6 i)
    have h2 := joins_inc_right (X.S.jy i)
    rw [← e] at h1 h2
    exact ⟨h1, h2⟩

/-- `g` is not a digon edge of a digon `i` avoiding one of its ends... (here: `w` lies in another digon `j`) -/
theorem g_not_dig (i j : Fin k) (hij : i ≠ j) (hwj : X.L.w = X.S.p j ∨ X.L.w = X.S.q j) :
    Fin.last G.m ≠ X.S.e6 i ∧ Fin.last G.m ≠ X.S.ey i := by
  have hd := X.S.disj i j hij
  have key : ∀ f, f = X.S.e6 i ∨ f = X.S.ey i → Fin.last G.m ≠ f := by
    intro f hf e
    have J : (addEdge G X.L.u X.L.w).Joins f (X.S.p i) (X.S.q i) := by
      rcases hf with rfl | rfl
      · exact X.S.j6 i
      · exact X.S.jy i
    rw [← e] at J
    have hwi : X.L.w = X.S.p i ∨ X.L.w = X.S.q i := inc_of_joins (G := addEdge G X.L.u X.L.w) J (g_w X)
    rcases hwi with a | a <;> rcases hwj with b | b
    · exact hd.1 (a.symm.trans b)
    · exact hd.2.1 (a.symm.trans b)
    · exact hd.2.2.1 (a.symm.trans b)
    · exact hd.2.2.2 (a.symm.trans b)
  exact ⟨key _ (Or.inl rfl), key _ (Or.inr rfl)⟩

theorem g_not_dig' (i j : Fin k) (hij : i ≠ j) (hui : X.L.u = X.S.p i ∨ X.L.u = X.S.q i) :
    Fin.last G.m ≠ X.S.e6 j ∧ Fin.last G.m ≠ X.S.ey j := by
  have hd := X.S.disj i j hij
  have key : ∀ f, f = X.S.e6 j ∨ f = X.S.ey j → Fin.last G.m ≠ f := by
    intro f hf e
    have J : (addEdge G X.L.u X.L.w).Joins f (X.S.p j) (X.S.q j) := by
      rcases hf with rfl | rfl
      · exact X.S.j6 j
      · exact X.S.jy j
    rw [← e] at J
    have huj : X.L.u = X.S.p j ∨ X.L.u = X.S.q j := inc_of_joins (G := addEdge G X.L.u X.L.w) J (g_u X)
    rcases hui with a | a <;> rcases huj with b | b
    · exact hd.1 (a.symm.trans b)
    · exact hd.2.1 (a.symm.trans b)
    · exact hd.2.2.1 (a.symm.trans b)
    · exact hd.2.2.2 (a.symm.trans b)
  exact ⟨key _ (Or.inl rfl), key _ (Or.inr rfl)⟩

/-- the old K-edges at a digon vertex `v` whose port edge is `g` are the digon edges -/
theorem old_at_dv (i : Fin k) {v : Fin G.n} (hv : v = X.S.p i ∨ v = X.S.q i)
    (hgv : (addEdge G X.L.u X.L.w).Inc (Fin.last G.m) v) (hg6 : Fin.last G.m ≠ X.S.e6 i)
    (hgy : Fin.last G.m ≠ X.S.ey i) {d : Fin G.m} (od : X.L.O d) (hd : G.Inc d v) :
    Fin.castSucc d = X.S.e6 i ∨ Fin.castSucc d = X.S.ey i := by
  apply Classical.byContradiction
  intro hno
  have h6 : Fin.castSucc d ≠ X.S.e6 i := fun e => hno (Or.inl e)
  have hy : Fin.castSucc d ≠ X.S.ey i := fun e => hno (Or.inr e)
  exact castSucc_ne_last' d (port_unique X i hv (inSupp od) (g_supp X) (addEdge_inc_old.2 hd) hgv h6 hy hg6 hgy)

/-- colour of an old edge at a digon vertex whose port edge is `g`: 6 or the twin colour -/
theorem col_old_dv (i : Fin k) {v : Fin G.n} (hv : v = X.S.p i ∨ v = X.S.q i)
    (hgv : (addEdge G X.L.u X.L.w).Inc (Fin.last G.m) v) (hg6 : Fin.last G.m ≠ X.S.e6 i)
    (hgy : Fin.last G.m ≠ X.S.ey i) {d : Fin G.m} (od : X.L.O d) (hd : G.Inc d v) :
    X.c' (Fin.castSucc d) = Fin.last 5 ∨ X.c' (Fin.castSucc d) = X.c' (X.S.ey i) := by
  rcases old_at_dv X i hv hgv hg6 hgy od hd with e | e <;> rw [e]
  · exact Or.inl (X.hC.h6 i)
  · exact Or.inr rfl

/-- an old edge at `v` in digon `i` (port `g`) leads to the partner `vs`; the next old edge from `vs` (not back to
    `v`) is the port edge `pvs` of `vs` -/
theorem next_port (i : Fin k) {v vs : Fin G.n} {pv pvs : Fin (addEdge G X.L.u X.L.w).m}
    (hv : (v = X.S.p i ∧ vs = X.S.q i ∧ pv = X.S.pp i ∧ pvs = X.S.pq i) ∨
      (v = X.S.q i ∧ vs = X.S.p i ∧ pv = X.S.pq i ∧ pvs = X.S.pp i))
    (hgv : (addEdge G X.L.u X.L.w).Inc (Fin.last G.m) v) (hg6 : Fin.last G.m ≠ X.S.e6 i)
    (hgy : Fin.last G.m ≠ X.S.ey i) {z2 z3 : Fin G.n} {d2 d3 : Fin G.m} (o2 : X.L.O d2) (o3 : X.L.O d3)
    (h2 : G.Joins d2 v z2) (h3 : G.Joins d3 z2 z3) (hvz3 : v ≠ z3) :
    z2 = vs ∧ Fin.castSucc d3 = pvs := by
  have pr := pair_of X i hv
  have hvD := mem_of_pair X i pr
  have hz2 : z2 = vs := dig_other X i pr (old_at_dv X i hvD hgv hg6 hgy o2 (joins_inc_left h2))
    (addEdge_joins_old.2 h2)
  subst hz2
  refine ⟨rfl, ?_⟩
  rcases inc_vs X i hv (inSupp o3) (addEdge_inc_old.2 (joins_inc_left h3)) with e | e | e
  · exact absurd (dig_other X i (swap_pair X i pr) (Or.inl e) (addEdge_joins_old.2 h3)).symm hvz3
  · exact absurd (dig_other X i (swap_pair X i pr) (Or.inr e) (addEdge_joins_old.2 h3)).symm hvz3
  · exact e

end

/-- **Case link** of Step 4 of fact b22aa11289e61f4c: `s` (= `u`) lies in digon `i` (partner `ss`, port edges
    `ps`, `pss`), `t` (= `w`) in digon `j ≠ i` (partner `tt`, port edges `pt`, `ptt`).
    Recipe: σ ∈ [5] \ {y_i, c'(pss), y_j}, τ ∈ [5] \ {y_j, c'(ptt), σ}, λ := 6. -/
theorem case_link (X : LeafPi G H Q k) (i j : Fin k) (hij : i ≠ j) (ss tt : Fin G.n)
    (ps pss pt ptt : Fin (addEdge G X.L.u X.L.w).m)
    (hs : (X.L.u = X.S.p i ∧ ss = X.S.q i ∧ ps = X.S.pp i ∧ pss = X.S.pq i) ∨
      (X.L.u = X.S.q i ∧ ss = X.S.p i ∧ ps = X.S.pq i ∧ pss = X.S.pp i))
    (ht : (X.L.w = X.S.p j ∧ tt = X.S.q j ∧ pt = X.S.pp j ∧ ptt = X.S.pq j) ∨
      (X.L.w = X.S.q j ∧ tt = X.S.p j ∧ pt = X.S.pq j ∧ ptt = X.S.pp j)) :
    ∃ c₀ : Fin G.m → Fin 6, StarOn Q 6 c₀ := by
  have huD : X.L.u = X.S.p i ∨ X.L.u = X.S.q i := mem_of_pair X i (pair_of X i hs)
  have hwD : X.L.w = X.S.p j ∨ X.L.w = X.S.q j := mem_of_pair X j (pair_of X j ht)
  have gi := g_not_dig X i j hij hwD
  have gj := g_not_dig' X i j hij huD
  obtain ⟨σ, s1, s2, s3, s4, -⟩ :=
    pigeon5 (Fin.last 5) (X.c' (X.S.ey i)) (X.c' pss) (X.c' (X.S.ey j)) (Fin.last 5)
  obtain ⟨τ, t1, t2, t3, t4, -⟩ := pigeon5 (Fin.last 5) (X.c' (X.S.ey j)) (X.c' ptt) σ (Fin.last 5)
  refine ⟨leafCol X.L X.c' σ τ (Fin.last 5), claimW X.L X.c' σ τ (Fin.last 5) ⟨starK X, Ne.symm t4,
    s1, t1, ?pS, ?pT, ?ES, ?ET, ?LS, ?LT, ?MST, ?MTS, ?CC⟩⟩
  case pS =>
    intro d od hd
    rcases col_old_dv X i huD (g_u X) gi.1 gi.2 od hd with e | e <;> rw [e]
    · exact Ne.symm s1
    · exact Ne.symm s2
  case pT =>
    intro d od hd
    rcases col_old_dv X j hwD (g_w X) gj.1 gj.2 od hd with e | e <;> rw [e]
    · exact Ne.symm t1
    · exact Ne.symm t2
  case ES =>
    rintro z2 z3 z4 d2 d3 d4 o2 o3 o4 h2 h3 h4 _ nu3 _ _ _ _ ⟨hb3, _⟩
    have np := next_port X i hs (g_u X) gi.1 gi.2 o2 o3 h2 h3 nu3
    rw [np.2] at hb3
    exact s3 hb3.symm
  case ET =>
    rintro z2 z3 z4 d2 d3 d4 o2 o3 o4 h2 h3 h4 _ nw3 _ _ _ _ ⟨hb3, _⟩
    have np := next_port X j ht (g_w X) gj.1 gj.2 o2 o3 h2 h3 nw3
    rw [np.2] at hb3
    exact t3 hb3.symm
  case LS =>
    rintro z3 z4 d3 d4 o3 o4 h3 h4 _ nu4 _ ⟨_, hb4⟩
    have np := next_port X i hs (g_u X) gi.1 gi.2 o3 o4 h3 h4 nu4
    rw [np.2] at hb4
    exact s3 hb4.symm
  case LT =>
    rintro z3 z4 d3 d4 o3 o4 h3 h4 _ nw4 _ ⟨_, hb4⟩
    have np := next_port X j ht (g_w X) gj.1 gj.2 o3 o4 h3 h4 nw4
    rw [np.2] at hb4
    exact t3 hb4.symm
  case MST =>
    rintro z3 z4 d3 d4 o3 o4 h3 h4 _ _ _ _ ⟨hb3, _⟩
    rcases col_old_dv X j hwD (g_w X) gj.1 gj.2 o3 (joins_inc_left h3) with e | e <;> rw [e] at hb3
    · exact s1 hb3.symm
    · exact s4 hb3.symm
  case MTS =>
    rintro z3 z4 d3 d4 o3 o4 h3 h4 _ _ nu4 _ ⟨_, hb4⟩
    have np := next_port X i hs (g_u X) gi.1 gi.2 o3 o4 h3 h4 nu4
    rw [np.2] at hb4
    exact s3 hb4.symm
  case CC =>
    rintro z0 z4 d1 d4 o1 o4 h1 h4 _ _ _ _ ⟨_, hb4⟩
    rcases col_old_dv X j hwD (g_w X) gj.1 gj.2 o4 (joins_inc_left h4) with e | e <;> rw [e] at hb4
    · exact s1 hb4.symm
    · exact s4 hb4.symm


section
variable (X : LeafPi G H Q k)

theorem K_loopless : Loopless (addEdge G X.L.u X.L.w) := addEdge_loopless X.L.hloop X.L.huw

/-- (R2) twin avoidance in K: let `a` be the port edge of digon `i` at its vertex `z`, with far end `s'`; every other
    old K-edge `e` at `s'` has a colour different from the twin colour of digon `i`. -/
theorem twin_avoid (hPL : ∀ i, PiRigidLean.PiLocal (X.S.copy i)) (hlH : PiRigidLean.Loopless H)
    (i : Fin k) {z s' : Fin G.n} (hz : z = X.S.p i ∨ z = X.S.q i) {a e : Fin (addEdge G X.L.u X.L.w).m}
    (pa : supp Q X.L.y X.L.u X.L.w a) (ha : (addEdge G X.L.u X.L.w).Joins a z s')
    (ha6 : a ≠ X.S.e6 i) (hay : a ≠ X.S.ey i)
    (pe : supp Q X.L.y X.L.u X.L.w e) (oe : X.S.IsOld e) (he : (addEdge G X.L.u X.L.w).Inc e s') (hea : e ≠ a) :
    X.c' e ≠ X.c' (X.S.ey i) := by
  have hzs : z ≠ s' := ne_of_joins (K_loopless X) ha
  obtain ⟨y', hje⟩ := PiRigidLean.inc_joins he
  have je := X.S.oldJ e y' s' pe oe hje
  rw [X.hC.hold e pe oe, X.hC.hy i]
  intro hc
  have hc' := castSucc_inj' hc
  rcases hz with rfl | rfl
  · have hap : a = X.S.pp i := by
      rcases X.S.incp i a pa (joins_inc_left ha) with h | h | h
      · exact absurd h ha6
      · exact absurd h hay
      · exact h
    have oa : X.S.IsOld a := by rw [hap]; exact pp_old X.S i
    have ja := X.S.oldJ a _ s' pa oa ha
    have jAu := (X.S.copy i).jAu
    rw [X.S.cAu i, ← hap, X.S.cA i] at jAu
    have hu' : (X.S.copy i).u = X.S.φ s' := by
      rcases joins_unique jAu ja with ⟨_, h⟩ | ⟨h1, _⟩
      · exact h
      · exact absurd (X.S.φinj _ _ h1) hzs
    have hinc : H.Inc (X.S.old e) (X.S.copy i).u := by rw [hu']; exact joins_inc_right je
    have hne : X.S.old e ≠ (X.S.copy i).eAu := by
      rw [X.S.cAu i, ← hap]
      exact fun h => hea (X.S.oldInj e a pe pa oe oa h)
    exact PiRigidLean.pi_twin_u (X.S.copy i) (hPL i) hlH X.c X.hc (X.S.old e) hinc hne hc'
  · have hap : a = X.S.pq i := by
      rcases X.S.incq i a pa (joins_inc_left ha) with h | h | h
      · exact absurd h ha6
      · exact absurd h hay
      · exact h
    have oa : X.S.IsOld a := by rw [hap]; exact pq_old X.S i
    have ja := X.S.oldJ a _ s' pa oa ha
    have jBv := (X.S.copy i).jBv
    rw [X.S.cBv i, ← hap, X.S.cB i] at jBv
    have hv' : (X.S.copy i).v = X.S.φ s' := by
      rcases joins_unique jBv ja with ⟨_, h⟩ | ⟨h1, _⟩
      · exact h
      · exact absurd (X.S.φinj _ _ h1) hzs
    have hinc : H.Inc (X.S.old e) (X.S.copy i).v := by rw [hv']; exact joins_inc_right je
    have hne : X.S.old e ≠ (X.S.copy i).eBv := by
      rw [X.S.cBv i, ← hap]
      exact fun h => hea (X.S.oldInj e a pe pa oe oa h)
    exact PiRigidLean.pi_twin_v (X.S.copy i) (hPL i) hlH X.c X.hc (X.S.old e) hinc hne hc'

end


section
variable (X : LeafPi G H Q k)

/-- an old edge `d` at `s` whose far end carries another old edge of colour `κ` (the set F_s(κ) of the fact) -/
def BS (κ : Fin 6) (d : Fin G.m) : Prop :=
  ∃ z d4 z4, X.L.O d4 ∧ G.Joins d X.L.u z ∧ G.Joins d4 z z4 ∧ z4 ≠ X.L.u ∧ X.c' (Fin.castSucc d4) = κ

/-- a bicoloured path x, v, z2, z3, z4 whose third edge has colour 6 is impossible (Step 1 of (A)) -/
theorem six_path {v z2 z3 z4 : Fin G.n} {d2 d3 d4 : Fin G.m} (o2 : X.L.O d2) (o3 : X.L.O d3) (o4 : X.L.O d4)
    (h2 : G.Joins d2 v z2) (h3 : G.Joins d3 z2 z3) (h4 : G.Joins d4 z3 z4) (hvz3 : v ≠ z3) (hz24 : z2 ≠ z4)
    (hb3 : X.c' (Fin.castSucc d3) = Fin.last 5) (hb4 : X.c' (Fin.castSucc d4) = X.c' (Fin.castSucc d2)) : False := by
  obtain ⟨j, hj⟩ := six_of_last X.hC (inSupp o3) hb3
  have h2' := addEdge_joins_old (u := X.L.u) (w := X.L.w) |>.2 h2
  have h3' := addEdge_joins_old (u := X.L.u) (w := X.L.w) |>.2 h3
  have h4' := addEdge_joins_old (u := X.L.u) (w := X.L.w) |>.2 h4
  exact no_six_third X.hc X.hC (inSupp o2) (inSupp o4) h2' h3' h4' hvz3 hz24 (ne_path h2' h3' hvz3)
    (ne_path h3' h4' hz24) hb4.symm j hj

/-- a bicoloured path x, v1, z2, z3, z4 whose third edge has the colour of g = v0 v1 closes, through g, a
    bicoloured path or 4-cycle of K (needs: no old edge parallel to g) -/
theorem kwalk_g {v0 v1 : Fin G.n} (hg : (addEdge G X.L.u X.L.w).Joins (Fin.last G.m) v0 v1)
    (hg0 : (addEdge G X.L.u X.L.w).Inc (Fin.last G.m) v0) (hv01 : v0 ≠ v1)
    (hnp' : ∀ d, X.L.O d → ¬ G.Joins d v1 v0) {z2 z3 z4 : Fin G.n} {d2 d3 d4 : Fin G.m}
    (o2 : X.L.O d2) (o3 : X.L.O d3) (o4 : X.L.O d4)
    (h2 : G.Joins d2 v1 z2) (h3 : G.Joins d3 z2 z3) (h4 : G.Joins d4 z3 z4)
    (d12 : v1 ≠ z2) (d13 : v1 ≠ z3) (d23 : z2 ≠ z3) (d14 : v1 ≠ z4) (d24 : z2 ≠ z4) (d34 : z3 ≠ z4)
    (hb3 : X.c' (Fin.castSucc d3) = X.c' (Fin.last G.m))
    (hb4 : X.c' (Fin.castSucc d4) = X.c' (Fin.castSucc d2)) : False := by
  by_cases hz3 : z3 = v0
  · have hi : (addEdge G X.L.u X.L.w).Inc (Fin.castSucc d3) v0 := by
      rw [← hz3]; exact addEdge_inc_old.2 (joins_inc_right h3)
    exact kprop X (inSupp o3) (g_supp X) (castSucc_ne_last' d3) hi hg0 hb3
  · have d02 : v0 ≠ z2 := by
      intro e
      rw [← e] at h2
      exact hnp' d2 o2 h2
    let w2 : (addEdge G X.L.u X.L.w).Walk4 :=
      { v0 := v0, v1 := v1, v2 := z2, v3 := z3, v4 := z4
        e1 := Fin.last G.m, e2 := Fin.castSucc d2, e3 := Fin.castSucc d3, e4 := Fin.castSucc d4
        h1 := hg, h2 := addEdge_joins_old.2 h2, h3 := addEdge_joins_old.2 h3, h4 := addEdge_joins_old.2 h4
        d01 := hv01, d02 := d02, d03 := fun e => hz3 e.symm, d12 := d12, d13 := d13, d14 := d14,
        d23 := d23, d24 := d24, d34 := d34 }
    exact (starK X).2 w2 (g_supp X) (inSupp o2) (inSupp o3) (inSupp o4) ⟨hb3.symm, hb4.symm⟩

/-- if the far end of an old edge `d` at `s` (with `s` in no digon) carries an old edge of colour α = c'(g) other
    than `d`, then it carries no old edge of colour 6 other than `d` (uses twin avoidance (R2)) -/
theorem noC (hPL : ∀ i, PiRigidLean.PiLocal (X.S.copy i)) (hlH : PiRigidLean.Loopless H)
    (hu : ∀ j, X.L.u ≠ X.S.p j ∧ X.L.u ≠ X.S.q j) {d : Fin G.m} (od : X.L.O d)
    (hα : BS X (X.c' (Fin.last G.m)) d) (h6 : BS X (Fin.last 5) d) : False := by
  obtain ⟨z, d4, z4, o4, hd, h4, hz4, hc4⟩ := hα
  obtain ⟨z', d5, z5, o5, hd', h5, hz5, hc5⟩ := h6
  have huz : X.L.u ≠ z := joins_ne' X.L.hloop hd
  have hzz : z' = z := other_end hd hd' huz
  subst hzz
  obtain ⟨j, hj⟩ := six_of_last X.hC (inSupp o5) hc5
  have hzD : z' = X.S.p j ∨ z' = X.S.q j := by
    have := addEdge_inc_old (u := X.L.u) (w := X.L.w) |>.2 (joins_inc_left h5)
    rw [hj] at this
    exact inc_of_joins (G := addEdge G X.L.u X.L.w) (X.S.j6 j) this
  have hdK : (addEdge G X.L.u X.L.w).Joins (Fin.castSucc d) X.L.u z' := addEdge_joins_old.2 hd
  have dnd := not_dig X hu (joins_inc_left hdK) j
  have hd4d : Fin.castSucc d4 ≠ Fin.castSucc d := by
    intro e
    have e' := Fin.castSucc_inj.1 e
    rw [e'] at h4
    exact hz4 (other_end (jsymm hd) h4 (Ne.symm huz))
  -- the α-edge d4 at z' is a digon edge of j
  have hd4D : Fin.castSucc d4 = X.S.e6 j ∨ Fin.castSucc d4 = X.S.ey j := by
    apply Classical.byContradiction
    intro hno
    exact hd4d (port_unique X j hzD (inSupp o4) (inSupp od) (addEdge_inc_old.2 (joins_inc_left h4))
      (joins_inc_right hdK) (fun e => hno (Or.inl e)) (fun e => hno (Or.inr e)) dnd.1 dnd.2)
  have gold : X.S.IsOld (Fin.last G.m) := fun i => not_dig X hu (g_u X) i
  have tav := twin_avoid X hPL hlH j hzD (inSupp od) (jsymm hdK) dnd.1 dnd.2 (g_supp X) gold (g_u X)
    (fun e => castSucc_ne_last' d e.symm)
  rcases hd4D with e | e <;> rw [e] at hc4
  · rw [X.hC.h6 j] at hc4
    exact not_six X hu (g_supp X) (g_u X) hc4.symm
  · exact tav hc4.symm

end

/-- **Case plain** of Step 4 of fact b22aa11289e61f4c: neither `s` (= `u`) nor `t` (= `w`) lies in a digon, and no
    old edge is parallel to g.  Recipes R0 (σ = α, τ = 6) and R0' (σ = 6, τ = α); one of them has an admissible λ. -/
theorem case_plain (X : LeafPi G H Q k) (hsub : Subcubic G)
    (hPL : ∀ i, PiRigidLean.PiLocal (X.S.copy i)) (hlH : PiRigidLean.Loopless H)
    (hu : ∀ j, X.L.u ≠ X.S.p j ∧ X.L.u ≠ X.S.q j) (hw : ∀ j, X.L.w ≠ X.S.p j ∧ X.L.w ≠ X.S.q j)
    (hnp : ∀ d, X.L.O d → ¬ G.Joins d X.L.u X.L.w) :
    ∃ c₀ : Fin G.m → Fin 6, StarOn Q 6 c₀ := by
  obtain ⟨a, b, hab⟩ := at_most_three hsub Q X.L.u X.L.f1 (joins_inc_right X.L.hf1)
  obtain ⟨a', b', hab'⟩ := at_most_three hsub Q X.L.w X.L.f2 (joins_inc_right X.L.hf2)
  have hα6 : X.c' (Fin.last G.m) ≠ Fin.last 5 := not_six X hu (g_supp X) (g_u X)
  have pS6 : ∀ d, X.L.O d → G.Inc d X.L.u → X.c' (Fin.castSucc d) ≠ Fin.last 5 :=
    fun d od hd => not_six X hu (inSupp od) (addEdge_inc_old.2 hd)
  have pT6 : ∀ d, X.L.O d → G.Inc d X.L.w → X.c' (Fin.castSucc d) ≠ Fin.last 5 :=
    fun d od hd => not_six X hw (inSupp od) (addEdge_inc_old.2 hd)
  have pSα : ∀ d, X.L.O d → G.Inc d X.L.u → X.c' (Fin.castSucc d) ≠ X.c' (Fin.last G.m) :=
    fun d od hd => kprop X (inSupp od) (g_supp X) (castSucc_ne_last' d) (addEdge_inc_old.2 hd) (g_u X)
  have pTα : ∀ d, X.L.O d → G.Inc d X.L.w → X.c' (Fin.castSucc d) ≠ X.c' (Fin.last G.m) :=
    fun d od hd => kprop X (inSupp od) (g_supp X) (castSucc_ne_last' d) (addEdge_inc_old.2 hd) (g_w X)
  have atU : ∀ d, X.L.O d → G.Inc d X.L.u → d = a ∨ d = b := by
    intro d od hd
    rcases hab d od.1 hd with e | e | e
    · exact absurd (e ▸ joins_inc_left X.L.hf1) od.2
    · exact Or.inl e
    · exact Or.inr e
  have atW : ∀ d, X.L.O d → G.Inc d X.L.w → d = a' ∨ d = b' := by
    intro d od hd
    rcases hab' d od.1 hd with e | e | e
    · exact absurd (e ▸ joins_inc_left X.L.hf2) od.2
    · exact Or.inl e
    · exact Or.inr e
  have gU : (addEdge G X.L.u X.L.w).Joins (Fin.last G.m) X.L.w X.L.u := jsymm addEdge_joins_new
  have gW : (addEdge G X.L.u X.L.w).Joins (Fin.last G.m) X.L.u X.L.w := addEdge_joins_new
  have hnpW : ∀ d, X.L.O d → ¬ G.Joins d X.L.w X.L.u := fun d od h => hnp d od (jsymm h)
  by_cases hB : BS X (X.c' (Fin.last G.m)) a ∧ BS X (X.c' (Fin.last G.m)) b
  · -- recipe R0': σ = 6, τ = α
    obtain ⟨lam, l1, l2, l3, l4, -⟩ :=
      pigeon5 (Fin.last 5) (X.c' (Fin.last G.m)) (X.c' (Fin.castSucc a')) (X.c' (Fin.castSucc b')) (Fin.last 5)
    refine ⟨leafCol X.L X.c' (Fin.last 5) (X.c' (Fin.last G.m)) lam,
      claimW X.L X.c' (Fin.last 5) (X.c' (Fin.last G.m)) lam ⟨starK X, Ne.symm hα6, Ne.symm l1, Ne.symm l2,
        pS6, pTα, ?ES, ?ET, ?LS, ?LT, ?MST, ?MTS, ?CC⟩⟩
    case ES =>
      rintro z2 z3 z4 d2 d3 d4 o2 o3 o4 h2 h3 h4 _ nu3 _ _ n24 _ ⟨hb3, hb4⟩
      exact six_path X o2 o3 o4 h2 h3 h4 nu3 n24 hb3 hb4
    case ET =>
      rintro z2 z3 z4 d2 d3 d4 o2 o3 o4 h2 h3 h4 n12 n13 n23 n14 n24 n34 ⟨hb3, hb4⟩
      exact kwalk_g X gW (g_u X) X.L.huw hnpW o2 o3 o4 h2 h3 h4 n12 n13 n23 n14 n24 n34 hb3 hb4
    case LS =>
      rintro z3 z4 d3 d4 o3 o4 h3 h4 _ nu4 _ ⟨_, hb4⟩
      have h6 : BS X (Fin.last 5) d3 := ⟨z3, d4, z4, o4, h3, h4, Ne.symm nu4, hb4⟩
      rcases atU d3 o3 (joins_inc_left h3) with e | e
      · exact noC X hPL hlH hu o3 (e ▸ hB.1) h6
      · exact noC X hPL hlH hu o3 (e ▸ hB.2) h6
    case LT =>
      rintro z3 z4 d3 d4 o3 o4 h3 h4 _ _ _ ⟨hb3, _⟩
      rcases atW d3 o3 (joins_inc_left h3) with e | e <;> rw [e] at hb3
      · exact l3 hb3.symm
      · exact l4 hb3.symm
    case MST =>
      rintro z3 z4 d3 d4 o3 o4 h3 h4 _ _ _ _ ⟨hb3, _⟩
      exact pT6 d3 o3 (joins_inc_left h3) hb3
    case MTS =>
      rintro z3 z4 d3 d4 o3 o4 h3 h4 _ _ _ _ ⟨hb3, _⟩
      exact pSα d3 o3 (joins_inc_left h3) hb3
    case CC =>
      rintro z0 z4 d1 d4 o1 o4 h1 h4 _ _ _ _ ⟨hb1, _⟩
      exact pSα d1 o1 (joins_inc_right h1) hb1
  · -- recipe R0: σ = α, τ = 6; all old edges at s leading to an α-edge are one edge e1
    obtain ⟨e1, he1⟩ : ∃ e1, ∀ d, X.L.O d → G.Inc d X.L.u → BS X (X.c' (Fin.last G.m)) d → d = e1 := by
      rcases Classical.em (BS X (X.c' (Fin.last G.m)) a) with ha | ha
      · refine ⟨a, fun d od hd hbd => ?_⟩
        rcases atU d od hd with e | e
        · exact e
        · exact absurd ⟨ha, e ▸ hbd⟩ hB
      · refine ⟨b, fun d od hd hbd => ?_⟩
        rcases atU d od hd with e | e
        · exact absurd (e ▸ hbd) ha
        · exact e
    obtain ⟨lam, l1, l2, l3, l4, l5⟩ :=
      pigeon5 (Fin.last 5) (X.c' (Fin.last G.m)) (X.c' (Fin.castSucc e1)) (X.c' (Fin.castSucc a'))
        (X.c' (Fin.castSucc b'))
    refine ⟨leafCol X.L X.c' (X.c' (Fin.last G.m)) (Fin.last 5) lam,
      claimW X.L X.c' (X.c' (Fin.last G.m)) (Fin.last 5) lam ⟨starK X, hα6, Ne.symm l2, Ne.symm l1,
        pSα, pT6, ?ES, ?ET, ?LS, ?LT, ?MST, ?MTS, ?CC⟩⟩
    case ES =>
      rintro z2 z3 z4 d2 d3 d4 o2 o3 o4 h2 h3 h4 n12 n13 n23 n14 n24 n34 ⟨hb3, hb4⟩
      exact kwalk_g X gU (g_w X) (Ne.symm X.L.huw) hnp o2 o3 o4 h2 h3 h4 n12 n13 n23 n14 n24 n34 hb3 hb4
    case ET =>
      rintro z2 z3 z4 d2 d3 d4 o2 o3 o4 h2 h3 h4 _ nw3 _ _ n24 _ ⟨hb3, hb4⟩
      exact six_path X o2 o3 o4 h2 h3 h4 nw3 n24 hb3 hb4
    case LS =>
      rintro z3 z4 d3 d4 o3 o4 h3 h4 _ nu4 _ ⟨hb3, hb4⟩
      have hbd : BS X (X.c' (Fin.last G.m)) d3 := ⟨z3, d4, z4, o4, h3, h4, Ne.symm nu4, hb4⟩
      have e := he1 d3 o3 (joins_inc_left h3) hbd
      rw [e] at hb3
      exact l3 hb3.symm
    case LT =>
      rintro z3 z4 d3 d4 o3 o4 h3 h4 _ _ _ ⟨hb3, _⟩
      rcases atW d3 o3 (joins_inc_left h3) with e | e <;> rw [e] at hb3
      · exact l4 hb3.symm
      · exact l5 hb3.symm
    case MST =>
      rintro z3 z4 d3 d4 o3 o4 h3 h4 _ _ _ _ ⟨hb3, _⟩
      exact pTα d3 o3 (joins_inc_left h3) hb3
    case MTS =>
      rintro z3 z4 d3 d4 o3 o4 h3 h4 _ _ _ _ ⟨hb3, _⟩
      exact pS6 d3 o3 (joins_inc_left h3) hb3
    case CC =>
      rintro z0 z4 d1 d4 o1 o4 h1 h4 _ _ _ _ ⟨hb1, _⟩
      exact pS6 d1 o1 (joins_inc_right h1) hb1


/-! ### Case dig: g is the six-edge of a digon {s, t} -/

section
variable (X : LeafPi G H Q k)

/-- Lemma P of fact b22aa11289e61f4c, generalised: at a vertex `v` of digon `i` (port edge `pv` = `castSucc d2` to
    `v'`), a copy edge `τ0` at `φ v` with a new far end forbids the bicoloured continuation v', z3, z4 with
    colours c(τ0), c'(d2). -/
theorem lemmaP (i : Fin k) {v vs : Fin G.n} {pv pvs : Fin (addEdge G X.L.u X.L.w).m}
    (hv : (v = X.S.p i ∧ vs = X.S.q i ∧ pv = X.S.pp i ∧ pvs = X.S.pq i) ∨
      (v = X.S.q i ∧ vs = X.S.p i ∧ pv = X.S.pq i ∧ pvs = X.S.pp i))
    {τ0 : Fin H.m} {σ0 : Fin H.n} (hτ0 : H.Joins τ0 σ0 (X.S.φ v)) (hσ0 : ∀ t, σ0 ≠ X.S.φ t)
    {v' z3 z4 : Fin G.n} {d2 d3 d4 : Fin G.m} (o2 : X.L.O d2) (o3 : X.L.O d3) (o4 : X.L.O d4)
    (h2 : G.Joins d2 v v') (h3 : G.Joins d3 v' z3) (h4 : G.Joins d4 z3 z4) (hd2 : Fin.castSucc d2 = pv)
    (hvz3 : v ≠ z3) (hvz4 : v ≠ z4) (hv'z3 : v' ≠ z3) (hv'z4 : v' ≠ z4) (hz34 : z3 ≠ z4)
    (hb3 : X.c' (Fin.castSucc d3) = Fin.castSucc (X.c τ0))
    (hb4 : X.c' (Fin.castSucc d4) = X.c' (Fin.castSucc d2)) : False := by
  have hs := (star_iff 5 X.c).1 X.hc
  have h2' := addEdge_joins_old (u := X.L.u) (w := X.L.w) |>.2 h2
  have h3' := addEdge_joins_old (u := X.L.u) (w := X.L.w) |>.2 h3
  have h4' := addEdge_joins_old (u := X.L.u) (w := X.L.w) |>.2 h4
  have pvold : X.S.IsOld pv := by
    rcases hv with ⟨_, _, rfl, _⟩ | ⟨_, _, rfl, _⟩
    · exact pp_old X.S i
    · exact pq_old X.S i
  have o2' : X.S.IsOld (Fin.castSucc d2) := hd2 ▸ pvold
  have c2ne : X.c' (Fin.castSucc d2) ≠ Fin.last 5 := by
    rw [X.hC.hold _ (inSupp o2) o2']; exact castSucc_ne_last _
  have ns3 : ∀ j, Fin.castSucc d3 ≠ X.S.e6 j := by
    intro j e
    rw [e, X.hC.h6 j] at hb3
    exact castSucc_ne_last _ hb3.symm
  have ns4 : ∀ j, Fin.castSucc d4 ≠ X.S.e6 j := by
    intro j e
    rw [e, X.hC.h6 j] at hb4
    exact c2ne hb4.symm
  -- d3 is not a twin edge
  have nt3 : ∀ j, Fin.castSucc d3 ≠ X.S.ey j := by
    intro j e
    have hj3 := h3'
    rw [e] at hj3
    have hor := digon_orient j hj3 (X.S.jy j)
    have d2n : Fin.castSucc d2 ≠ X.S.e6 j ∧ Fin.castSucc d2 ≠ X.S.ey j := by
      rw [hd2]
      rcases hv with ⟨_, _, rfl, _⟩ | ⟨_, _, rfl, _⟩
      · exact X.S.ppOld i j
      · exact X.S.pqOld i j
    have d4y : Fin.castSucc d4 ≠ X.S.ey j := by
      intro e'
      have hj4 := h4'
      rw [e'] at hj4
      have hor4 := digon_orient j hj4 (X.S.jy j)
      rcases hor with ⟨a1, a2⟩ | ⟨a1, a2⟩ <;> rcases hor4 with ⟨b1, b2⟩ | ⟨b1, b2⟩
      · exact X.S.hpq j (a2.symm.trans b1).symm
      · exact hv'z4 (a1.trans b2.symm)
      · exact hv'z4 (a1.trans b2.symm)
      · exact X.S.hpq j (b1.symm.trans a2).symm
    exact port_colour_ne X.hc X.hC j hor (inSupp o2) (inSupp o4) (joins_inc_right h2') (joins_inc_left h4')
      d2n.1 d2n.2 (ns4 j) d4y hb4.symm
  have o3' : X.S.IsOld (Fin.castSucc d3) := fun j => ⟨ns3 j, nt3 j⟩
  obtain ⟨τ4, z', hτ4, hc4, hz'⟩ := lift_end X.hc X.hC (inSupp o4) (jsymm h4') ns4
  have j2 := X.S.oldJ _ v v' (inSupp o2) o2' h2'
  have j3 := X.S.oldJ _ v' z3 (inSupp o3) o3' h3'
  have hvv' : v ≠ v' := joins_ne' X.L.hloop h2
  apply hs.2 ⟨σ0, X.S.φ v, X.S.φ v', X.S.φ z3, z', τ0, X.S.old (Fin.castSucc d2), X.S.old (Fin.castSucc d3), τ4,
    hτ0, j2, j3, jsymm hτ4, hσ0 v, hσ0 v', hσ0 z3, phi_ne hvv', phi_ne hvz3,
    fun e => lift_ne hz' (Ne.symm hvz4) e.symm, phi_ne hv'z3,
    fun e => lift_ne hz' (Ne.symm hv'z4) e.symm, fun e => lift_ne hz' (Ne.symm hz34) e.symm⟩
  constructor
  · apply castSucc_inj'
    show Fin.castSucc (X.c τ0) = Fin.castSucc (X.c (X.S.old (Fin.castSucc d3)))
    rw [← X.hC.hold _ (inSupp o3) o3', hb3]
  · apply castSucc_inj'
    show Fin.castSucc (X.c (X.S.old (Fin.castSucc d2))) = Fin.castSucc (X.c τ4)
    rw [hc4, ← X.hC.hold _ (inSupp o2) o2', hb4]

/-- in Case dig (`g` = six-edge of digon `i`), the old edges at a vertex `v` of the digon are the twin edge and the
    port edge `pv` -/
theorem dig_old_at (i : Fin k) (hg : X.S.e6 i = Fin.last G.m) {v vs : Fin G.n}
    {pv pvs : Fin (addEdge G X.L.u X.L.w).m}
    (hv : (v = X.S.p i ∧ vs = X.S.q i ∧ pv = X.S.pp i ∧ pvs = X.S.pq i) ∨
      (v = X.S.q i ∧ vs = X.S.p i ∧ pv = X.S.pq i ∧ pvs = X.S.pp i))
    {d : Fin G.m} (od : X.L.O d) (hd : G.Inc d v) : Fin.castSucc d = X.S.ey i ∨ Fin.castSucc d = pv := by
  have hi : (addEdge G X.L.u X.L.w).Inc (Fin.castSucc d) v := addEdge_inc_old.2 hd
  rcases hv with ⟨rfl, _, rfl, _⟩ | ⟨rfl, _, rfl, _⟩
  · rcases X.S.incp i _ (inSupp od) hi with e | e | e
    · rw [hg] at e; exact absurd e (castSucc_ne_last' d)
    · exact Or.inl e
    · exact Or.inr e
  · rcases X.S.incq i _ (inSupp od) hi with e | e | e
    · rw [hg] at e; exact absurd e (castSucc_ne_last' d)
    · exact Or.inl e
    · exact Or.inr e

/-- the E-condition at a digon vertex `v` for the colour κ of the edge x v -/
theorem dig_E (i : Fin k) (hg : X.S.e6 i = Fin.last G.m) {v vs : Fin G.n}
    {pv pvs : Fin (addEdge G X.L.u X.L.w).m}
    (hv : (v = X.S.p i ∧ vs = X.S.q i ∧ pv = X.S.pp i ∧ pvs = X.S.pq i) ∨
      (v = X.S.q i ∧ vs = X.S.p i ∧ pv = X.S.pq i ∧ pvs = X.S.pp i))
    {κ : Fin 6} (hk : κ ≠ X.c' pvs)
    (hcopy : κ = Fin.last 5 ∨ ∃ τ0 σ0, H.Joins τ0 σ0 (X.S.φ v) ∧ (∀ t, σ0 ≠ X.S.φ t) ∧ Fin.castSucc (X.c τ0) = κ) :
    ∀ z2 z3 z4 d2 d3 d4, X.L.O d2 → X.L.O d3 → X.L.O d4 →
      G.Joins d2 v z2 → G.Joins d3 z2 z3 → G.Joins d4 z3 z4 →
      v ≠ z2 → v ≠ z3 → z2 ≠ z3 → v ≠ z4 → z2 ≠ z4 → z3 ≠ z4 →
      ¬ (X.c' (Fin.castSucc d3) = κ ∧ X.c' (Fin.castSucc d4) = X.c' (Fin.castSucc d2)) := by
  rintro z2 z3 z4 d2 d3 d4 o2 o3 o4 h2 h3 h4 _ n13 n23 n14 n24 n34 ⟨hb3, hb4⟩
  have pr := pair_of X i hv
  rcases dig_old_at X i hg hv o2 (joins_inc_left h2) with e | e
  · -- d2 is the twin edge: z2 = vs and d3 is the port edge at vs
    have hz2 : z2 = vs := dig_other X i pr (Or.inr e) (addEdge_joins_old.2 h2)
    subst hz2
    rcases inc_vs X i hv (inSupp o3) (addEdge_inc_old.2 (joins_inc_left h3)) with e3 | e3 | e3
    · exact n13 (dig_other X i (swap_pair X i pr) (Or.inl e3) (addEdge_joins_old.2 h3)).symm
    · exact n13 (dig_other X i (swap_pair X i pr) (Or.inr e3) (addEdge_joins_old.2 h3)).symm
    · rw [e3] at hb3; exact hk hb3.symm
  · rcases hcopy with h6 | ⟨τ0, σ0, hτ0, hσ0, hcτ⟩
    · rw [h6] at hb3
      exact six_path X o2 o3 o4 h2 h3 h4 n13 n24 hb3 hb4
    · exact lemmaP X i hv hτ0 hσ0 o2 o3 o4 h2 h3 h4 e n13 n14 n23 n24 n34 (hb3.trans hcτ.symm) hb4

theorem dig_col (i : Fin k) (hg : X.S.e6 i = Fin.last G.m) {v vs : Fin G.n}
    {pv pvs : Fin (addEdge G X.L.u X.L.w).m}
    (hv : (v = X.S.p i ∧ vs = X.S.q i ∧ pv = X.S.pp i ∧ pvs = X.S.pq i) ∨
      (v = X.S.q i ∧ vs = X.S.p i ∧ pv = X.S.pq i ∧ pvs = X.S.pp i))
    {d : Fin G.m} (od : X.L.O d) (hd : G.Inc d v) :
    X.c' (Fin.castSucc d) = X.c' (X.S.ey i) ∨ X.c' (Fin.castSucc d) = X.c' pv := by
  rcases dig_old_at X i hg hv od hd with e | e <;> rw [e]
  · exact Or.inl rfl
  · exact Or.inr rfl

end

/-- **Case dig, generic recipe**: `g` is the six-edge of digon `i` = {u, w}; `pu`, `pw` are the port edges at `u`,
    `w`; colours κu (edge x u), κw (edge x w), lam (edge x ℓ) satisfying the listed colour conditions. -/
theorem dig_recipe (X : LeafPi G H Q k) (i : Fin k) (hg : X.S.e6 i = Fin.last G.m)
    (pu pw : Fin (addEdge G X.L.u X.L.w).m)
    (hu : (X.L.u = X.S.p i ∧ X.L.w = X.S.q i ∧ pu = X.S.pp i ∧ pw = X.S.pq i) ∨
      (X.L.u = X.S.q i ∧ X.L.w = X.S.p i ∧ pu = X.S.pq i ∧ pw = X.S.pp i))
    (κu κw lam : Fin 6) (a1 : κu ≠ κw) (a2 : κu ≠ lam) (a3 : κw ≠ lam)
    (bu : κu ≠ X.c' (X.S.ey i) ∧ κu ≠ X.c' pu) (bw : κw ≠ X.c' (X.S.ey i) ∧ κw ≠ X.c' pw)
    (cu : κu ≠ X.c' pw) (cw : κw ≠ X.c' pu)
    (eu : κu = Fin.last 5 ∨ ∃ τ0 σ0, H.Joins τ0 σ0 (X.S.φ X.L.u) ∧ (∀ t, σ0 ≠ X.S.φ t) ∧ Fin.castSucc (X.c τ0) = κu)
    (ew : κw = Fin.last 5 ∨ ∃ τ0 σ0, H.Joins τ0 σ0 (X.S.φ X.L.w) ∧ (∀ t, σ0 ≠ X.S.φ t) ∧ Fin.castSucc (X.c τ0) = κw)
    (dl : lam ≠ X.c' (X.S.ey i) ∧ lam ≠ X.c' pu ∧ lam ≠ X.c' pw) :
    ∃ c₀ : Fin G.m → Fin 6, StarOn Q 6 c₀ := by
  have hw : (X.L.w = X.S.p i ∧ X.L.u = X.S.q i ∧ pw = X.S.pp i ∧ pu = X.S.pq i) ∨
      (X.L.w = X.S.q i ∧ X.L.u = X.S.p i ∧ pw = X.S.pq i ∧ pu = X.S.pp i) := by
    rcases hu with ⟨a, b, c, d⟩ | ⟨a, b, c, d⟩
    · exact Or.inr ⟨b, a, d, c⟩
    · exact Or.inl ⟨b, a, d, c⟩
  refine ⟨leafCol X.L X.c' κu κw lam, claimW X.L X.c' κu κw lam ⟨starK X, a1, a2, a3, ?pS, ?pT,
    dig_E X i hg hu cu eu, dig_E X i hg hw cw ew, ?LS, ?LT, ?MST, ?MTS, ?CC⟩⟩
  case pS =>
    intro d od hd e
    rcases dig_col X i hg hu od hd with h | h <;> rw [h] at e
    · exact bu.1 e.symm
    · exact bu.2 e.symm
  case pT =>
    intro d od hd e
    rcases dig_col X i hg hw od hd with h | h <;> rw [h] at e
    · exact bw.1 e.symm
    · exact bw.2 e.symm
  case LS =>
    rintro z3 z4 d3 d4 o3 o4 h3 h4 _ _ _ ⟨hb3, _⟩
    rcases dig_col X i hg hu o3 (joins_inc_left h3) with h | h <;> rw [h] at hb3
    · exact dl.1 hb3.symm
    · exact dl.2.1 hb3.symm
  case LT =>
    rintro z3 z4 d3 d4 o3 o4 h3 h4 _ _ _ ⟨hb3, _⟩
    rcases dig_col X i hg hw o3 (joins_inc_left h3) with h | h <;> rw [h] at hb3
    · exact dl.1 hb3.symm
    · exact dl.2.2 hb3.symm
  case MST =>
    rintro z3 z4 d3 d4 o3 o4 h3 h4 _ _ _ _ ⟨hb3, _⟩
    rcases dig_col X i hg hw o3 (joins_inc_left h3) with h | h <;> rw [h] at hb3
    · exact bu.1 hb3.symm
    · exact cu hb3.symm
  case MTS =>
    rintro z3 z4 d3 d4 o3 o4 h3 h4 _ _ _ _ ⟨hb3, _⟩
    rcases dig_col X i hg hu o3 (joins_inc_left h3) with h | h <;> rw [h] at hb3
    · exact bw.1 hb3.symm
    · exact cw hb3.symm
  case CC =>
    rintro z0 z4 d1 d4 o1 o4 h1 h4 _ _ _ _ ⟨hb1, _⟩
    rcases dig_col X i hg hu o1 (joins_inc_right h1) with h | h <;> rw [h] at hb1
    · exact bw.1 hb1.symm
    · exact cw hb1.symm


/-- Case dig in terms of the Π-sides A = φ(p i), B = φ(q i): colours κA (edge from x to the vertex p i) and κB (to
    q i); the orientation of {u, w} = {p i, q i} is resolved here. -/
theorem dig_AB (X : LeafPi G H Q k) (i : Fin k) (hg : X.S.e6 i = Fin.last G.m) (κA κB lam : Fin 6)
    (aAB : κA ≠ κB) (aAL : κA ≠ lam) (aBL : κB ≠ lam)
    (bA : κA ≠ X.c' (X.S.ey i) ∧ κA ≠ X.c' (X.S.pp i)) (bB : κB ≠ X.c' (X.S.ey i) ∧ κB ≠ X.c' (X.S.pq i))
    (cA : κA ≠ X.c' (X.S.pq i)) (cB : κB ≠ X.c' (X.S.pp i))
    (eA : κA = Fin.last 5 ∨ ∃ τ0 σ0, H.Joins τ0 σ0 (X.S.φ (X.S.p i)) ∧ (∀ t, σ0 ≠ X.S.φ t) ∧
      Fin.castSucc (X.c τ0) = κA)
    (eB : κB = Fin.last 5 ∨ ∃ τ0 σ0, H.Joins τ0 σ0 (X.S.φ (X.S.q i)) ∧ (∀ t, σ0 ≠ X.S.φ t) ∧
      Fin.castSucc (X.c τ0) = κB)
    (dl : lam ≠ X.c' (X.S.ey i) ∧ lam ≠ X.c' (X.S.pp i) ∧ lam ≠ X.c' (X.S.pq i)) :
    ∃ c₀ : Fin G.m → Fin 6, StarOn Q 6 c₀ := by
  have J := X.S.j6 i
  rw [hg] at J
  have conv : ∀ {v v' : Fin G.n} {κ : Fin 6}, v = v' →
      (κ = Fin.last 5 ∨ ∃ τ0 σ0, H.Joins τ0 σ0 (X.S.φ v') ∧ (∀ t, σ0 ≠ X.S.φ t) ∧ Fin.castSucc (X.c τ0) = κ) →
      (κ = Fin.last 5 ∨ ∃ τ0 σ0, H.Joins τ0 σ0 (X.S.φ v) ∧ (∀ t, σ0 ≠ X.S.φ t) ∧ Fin.castSucc (X.c τ0) = κ) := by
    intro v v' κ hvv h
    rcases h with h | ⟨τ0, σ0, hj, hn, hc⟩
    · exact Or.inl h
    · refine Or.inr ⟨τ0, σ0, ?_, hn, hc⟩
      rw [show X.S.φ v = X.S.φ v' from congrArg X.S.φ hvv]
      exact hj
  rcases joins_unique (addEdge_joins_new (G := G) (u := X.L.u) (w := X.L.w)) J with ⟨hup, hwq⟩ | ⟨huq, hwp⟩
  · exact dig_recipe X i hg (X.S.pp i) (X.S.pq i) (Or.inl ⟨hup, hwq, rfl, rfl⟩) κA κB lam aAB aAL aBL bA bB cA cB
      (conv hup eA) (conv hwq eB) dl
  · exact dig_recipe X i hg (X.S.pq i) (X.S.pp i) (Or.inr ⟨huq, hwp, rfl, rfl⟩) κB κA lam (Ne.symm aAB) aBL aAL
      bB bA cB cA (conv huq eB) (conv hwp eA) ⟨dl.1, dl.2.2, dl.2.1⟩

/-- **Case dig** of Step 4 of fact b22aa11289e61f4c: `g` is the six-edge of digon `i`. -/
theorem case_dig (X : LeafPi G H Q k) (i : Fin k) (hg : X.S.e6 i = Fin.last G.m) :
    ∃ c₀ : Fin G.m → Fin 6, StarOn Q 6 c₀ := by
  have hs := (star_iff 5 X.c).1 X.hc
  have csne : ∀ {x y : Fin 5}, x ≠ y → Fin.castSucc x ≠ Fin.castSucc y := fun h e => h (castSucc_inj' e)
  have lcs : ∀ x : Fin 5, Fin.last 5 ≠ Fin.castSucc x := fun x e => castSucc_ne_last x e.symm
  have pAB : X.c (X.S.copy i).eAC ≠ X.c (X.S.copy i).eBC :=
    hs.1 _ _ (PiRigidLean.adjOf (jsymm (X.S.copy i).jAC) (jsymm (X.S.copy i).jBC) (X.S.copy i).dAB
