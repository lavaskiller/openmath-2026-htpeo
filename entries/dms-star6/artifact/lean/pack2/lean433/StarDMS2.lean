variable {X Y : MGraph} {P : Fin X.m → Prop} {P' : Fin Y.m → Prop} (E : EmbOn X Y P P')

theorem EmbOn.joins {e : Fin X.m} (he : P e) {x y : Fin X.n} (h : X.Joins e x y) : Y.Joins (E.ψ e) (E.φ x) (E.φ y) := by
  unfold Joins at h ⊢
  rw [E.ends e he]
  rcases h with h | h <;> rw [h]
  · exact Or.inl rfl
  · exact Or.inr rfl

theorem EmbOn.inc {e : Fin X.m} (he : P e) {x : Fin X.n} (h : X.Inc e x) : Y.Inc (E.ψ e) (E.φ x) := by
  unfold Inc at h ⊢
  rw [E.ends e he]
  rcases h with h | h <;> rw [h]
  · exact Or.inl rfl
  · exact Or.inr rfl

theorem EmbOn.inc_back {e : Fin X.m} (he : P e) {v : Fin Y.n} (h : Y.Inc (E.ψ e) v) : ∃ x, v = E.φ x ∧ X.Inc e x := by
  unfold Inc at h
  rw [E.ends e he] at h
  rcases h with h | h
  · exact ⟨_, h.symm, Or.inl rfl⟩
  · exact ⟨_, h.symm, Or.inr rfl⟩

theorem EmbOn.inc_iff {e : Fin X.m} (he : P e) {x : Fin X.n} : Y.Inc (E.ψ e) (E.φ x) ↔ X.Inc e x := by
  refine ⟨fun h => ?_, E.inc he⟩
  obtain ⟨x', hx', hi⟩ := E.inc_back he h
  rw [E.φinj _ _ hx']; exact hi

