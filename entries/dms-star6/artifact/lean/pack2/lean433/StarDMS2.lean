    (∀ e u f f', C.isCut e → X.Inc e u → f ≠ e → f' ≠ e → P f → ¬ C.glueN NA NB False f → X.Inc f u → P f' →
      ¬ C.glueN NA NB False f' → X.Inc f' u → f = f') := by
