    have hNf : N (C.oD f) := (hc.2 _ ((C.cloD_old_iff).2 (Or.inl hf))).2 h
    have := C.oD_inj (pm_unique hN hNf hNe ((C.XD_inc_old).2 hfa) ((C.XD_inc_old).2 (joins_inc_left hj)))
    exact C.not_inA_of_cut (this ▸ he) hf
