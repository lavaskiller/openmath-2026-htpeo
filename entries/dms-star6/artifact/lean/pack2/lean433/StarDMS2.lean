section Module_MhFact_3a172a440dfeed42
-- Lean proof of fact 3a172a440dfeed42 (PiSubOnLean.pi_subst_on); added by fact_submit, do not edit
/-
  PiSubOn.lean — the replacement lemma (A) of fact 85bb5f970f208c0b for an EDGE SET `P` of an ambient multigraph
  `G` (generalising theorem PiSubLean.pi_subst of fact d9fbe3906514b798, which is the case P = all edges).
  All hypotheses about `G` are restricted to `P`-edges, and the conclusion is `StarOn P 6 c'`.
  Main theorem: `PiSubOnLean.pi_subst_on`.
-/

namespace PiSubOnLean
open MGraph PiRigidLean

variable {G H : MGraph}

/-! ### the relational description of `G^Π(𝒟)` -/

structure PiSubstOn (G H : MGraph) (P : Fin G.m → Prop) (k : Nat) where
  φ : Fin G.n → Fin H.n
  φinj : ∀ x y, φ x = φ y → x = y
  p : Fin k → Fin G.n
  q : Fin k → Fin G.n
  e6 : Fin k → Fin G.m
  ey : Fin k → Fin G.m
  pp : Fin k → Fin G.m
  pq : Fin k → Fin G.m
  hpq : ∀ i, p i ≠ q i
  j6 : ∀ i, G.Joins (e6 i) (p i) (q i)
  P6 : ∀ i, P (e6 i)
  Py : ∀ i, P (ey i)
  Ppp : ∀ i, P (pp i)
  Ppq : ∀ i, P (pq i)
  jy : ∀ i, G.Joins (ey i) (p i) (q i)
  incp : ∀ i f, P f → G.Inc f (p i) → f = e6 i ∨ f = ey i ∨ f = pp i
  incq : ∀ i f, P f → G.Inc f (q i) → f = e6 i ∨ f = ey i ∨ f = pq i
  disj : ∀ i j, i ≠ j → p i ≠ p j ∧ p i ≠ q j ∧ q i ≠ p j ∧ q i ≠ q j
  ppOld : ∀ i j, pp i ≠ e6 j ∧ pp i ≠ ey j
  pqOld : ∀ i j, pq i ≠ e6 j ∧ pq i ≠ ey j
  old : Fin G.m → Fin H.m
  oldJ : ∀ f x y, P f → (∀ i, f ≠ e6 i ∧ f ≠ ey i) → G.Joins f x y → H.Joins (old f) (φ x) (φ y)
  oldInj : ∀ f g, P f → P g → (∀ i, f ≠ e6 i ∧ f ≠ ey i) → (∀ i, g ≠ e6 i ∧ g ≠ ey i) → old f = old g → f = g
  copy : Fin k → PiCopy H
  cA : ∀ i, (copy i).A = φ (p i)
  cB : ∀ i, (copy i).B = φ (q i)
  cAu : ∀ i, (copy i).eAu = old (pp i)
  cBv : ∀ i, (copy i).eBv = old (pq i)
  newC : ∀ i x, (copy i).C ≠ φ x
  newY : ∀ i x, (copy i).Y ≠ φ x
  newZ : ∀ i x, (copy i).Z ≠ φ x

variable {P : Fin G.m → Prop} {k : Nat}

/-- an edge of `G` that is not a digon edge of `𝒟` -/
def PiSubstOn.IsOld (S : PiSubstOn G H P k) (f : Fin G.m) : Prop := ∀ i, f ≠ S.e6 i ∧ f ≠ S.ey i

/-- the colouring `c'` of (A): colour 6 (`Fin.last 5`) on `e6 i`, the twin colour on `ey i`, `c ∘ old` elsewhere -/
structure SubColourOn (S : PiSubstOn G H P k) (c : Fin H.m → Fin 5) (c' : Fin G.m → Fin 6) : Prop where
  h6 : ∀ i, c' (S.e6 i) = Fin.last 5
  hy : ∀ i, c' (S.ey i) = Fin.castSucc (twin (S.copy i) c)
  hold : ∀ f, P f → S.IsOld f → c' f = Fin.castSucc (c (S.old f))

variable {S : PiSubstOn G H P k} {c : Fin H.m → Fin 5} {c' : Fin G.m → Fin 6}

theorem six_of_last (hC : SubColourOn S c c') {f : Fin G.m} (hP : P f) (h : c' f = Fin.last 5) : ∃ i, f = S.e6 i := by
  apply Classical.byContradiction
  intro hno
  rcases Classical.em (∃ i, f = S.ey i) with ⟨i, hi⟩ | hy
  · rw [hi, hC.hy i] at h
    exact castSucc_ne_last _ h
  · have hold : S.IsOld f := fun i => ⟨fun e => hno ⟨i, e⟩, fun e => hy ⟨i, e⟩⟩
    rw [hC.hold f hP hold] at h
    exact castSucc_ne_last _ h

theorem pp_old (S : PiSubstOn G H P k) (i : Fin k) : S.IsOld (S.pp i) := fun j => S.ppOld i j
theorem pq_old (S : PiSubstOn G H P k) (i : Fin k) : S.IsOld (S.pq i) := fun j => S.pqOld i j

/-- the two port edges of a digon have different `c'`-colours -/
theorem port_colour_ne (hc : H.Star 5 c) (hC : SubColourOn S c c') (j : Fin k) {x y : Fin G.n}
    (hxy : (x = S.p j ∧ y = S.q j) ∨ (x = S.q j ∧ y = S.p j)) {f g : Fin G.m}
    (pf : P f) (pg : P g) (hf : G.Inc f x) (hg : G.Inc g y) (hf6 : f ≠ S.e6 j) (hfy : f ≠ S.ey j)
    (hg6 : g ≠ S.e6 j) (hgy : g ≠ S.ey j) : c' f ≠ c' g := by
  have hpn := PiSubLean.port_ne (pi_rigidity (S.copy j) c hc)
  rw [S.cAu, S.cBv] at hpn
  rcases hxy with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · have hf' : f = S.pp j := by
      rcases S.incp j f pf hf with h | h | h
      · exact absurd h hf6
      · exact absurd h hfy
      · exact h
    have hg' : g = S.pq j := by
      rcases S.incq j g pg hg with h | h | h
      · exact absurd h hg6
      · exact absurd h hgy
      · exact h
    rw [hf', hg', hC.hold _ (S.Ppp j) (pp_old S j), hC.hold _ (S.Ppq j) (pq_old S j)]
    intro h
    exact hpn (castSucc_inj' h)
  · have hf' : f = S.pq j := by
      rcases S.incq j f pf hf with h | h | h
      · exact absurd h hf6
      · exact absurd h hfy
      · exact h
    have hg' : g = S.pp j := by
      rcases S.incp j g pg hg with h | h | h
      · exact absurd h hg6
      · exact absurd h hgy
      · exact h
    rw [hf', hg', hC.hold _ (S.Ppq j) (pq_old S j), hC.hold _ (S.Ppp j) (pp_old S j)]
    intro h
    exact hpn (castSucc_inj' h).symm

/-- orientation of an edge joining the two vertices of digon `j` -/
theorem digon_orient {f : Fin G.m} {x y : Fin G.n} (j : Fin k) (hf : G.Joins f x y)
    (hd : G.Joins f (S.p j) (S.q j)) : (x = S.p j ∧ y = S.q j) ∨ (x = S.q j ∧ y = S.p j) := by
  rcases joins_unique hf hd with ⟨a, b⟩ | ⟨a, b⟩
  · exact Or.inl ⟨a, b⟩
  · exact Or.inr ⟨a, b⟩

/-- Step 1 core: in a bicoloured walk, the third edge is not a six-edge -/
theorem no_six_third (hc : H.Star 5 c) (hC : SubColourOn S c c') {a1 a2 a3 a4 : Fin G.n} {f2 f3 f4 : Fin G.m}
    (p2 : P f2) (p4 : P f4) (h2 : G.Joins f2 a1 a2) (h3 : G.Joins f3 a2 a3) (h4 : G.Joins f4 a3 a4)
    (d13 : a1 ≠ a3) (d24 : a2 ≠ a4) (n23 : f2 ≠ f3) (n34 : f3 ≠ f4)
    (hb : c' f2 = c' f4) (j : Fin k) (h6 : f3 = S.e6 j) : False := by
  rw [h6] at h3 n23 n34
  have hor := digon_orient j h3 (S.j6 j)
  have hpq := S.hpq j
  have hf2y : f2 ≠ S.ey j := by
    intro e
    rw [e] at h2
    have h2o := digon_orient j h2 (S.jy j)
    rcases hor with ⟨e2, e3⟩ | ⟨e2, e3⟩ <;> rcases h2o with ⟨e1, e2'⟩ | ⟨e1, e2'⟩
    · exact hpq (e2.symm.trans e2')
    · exact d13 (e1.trans e3.symm)
    · exact d13 (e1.trans e3.symm)
    · exact hpq (e2'.symm.trans e2)
  have hf4y : f4 ≠ S.ey j := by
    intro e
    rw [e] at h4
    have h4o := digon_orient j h4 (S.jy j)
    rcases hor with ⟨e2, e3⟩ | ⟨e2, e3⟩ <;> rcases h4o with ⟨e3', e4⟩ | ⟨e3', e4⟩
    · exact hpq (e3'.symm.trans e3)
    · exact d24 (e2.trans e4.symm)
    · exact d24 (e2.trans e4.symm)
    · exact hpq (e3.symm.trans e3')
  exact port_colour_ne hc hC j hor p2 p4 (joins_inc_right h2) (joins_inc_left h4) n23 hf2y (Ne.symm n34) hf4y hb

/-- Step 2 core: in a bicoloured walk without six-edges, the second edge is not a twin edge -/
theorem no_twin_second (hc : H.Star 5 c) (hC : SubColourOn S c c') {a0 a1 a2 a3 : Fin G.n} {f1 f2 f3 : Fin G.m}
    (p1 : P f1) (p3 : P f3) (h1 : G.Joins f1 a0 a1) (h2 : G.Joins f2 a1 a2) (h3 : G.Joins f3 a2 a3)
    (n12 : f1 ≠ f2) (n23 : f2 ≠ f3) (ns1 : ∀ i, f1 ≠ S.e6 i) (ns3 : ∀ i, f3 ≠ S.e6 i)
    (hb : c' f1 = c' f3) (i : Fin k) (hy : f2 = S.ey i) : False := by
  rw [hy] at h2 n12 n23
  have hor := digon_orient i h2 (S.jy i)
  exact port_colour_ne hc hC i hor p1 p3 (joins_inc_right h1) (joins_inc_left h3) (ns1 i) n12 (ns3 i) (Ne.symm n23) hb

