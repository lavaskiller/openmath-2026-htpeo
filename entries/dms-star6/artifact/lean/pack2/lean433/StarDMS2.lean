    (∀ (X : MGraph) (P M : Fin X.m → Prop) (C : Cut2 P), PMOn P M → M C.e1 → M C.e2 →
      PMOn C.clo (C.cloN M True)) ∧
    (∀ (X : MGraph) (P M : Fin X.m → Prop), Loopless X → CubicOn P → PMOn P M → ∀ C : Cut2 P,
