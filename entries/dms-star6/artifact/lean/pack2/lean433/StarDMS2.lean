theorem iso_seven_false {G H : MGraph} {P : Fin G.m → Prop} (hiso : IsoTo H P) (hn : H.n = 6)
    (v : Fin 7 → Fin G.n) (hv : ∀ i j, v i = v j → i = j) (hinc : ∀ i, ∃ e, P e ∧ G.Inc e (v i)) : False := by
  obtain ⟨φ, ψ, _, _, hj, hP⟩ := hiso
