theorem jsymm {f : Fin G.m} {x y : Fin G.n} (h : G.Joins f x y) : G.Joins f y x := Or.symm h

/-- the other end of an edge at `v` is determined -/
theorem other_end {f : Fin G.m} {v x x' : Fin G.n} (h : G.Joins f v x) (h' : G.Joins f v x') (hvx : v ≠ x) :
    x' = x := by
  rcases joins_unique h h' with ⟨_, e⟩ | ⟨_, e⟩
  · exact e.symm
  · exact absurd e.symm hvx

theorem joins_ne' (hloop : Loopless G) {f : Fin G.m} {x y : Fin G.n} (h : G.Joins f x y) : x ≠ y := by
  intro hxy
  apply hloop f
  rcases h with h | h <;> rw [h, hxy]

