theorem kwalk (C : LeafConds L c2 σ τ lam) {v0 v1 v2 v3 v4 : Fin G.n} {e1 e2 e3 e4 : Fin G.m}
    (o1 : L.O e1) (o2 : L.O e2) (o3 : L.O e3) (o4 : L.O e4)
    (h1 : G.Joins e1 v0 v1) (h2 : G.Joins e2 v1 v2) (h3 : G.Joins e3 v2 v3) (h4 : G.Joins e4 v3 v4)
    (d01 : v0 ≠ v1) (d02 : v0 ≠ v2) (d03 : v0 ≠ v3) (d12 : v1 ≠ v2) (d13 : v1 ≠ v3) (d14 : v1 ≠ v4)
    (d23 : v2 ≠ v3) (d24 : v2 ≠ v4) (d34 : v3 ≠ v4)
    (hb1 : c2 (Fin.castSucc e1) = c2 (Fin.castSucc e3)) (hb2 : c2 (Fin.castSucc e2) = c2 (Fin.castSucc e4)) :
    False := by
  let w2 : (addEdge G L.u L.w).Walk4 :=
    { v0 := v0, v1 := v1, v2 := v2, v3 := v3, v4 := v4
      e1 := Fin.castSucc e1, e2 := Fin.castSucc e2, e3 := Fin.castSucc e3, e4 := Fin.castSucc e4
      h1 := addEdge_joins_old.2 h1, h2 := addEdge_joins_old.2 h2
      h3 := addEdge_joins_old.2 h3, h4 := addEdge_joins_old.2 h4
      d01 := d01, d02 := d02, d03 := d03, d12 := d12, d13 := d13, d14 := d14, d23 := d23, d24 := d24, d34 := d34 }
  exact C.star.2 w2 (inSupp o1) (inSupp o2) (inSupp o3) (inSupp o4) ⟨hb1, hb2⟩

/-- walks with `v0 = y` -/
theorem caseV0 (C : LeafConds L c2 σ τ lam) {v1 v2 v3 v4 : Fin G.n} {e1 e2 e3 e4 : Fin G.m}
    (q1 : Q e1) (q2 : Q e2) (q3 : Q e3) (q4 : Q e4)
    (h1 : G.Joins e1 L.y v1) (h2 : G.Joins e2 v1 v2) (h3 : G.Joins e3 v2 v3) (h4 : G.Joins e4 v3 v4)
    (d01 : L.y ≠ v1) (d02 : L.y ≠ v2) (d03 : L.y ≠ v3) (d12 : v1 ≠ v2) (d13 : v1 ≠ v3) (d14 : v1 ≠ v4)
    (d23 : v2 ≠ v3) (d24 : v2 ≠ v4) (d34 : v3 ≠ v4)
    (n12 : e1 ≠ e2) (n34 : e3 ≠ e4)
    (hb1 : leafCol L c2 σ τ lam e1 = leafCol L c2 σ τ lam e3)
    (hb2 : leafCol L c2 σ τ lam e2 = leafCol L c2 σ τ lam e4) : False := by
  have o2 : L.O e2 := oldOf q2 h2 (Ne.symm d01) (Ne.symm d02)
  have o3 : L.O e3 := oldOf q3 h3 (Ne.symm d02) (Ne.symm d03)
  rw [colO o2] at hb2
  rw [colO o3] at hb1
  rcases atY q1 h1 with ⟨he, hv⟩ | ⟨he, hv⟩ | ⟨he, hv⟩
  · -- e1 = f1, v1 = u
    subst hv
    rw [he, col1] at hb1
    by_cases hv4 : v4 = L.y
    · -- a 4-cycle y u v2 v3 y: e4 = f2, v3 = w
      subst hv4
      rcases atY q4 (jsymm h4) with ⟨he4, hv3⟩ | ⟨he4, hv3⟩ | ⟨he4, hv3⟩
      · exact d13 hv3.symm
      · subst hv3
        rw [he4, col2] at hb2
        exact C.MST v2 L.u e3 e2 o3 o2 (jsymm h3) (jsymm h2) d12 (Ne.symm d23) (Ne.symm L.huw) (Ne.symm d12)
          ⟨hb1.symm, hb2⟩
      · -- v3 = l: e3 is a second edge at the leaf
        exact n34 (leaf_two q3 q4 (hv3 ▸ joins_inc_right h3) (hv3 ▸ joins_inc_left h4))
    · have o4 : L.O e4 := oldOf q4 h4 (Ne.symm d03) hv4
      rw [colO o4] at hb2
      exact C.ES v2 v3 v4 e2 e3 e4 o2 o3 o4 h2 h3 h4 d12 d13 d23 d14 d24 d34 ⟨hb1.symm, hb2.symm⟩
  · -- e1 = f2, v1 = w
    subst hv
    rw [he, col2] at hb1
    by_cases hv4 : v4 = L.y
    · subst hv4
      rcases atY q4 (jsymm h4) with ⟨he4, hv3⟩ | ⟨he4, hv3⟩ | ⟨he4, hv3⟩
      · subst hv3
        rw [he4, col1] at hb2
        exact C.MTS v2 L.w e3 e2 o3 o2 (jsymm h3) (jsymm h2) d12 (Ne.symm d23) L.huw (Ne.symm d12)
          ⟨hb1.symm, hb2⟩
      · exact d13 hv3.symm
      · exact n34 (leaf_two q3 q4 (hv3 ▸ joins_inc_right h3) (hv3 ▸ joins_inc_left h4))
    · have o4 : L.O e4 := oldOf q4 h4 (Ne.symm d03) hv4
      rw [colO o4] at hb2
      exact C.ET v2 v3 v4 e2 e3 e4 o2 o3 o4 h2 h3 h4 d12 d13 d23 d14 d24 d34 ⟨hb1.symm, hb2.symm⟩
  · -- e1 = f3, v1 = l: e2 is a second edge at the leaf
    subst hv
    exact n12 (leaf_two q1 q2 (joins_inc_right h1) (joins_inc_left h2))

/-- walks with `v1 = y` -/
theorem caseV1 (C : LeafConds L c2 σ τ lam) {v0 v2 v3 v4 : Fin G.n} {e1 e2 e3 e4 : Fin G.m}
    (q1 : Q e1) (q2 : Q e2) (q3 : Q e3) (q4 : Q e4)
    (h1 : G.Joins e1 v0 L.y) (h2 : G.Joins e2 L.y v2) (h3 : G.Joins e3 v2 v3) (h4 : G.Joins e4 v3 v4)
    (d01 : v0 ≠ L.y) (d02 : v0 ≠ v2) (d03 : v0 ≠ v3) (d12 : L.y ≠ v2) (d13 : L.y ≠ v3) (d14 : L.y ≠ v4)
    (d23 : v2 ≠ v3) (d24 : v2 ≠ v4) (d34 : v3 ≠ v4)
    (n12 : e1 ≠ e2) (n23 : e2 ≠ e3)
    (hb1 : leafCol L c2 σ τ lam e1 = leafCol L c2 σ τ lam e3)
    (hb2 : leafCol L c2 σ τ lam e2 = leafCol L c2 σ τ lam e4) : False := by
  have o3 : L.O e3 := oldOf q3 h3 (Ne.symm d12) (Ne.symm d13)
  have o4 : L.O e4 := oldOf q4 h4 (Ne.symm d13) (Ne.symm d14)
  rw [colO o3] at hb1
  rw [colO o4] at hb2
  rcases atY q2 h2 with ⟨he2, hv2⟩ | ⟨he2, hv2⟩ | ⟨he2, hv2⟩
  · subst hv2
    rw [he2, col1] at hb2
    rcases atY q1 (jsymm h1) with ⟨he1, hv0⟩ | ⟨he1, hv0⟩ | ⟨he1, hv0⟩
    · exact n12 (he1.trans he2.symm)
    · -- (M_ts): w, y, u, v3, v4
      subst hv0
      rw [he1, col2] at hb1
      exact C.MTS v3 v4 e3 e4 o3 o4 h3 h4 d03 d23 d24 d34 ⟨hb1.symm, hb2.symm⟩
    · -- (L_s): l, y, u, v3, v4
      subst hv0
      rw [he1, col3] at hb1
      exact C.LS v3 v4 e3 e4 o3 o4 h3 h4 d23 d24 d34 ⟨hb1.symm, hb2.symm⟩
  · subst hv2
    rw [he2, col2] at hb2
    rcases atY q1 (jsymm h1) with ⟨he1, hv0⟩ | ⟨he1, hv0⟩ | ⟨he1, hv0⟩
    · -- (M_st): u, y, w, v3, v4
      subst hv0
