/-! ### the two target graphs and their star colourings -/

/-- K₃,₃ with the edge order of the contract -/
def K33 : MGraph := { n := 6, m := 9, ends := fun i =>
  ([(0,3),(1,3),(2,3),(0,4),(1,4),(2,4),(0,5),(1,5),(2,5)] : List (Fin 6 × Fin 6)).getD i.val (0,0) }

/-- the Petersen graph with the edge order of the contract -/
def Pet : MGraph := { n := 10, m := 15, ends := fun i =>
  ([(0,1),(1,2),(2,3),(3,4),(4,0),(0,5),(1,6),(2,7),(3,8),(4,9),(5,7),(7,9),(9,6),(6,8),(8,5)] :
    List (Fin 10 × Fin 10)).getD i.val (0,0) }

def k33c : Fin K33.m → Fin 6 := fun i => ([0, 1, 2, 1, 3, 4, 2, 4, 5] : List (Fin 6)).getD i.val 0
def petc : Fin Pet.m → Fin 5 := fun i => ([0, 1, 0, 2, 3, 2, 2, 3, 4, 1, 4, 0, 4, 3, 1] : List (Fin 5)).getD i.val 0

theorem k33_check : K33.starCheck (fun _ => true) k33c = true := by decide +kernel
theorem pet_check : Pet.starCheck (fun _ => true) petc = true := by decide +kernel

theorem k33_star : Star (G := K33) 6 k33c := K33.star_of_check k33c k33_check
theorem pet_star : Star (G := Pet) 5 petc := Pet.star_of_check petc pet_check

theorem k33_loopless : ∀ f : Fin K33.m, (K33.ends f).1 ≠ (K33.ends f).2 := by decide +kernel
theorem pet_loopless : ∀ f : Fin Pet.m, (Pet.ends f).1 ≠ (Pet.ends f).2 := by decide +kernel

