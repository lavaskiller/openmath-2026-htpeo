  y : Fin G.n
  u : Fin G.n
  w : Fin G.n
  l : Fin G.n
  f1 : Fin G.m
  f2 : Fin G.m
  f3 : Fin G.m
  hloop : Loopless G
  hf1 : G.Joins f1 y u
  hf2 : G.Joins f2 y w
  hf3 : G.Joins f3 y l
  hQ1 : Q f1
  hQ2 : Q f2
  hQ3 : Q f3
