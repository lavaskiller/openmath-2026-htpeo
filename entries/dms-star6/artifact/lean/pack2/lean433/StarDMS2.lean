/-! ### edge-set embeddings -/

/-- an embedding of the edge set `P` of `X` into the edge set `P'` of `Y` -/
structure EmbOn (X Y : MGraph) (P : Fin X.m → Prop) (P' : Fin Y.m → Prop) where
  φ : Fin X.n → Fin Y.n
  ψ : Fin X.m → Fin Y.m
  φinj : ∀ a b, φ a = φ b → a = b
  ψinj : ∀ e e', P e → P e' → ψ e = ψ e' → e = e'
  ends : ∀ e, P e → Y.ends (ψ e) = (φ (X.ends e).1, φ (X.ends e).2)
  fwd : ∀ e, P e → P' (ψ e)

