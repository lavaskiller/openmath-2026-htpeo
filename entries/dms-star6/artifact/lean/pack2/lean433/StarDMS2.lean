      lift_ne hz0 d01, lift_ne hz0 d02, lift_ne hz0 d03, phi_ne d12, phi_ne d13,
      fun e => lift_ne hz4 (Ne.symm d14) e.symm, phi_ne d23,
      fun e => lift_ne hz4 (Ne.symm d24) e.symm, fun e => lift_ne hz4 (Ne.symm d34) e.symm⟩
