    apply hs.2 ⟨z0, S.φ v1, S.φ v2, S.φ v3, z4, τ1, S.old e2, S.old e3, τ4, hτ1, j2, j3, joins_symm hτ4,
      lift_ne hz0 d01, lift_ne hz0 d02, lift_ne hz0 d03, phi_ne d12, phi_ne d13,
      fun e => lift_ne hz4 (Ne.symm d14) e.symm, phi_ne d23,
      fun e => lift_ne hz4 (Ne.symm d24) e.symm, fun e => lift_ne hz4 (Ne.symm d34) e.symm⟩
    constructor
    · apply castSucc_inj'
      show Fin.castSucc (c τ1) = Fin.castSucc (c (S.old e3))
      rw [hc1, ← hC.hold e3 o3]
      exact hb1
    · apply castSucc_inj'
      show Fin.castSucc (c (S.old e2)) = Fin.castSucc (c τ4)
      rw [hc4, ← hC.hold e2 o2]
      exact hb2

