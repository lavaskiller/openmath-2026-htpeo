section Module_MhFact_7bae7837ff8807e2
-- Lean proof of fact 7bae7837ff8807e2 (KPiLean.kpi_main); added by fact_submit, do not edit
/-
  KPi.lean — the global construction K^Π(𝒟) of fact 85bb5f970f208c0b as a Lean multigraph (Lean 4.20 core, no
  Mathlib).  Given an edge set `P` of a loopless multigraph `X` and a list `D : DigonList X P k` of `k` pairwise
  vertex-disjoint digons of `P` (containing every pair of parallel `P`-edges), `kpi D` is the multigraph with
    * vertices  `X.n + 4k + 2·X.m`: the old vertices, four new vertices C, X, Y, Z per digon, and two spare vertices
      per old edge;
    * edges     `X.m + 8k`: old edge `f` keeps its ends if it is a non-digon `P`-edge (`Keep f`), otherwise it becomes an
      isolated edge between its two spare vertices; digon `i` gets the eight gadget edges AC BC CX AY BZ XY YZ XZ
      (A = p i, B = q i).
  `R D` is the edge set of the real graph K^Π (kept old edges and gadget edges).  Proved here:
    * `kpi_subst`   : the relational data `PiSubstOn X (kpi D) P k` of the replacement lemma (fact 3a172a440dfeed42);
    * `kpi_local`   : every gadget copy is `PiLocal` in `kpi D`;
    * `kpi_loopless`: `kpi D` is loopless;
    * `kpi_star`    : a star 5-colouring of the edge set `R D` is a star 5-colouring of the whole of `kpi D`
                      (the other edges are isolated);
    * `kpi_cubic`, `kpi_connected`, `kpi_bridgeless`: `R D` is cubic / connected / bridgeless whenever `P` is;
    * `kpi_simple`  : no two distinct `R D`-edges join the same pair of vertices;
    * `kpi_colour`  : a star 5-colouring of `R D` gives a star 6-colouring of `P` (via fact 3a172a440dfeed42);
    * `kpi_main`    : the conjunction of all of the above.
  The module builds under Lean 4.20 and under Lean 4.33.1 (the equations of `joins_eg_iff` are stated in
  `Fin (NV X k)` so that `simp` never has to unify `Fin (kpi D).n` with `Fin (NV X k)`).
-/


namespace KPiLean
open MGraph PiRigidLean PiSubOnLean

attribute [local instance] Classical.propDecidable

/-- `k` pairwise vertex-disjoint digons `{e6 i, ey i}` (between `p i` and `q i`) of the edge set `P`, with the third
    `P`-edges `pp i` at `p i` and `pq i` at `q i`; every pair of distinct parallel `P`-edges is one of them -/
structure DigonList (X : MGraph) (P : Fin X.m → Prop) (k : Nat) where
  p : Fin k → Fin X.n
  q : Fin k → Fin X.n
  e6 : Fin k → Fin X.m
  ey : Fin k → Fin X.m
  pp : Fin k → Fin X.m
  pq : Fin k → Fin X.m
  hpq : ∀ i, p i ≠ q i
  j6 : ∀ i, X.Joins (e6 i) (p i) (q i)
  jy : ∀ i, X.Joins (ey i) (p i) (q i)
  P6 : ∀ i, P (e6 i)
  Py : ∀ i, P (ey i)
  Ppp : ∀ i, P (pp i)
  Ppq : ∀ i, P (pq i)
  ipp : ∀ i, X.Inc (pp i) (p i)
  ipq : ∀ i, X.Inc (pq i) (q i)
  incp : ∀ i f, P f → X.Inc f (p i) → f = e6 i ∨ f = ey i ∨ f = pp i
  incq : ∀ i f, P f → X.Inc f (q i) → f = e6 i ∨ f = ey i ∨ f = pq i
  disj : ∀ i j, i ≠ j → p i ≠ p j ∧ p i ≠ q j ∧ q i ≠ p j ∧ q i ≠ q j
  ppOld : ∀ i j, pp i ≠ e6 j ∧ pp i ≠ ey j
  pqOld : ∀ i j, pq i ≠ e6 j ∧ pq i ≠ ey j
  ppq : ∀ i, pp i ≠ pq i
  h6y : ∀ i, e6 i ≠ ey i
  allDig : ∀ f g x y, P f → P g → f ≠ g → X.Joins f x y → X.Joins g x y → ∃ i, f = e6 i ∨ f = ey i

variable {X : MGraph} {P : Fin X.m → Prop} {k : Nat}

section defs
variable (D : DigonList X P k)

/-- a non-digon `P`-edge -/
def DigonList.Keep (f : Fin X.m) : Prop := P f ∧ ∀ i, f ≠ D.e6 i ∧ f ≠ D.ey i

end defs

/-! ### vertices and edges of `kpi D` -/

def NV (X : MGraph) (k : Nat) : Nat := X.n + 4 * k + 2 * X.m

def vo (x : Fin X.n) : Fin (NV X k) := ⟨x.val, by unfold NV; omega⟩
def vg (i : Fin k) (r : Nat) (hr : r < 4) : Fin (NV X k) := ⟨X.n + 4 * i.val + r, by unfold NV; have := i.isLt; omega⟩
def vi (f : Fin X.m) (s : Nat) (hs : s < 2) : Fin (NV X k) :=
  ⟨X.n + 4 * k + 2 * f.val + s, by unfold NV; have := f.isLt; omega⟩

abbrev vC (i : Fin k) : Fin (NV X k) := vg i 0 (by decide)
abbrev vX (i : Fin k) : Fin (NV X k) := vg i 1 (by decide)
abbrev vY (i : Fin k) : Fin (NV X k) := vg i 2 (by decide)
abbrev vZ (i : Fin k) : Fin (NV X k) := vg i 3 (by decide)

/-- the ends of gadget edge `r` of digon `i` -/
def gEnds (D : DigonList X P k) (i : Fin k) : Nat → Fin (NV X k) × Fin (NV X k)
  | 0 => (vo (D.p i), vC i)
  | 1 => (vo (D.q i), vC i)
  | 2 => (vC i, vX i)
  | 3 => (vo (D.p i), vY i)
  | 4 => (vo (D.q i), vZ i)
  | 5 => (vX i, vY i)
  | 6 => (vY i, vZ i)
  | _ => (vX i, vZ i)

theorem div_lt_k {e m k : Nat} (h1 : e < m + 8 * k) (h2 : ¬ e < m) : (e - m) / 8 < k := by omega

/-- the multigraph `kpi D` -/
noncomputable def kpi (D : DigonList X P k) : MGraph where
  n := NV X k
  m := X.m + 8 * k
  ends := fun e =>
    if h : e.val < X.m then
      (if D.Keep ⟨e.val, h⟩ then (vo (X.ends ⟨e.val, h⟩).1, vo (X.ends ⟨e.val, h⟩).2)
       else (vi ⟨e.val, h⟩ 0 (by decide), vi ⟨e.val, h⟩ 1 (by decide)))
    else gEnds D ⟨(e.val - X.m) / 8, div_lt_k e.isLt h⟩ ((e.val - X.m) % 8)

variable {D : DigonList X P k}

noncomputable def eo (D : DigonList X P k) (f : Fin X.m) : Fin (kpi D).m := ⟨f.val, by show f.val < X.m + 8 * k; have := f.isLt; omega⟩
noncomputable def eg (D : DigonList X P k) (i : Fin k) (r : Nat) (hr : r < 8) : Fin (kpi D).m :=
  ⟨X.m + 8 * i.val + r, by show X.m + 8 * i.val + r < X.m + 8 * k; have := i.isLt; omega⟩

theorem ends_keep {f : Fin X.m} (h : D.Keep f) : (kpi D).ends (eo D f) = (vo (X.ends f).1, vo (X.ends f).2) := by
  simp only [kpi, eo, dif_pos f.isLt, Fin.eta, if_pos h]

theorem ends_nokeep {f : Fin X.m} (h : ¬ D.Keep f) :
    (kpi D).ends (eo D f) = (vi f 0 (by decide), vi f 1 (by decide)) := by
  simp only [kpi, eo, dif_pos f.isLt, Fin.eta, if_neg h]

theorem ends_eg (i : Fin k) (r : Nat) (hr : r < 8) : (kpi D).ends (eg D i r hr) = gEnds D i r := by
  have h0 : ¬ X.m + 8 * i.val + r < X.m := by omega
  have h1 : (X.m + 8 * i.val + r - X.m) / 8 = i.val := by omega
  have h2 : (X.m + 8 * i.val + r - X.m) % 8 = r := by omega
  simp only [kpi, eg, dif_neg h0, h1, h2, Fin.eta]

theorem edge_cases (e : Fin (kpi D).m) : (∃ f, e = eo D f) ∨ ∃ i r hr, e = eg D i r hr := by
  by_cases h : e.val < X.m
  · exact Or.inl ⟨⟨e.val, h⟩, Fin.ext rfl⟩
  · have he : e.val < X.m + 8 * k := e.isLt
    refine Or.inr ⟨⟨(e.val - X.m) / 8, by omega⟩, (e.val - X.m) % 8, by omega, Fin.ext ?_⟩
    show e.val = X.m + 8 * ((e.val - X.m) / 8) + (e.val - X.m) % 8
    omega

theorem r8 {r : Nat} (hr : r < 8) : r = 0 ∨ r = 1 ∨ r = 2 ∨ r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 := by omega

/-! ### vertex (in)equalities -/

theorem vo_inj {x y : Fin X.n} (h : (vo x : Fin (NV X k)) = vo y) : x = y :=
  Fin.ext (by have := congrArg Fin.val h; exact this)
theorem vo_ne_vg {x : Fin X.n} {i : Fin k} {r : Nat} {hr : r < 4} : (vo x : Fin (NV X k)) ≠ vg i r hr := by
  intro h; have := congrArg Fin.val h; simp [vo, vg] at this; have := x.isLt; omega
theorem vo_ne_vi {x : Fin X.n} {f : Fin X.m} {s : Nat} {hs : s < 2} : (vo x : Fin (NV X k)) ≠ vi f s hs := by
  intro h; have := congrArg Fin.val h; simp [vo, vi] at this; have := x.isLt; omega
theorem vg_ne_vi {i : Fin k} {r : Nat} {hr : r < 4} {f : Fin X.m} {s : Nat} {hs : s < 2} :
    (vg i r hr : Fin (NV X k)) ≠ vi f s hs := by
  intro h; have := congrArg Fin.val h; simp [vg, vi] at this; have := i.isLt; omega
theorem vg_inj {i j : Fin k} {r s : Nat} {hr : r < 4} {hs : s < 4} (h : (vg i r hr : Fin (NV X k)) = vg j s hs) :
    i = j ∧ r = s := by
  have := congrArg Fin.val h; simp [vg] at this
  exact ⟨Fin.ext (by omega), by omega⟩
theorem vi_inj {f g : Fin X.m} {s t : Nat} {hs : s < 2} {ht : t < 2} (h : (vi f s hs : Fin (NV X k)) = vi g t ht) :
    f = g ∧ s = t := by
  have := congrArg Fin.val h; simp [vi] at this
  exact ⟨Fin.ext (by omega), by omega⟩

theorem eo_inj {f g : Fin X.m} (h : eo D f = eo D g) : f = g := Fin.ext (by have := congrArg Fin.val h; exact this)
theorem eo_ne_eg {f : Fin X.m} {i : Fin k} {r : Nat} {hr : r < 8} : eo D f ≠ eg D i r hr := by
  intro h; have := congrArg Fin.val h; simp [eo, eg] at this; have := f.isLt; omega
theorem eg_inj {i j : Fin k} {r s : Nat} {hr : r < 8} {hs : s < 8} (h : eg D i r hr = eg D j s hs) : i = j ∧ r = s := by
  have := congrArg Fin.val h; simp [eg] at this
  exact ⟨Fin.ext (by omega), by omega⟩

/-! ### digon-list consequences -/

theorem p_inj {i j : Fin k} (h : D.p i = D.p j) : i = j :=
  Classical.byContradiction fun hij => (D.disj i j hij).1 h
theorem q_inj {i j : Fin k} (h : D.q i = D.q j) : i = j :=
  Classical.byContradiction fun hij => (D.disj i j hij).2.2.2 h
theorem p_ne_q (i j : Fin k) : D.p i ≠ D.q j := by
  intro h
  by_cases hij : i = j
  · subst hij; exact D.hpq i h
  · exact (D.disj i j hij).2.1 h

theorem keep_pp (i : Fin k) : D.Keep (D.pp i) := ⟨D.Ppp i, D.ppOld i⟩
theorem keep_pq (i : Fin k) : D.Keep (D.pq i) := ⟨D.Ppq i, D.pqOld i⟩

/-- the other end of an edge `f` at a vertex `x` -/
def oth (f : Fin X.m) (x : Fin X.n) : Fin X.n := if (X.ends f).1 = x then (X.ends f).2 else (X.ends f).1

theorem joins_oth {f : Fin X.m} {x : Fin X.n} (h : X.Inc f x) : X.Joins f x (oth f x) := by
  unfold oth
  by_cases h1 : (X.ends f).1 = x
  · rw [if_pos h1]; left; rw [← h1]
  · rw [if_neg h1]
    rcases h with h | h
    · exact absurd h h1
    · right; rw [← h]

theorem joins_kpi {f : Fin X.m} (hk : D.Keep f) {x y : Fin X.n} (h : X.Joins f x y) :
    (kpi D).Joins (eo D f) (vo x) (vo y) := by
  unfold Joins; rw [ends_keep hk]
  rcases h with h | h <;> rw [h]
  · exact Or.inl rfl
  · exact Or.inr rfl

theorem inc_keep {f : Fin X.m} (hk : D.Keep f) {x : Fin X.n} : (kpi D).Inc (eo D f) (vo x) ↔ X.Inc f x := by
  unfold Inc; rw [ends_keep hk]
  constructor
  · rintro (h | h)
    · exact Or.inl (vo_inj h)
    · exact Or.inr (vo_inj h)
  · rintro (h | h)
    · exact Or.inl (by rw [h])
    · exact Or.inr (by rw [h])

/-- which gadget edges meet an old vertex -/
theorem inc_eg_vo {j : Fin k} {r : Nat} {hr : r < 8} {x : Fin X.n} (h : (kpi D).Inc (eg D j r hr) (vo x)) :
    ((r = 0 ∨ r = 3) ∧ x = D.p j) ∨ ((r = 1 ∨ r = 4) ∧ x = D.q j) := by
  unfold Inc at h; rw [ends_eg] at h
  rcases r8 hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp only [gEnds] at h
  · rcases h with h | h
    · exact Or.inl ⟨Or.inl rfl, (vo_inj h).symm⟩
    · exact absurd h.symm vo_ne_vg
  · rcases h with h | h
    · exact Or.inr ⟨Or.inl rfl, (vo_inj h).symm⟩
    · exact absurd h.symm vo_ne_vg
  · rcases h with h | h <;> exact absurd h.symm vo_ne_vg
  · rcases h with h | h
    · exact Or.inl ⟨Or.inr rfl, (vo_inj h).symm⟩
    · exact absurd h.symm vo_ne_vg
  · rcases h with h | h
    · exact Or.inr ⟨Or.inr rfl, (vo_inj h).symm⟩
    · exact absurd h.symm vo_ne_vg
  · rcases h with h | h <;> exact absurd h.symm vo_ne_vg
  · rcases h with h | h <;> exact absurd h.symm vo_ne_vg
  · rcases h with h | h <;> exact absurd h.symm vo_ne_vg

/-- which gadget edges meet a gadget vertex -/
theorem inc_eg_vg {j i : Fin k} {r s : Nat} {hr : r < 8} {hs : s < 4} (h : (kpi D).Inc (eg D j r hr) (vg i s hs)) :
    j = i ∧ ((s = 0 ∧ (r = 0 ∨ r = 1 ∨ r = 2)) ∨ (s = 1 ∧ (r = 2 ∨ r = 5 ∨ r = 7)) ∨
      (s = 2 ∧ (r = 3 ∨ r = 5 ∨ r = 6)) ∨ (s = 3 ∧ (r = 4 ∨ r = 6 ∨ r = 7))) := by
  unfold Inc at h; rw [ends_eg] at h
  rcases r8 hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp only [gEnds] at h <;>
    rcases h with h | h <;>
    first
    | exact absurd h vo_ne_vg
    | (obtain ⟨h1, h2⟩ := vg_inj h; subst h1; subst h2; simp)

/-- old edges never meet gadget vertices -/
theorem not_inc_eo_vg {f : Fin X.m} {i : Fin k} {s : Nat} {hs : s < 4} : ¬ (kpi D).Inc (eo D f) (vg i s hs) := by
  unfold Inc
  by_cases hk : D.Keep f
  · rw [ends_keep hk]; rintro (h | h) <;> exact vo_ne_vg h
  · rw [ends_nokeep hk]; simp only; rintro (h | h) <;> exact vg_ne_vi h.symm

/-- gadget edges never meet spare vertices -/
theorem not_inc_eg_vi {i : Fin k} {r : Nat} {hr : r < 8} {f : Fin X.m} {s : Nat} {hs : s < 2} :
    ¬ (kpi D).Inc (eg D i r hr) (vi f s hs) := by
  unfold Inc; rw [ends_eg]
  rcases r8 hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp only [gEnds] <;>
    rintro (h | h) <;> first | exact vo_ne_vi h | exact vg_ne_vi h

/-- the only edge at a spare vertex of `f` is `eo f` (and only if `f` is not kept) -/
theorem inc_vi {e : Fin (kpi D).m} {f : Fin X.m} {s : Nat} {hs : s < 2} (h : (kpi D).Inc e (vi f s hs)) :
    e = eo D f ∧ ¬ D.Keep f := by
  rcases edge_cases e with ⟨g, rfl⟩ | ⟨i, r, hr, rfl⟩
  · by_cases hk : D.Keep g
    · unfold Inc at h; rw [ends_keep hk] at h
      rcases h with h | h <;> exact absurd h vo_ne_vi
    · unfold Inc at h; rw [ends_nokeep hk] at h; simp only at h
      rcases h with h | h
      · have := (vi_inj h).1; subst this; exact ⟨rfl, hk⟩
      · have := (vi_inj h).1; subst this; exact ⟨rfl, hk⟩
  · exact absurd h not_inc_eg_vi

/-! ### the Π-copies -/

theorem oth_ne_p (hl : MGraph.Loopless X) (i : Fin k) : oth (D.pp i) (D.p i) ≠ D.p i := by
  intro h
  have := joins_oth (D.ipp i); rw [h] at this
  exact ne_of_joins hl this rfl

theorem oth_ne_q (i : Fin k) : oth (D.pp i) (D.p i) ≠ D.q i := by
  intro h
  have hj := joins_oth (D.ipp i); rw [h] at hj
  rcases D.incq i (D.pp i) (D.Ppp i) (joins_inc_right hj) with h' | h' | h'
  · exact (D.ppOld i i).1 h'
  · exact (D.ppOld i i).2 h'
  · exact D.ppq i h'

theorem oth'_ne_q (hl : MGraph.Loopless X) (i : Fin k) : oth (D.pq i) (D.q i) ≠ D.q i := by
  intro h
  have := joins_oth (D.ipq i); rw [h] at this
  exact ne_of_joins hl this rfl

theorem oth'_ne_p (i : Fin k) : oth (D.pq i) (D.q i) ≠ D.p i := by
  intro h
  have hj := joins_oth (D.ipq i); rw [h] at hj
  rcases D.incp i (D.pq i) (D.Ppq i) (joins_inc_right hj) with h' | h' | h'
  · exact (D.pqOld i i).1 h'
  · exact (D.pqOld i i).2 h'
  · exact D.ppq i h'.symm

theorem vg_ne {i : Fin k} {r s : Nat} {hr : r < 4} {hs : s < 4} (h : r ≠ s) :
    (vg i r hr : Fin (NV X k)) ≠ vg i s hs := fun e => h (vg_inj e).2

/-- the Π-copy of digon `i` -/
noncomputable def copyOf (hl : MGraph.Loopless X) (D : DigonList X P k) (i : Fin k) : PiCopy (kpi D) where
  A := vo (D.p i)
  B := vo (D.q i)
  C := vC i
  X := vX i
  Y := vY i
  Z := vZ i
  u := vo (oth (D.pp i) (D.p i))
  v := vo (oth (D.pq i) (D.q i))
  eAC := eg D i 0 (by decide)
  eBC := eg D i 1 (by decide)
  eCX := eg D i 2 (by decide)
  eAY := eg D i 3 (by decide)
  eBZ := eg D i 4 (by decide)
  eXY := eg D i 5 (by decide)
  eYZ := eg D i 6 (by decide)
  eXZ := eg D i 7 (by decide)
  eAu := eo D (D.pp i)
  eBv := eo D (D.pq i)
  jAC := by left; rw [ends_eg]; rfl
  jBC := by left; rw [ends_eg]; rfl
  jCX := by left; rw [ends_eg]; rfl
  jAY := by left; rw [ends_eg]; rfl
  jBZ := by left; rw [ends_eg]; rfl
  jXY := by left; rw [ends_eg]; rfl
  jYZ := by left; rw [ends_eg]; rfl
  jXZ := by left; rw [ends_eg]; rfl
  jAu := joins_kpi (keep_pp i) (joins_oth (D.ipp i))
  jBv := joins_kpi (keep_pq i) (joins_oth (D.ipq i))
  dAB := fun h => D.hpq i (vo_inj h)
  dAC := vo_ne_vg
  dAX := vo_ne_vg
  dAY := vo_ne_vg
  dAZ := vo_ne_vg
  dBC := vo_ne_vg
  dBX := vo_ne_vg
  dBY := vo_ne_vg
  dBZ := vo_ne_vg
  dCX := vg_ne (by decide)
  dCY := vg_ne (by decide)
  dCZ := vg_ne (by decide)
  dXY := vg_ne (by decide)
  dXZ := vg_ne (by decide)
  dYZ := vg_ne (by decide)
  duA := fun h => oth_ne_p hl i (vo_inj h)
  duB := fun h => oth_ne_q i (vo_inj h)
  duC := vo_ne_vg
  duX := vo_ne_vg
  duY := vo_ne_vg
  duZ := vo_ne_vg
  dvA := fun h => oth'_ne_p i (vo_inj h)
  dvB := fun h => oth'_ne_q hl i (vo_inj h)
  dvC := vo_ne_vg
  dvX := vo_ne_vg
  dvY := vo_ne_vg
  dvZ := vo_ne_vg

/-- **the relational data of the replacement lemma** for `kpi D` -/
noncomputable def kpi_subst (hl : MGraph.Loopless X) (D : DigonList X P k) : PiSubstOn X (kpi D) P k where
  φ := vo
  φinj := fun _ _ h => vo_inj h
  p := D.p
  q := D.q
  e6 := D.e6
  ey := D.ey
  pp := D.pp
  pq := D.pq
  hpq := D.hpq
  j6 := D.j6
  P6 := D.P6
  Py := D.Py
  Ppp := D.Ppp
  Ppq := D.Ppq
  jy := D.jy
  incp := D.incp
  incq := D.incq
  disj := D.disj
  ppOld := D.ppOld
  pqOld := D.pqOld
  old := eo D
  oldJ := fun _ _ _ hP hd hj => joins_kpi ⟨hP, hd⟩ hj
  oldInj := fun _ _ _ _ _ _ h => eo_inj h
  copy := copyOf hl D
  cA := fun _ => rfl
  cB := fun _ => rfl
  cAu := fun _ => rfl
  cBv := fun _ => rfl
  newC := fun _ _ h => vo_ne_vg (hr := by decide) h.symm
  newY := fun _ _ h => vo_ne_vg (hr := by decide) h.symm
  newZ := fun _ _ h => vo_ne_vg (hr := by decide) h.symm

/-! ### incidence classification -/

theorem vertex_cases (v : Fin (NV X k)) :
    (∃ x, v = vo x) ∨ (∃ i s hs, v = (vg i s hs : Fin (NV X k))) ∨ ∃ f s hs, v = (vi f s hs : Fin (NV X k)) := by
  have hv : v.val < X.n + 4 * k + 2 * X.m := v.isLt
  by_cases h1 : v.val < X.n
  · exact Or.inl ⟨⟨v.val, h1⟩, Fin.ext rfl⟩
  · by_cases h2 : v.val < X.n + 4 * k
    · refine Or.inr (Or.inl ⟨⟨(v.val - X.n) / 4, by omega⟩, (v.val - X.n) % 4, by omega, Fin.ext ?_⟩)
      show v.val = X.n + 4 * ((v.val - X.n) / 4) + (v.val - X.n) % 4
      omega
    · refine Or.inr (Or.inr ⟨⟨(v.val - X.n - 4 * k) / 2, by omega⟩, (v.val - X.n - 4 * k) % 2, by omega, Fin.ext ?_⟩)
      show v.val = X.n + 4 * k + 2 * ((v.val - X.n - 4 * k) / 2) + (v.val - X.n - 4 * k) % 2
      omega

theorem inc_vo_cases {e : Fin (kpi D).m} {x : Fin X.n} (h : (kpi D).Inc e (vo x)) :
    (∃ f, e = eo D f ∧ D.Keep f ∧ X.Inc f x) ∨
    (∃ j r hr, e = eg D j r hr ∧ (((r = 0 ∨ r = 3) ∧ x = D.p j) ∨ ((r = 1 ∨ r = 4) ∧ x = D.q j))) := by
  rcases edge_cases e with ⟨f, rfl⟩ | ⟨j, r, hr, rfl⟩
  · by_cases hk : D.Keep f
    · exact Or.inl ⟨f, rfl, hk, (inc_keep hk).1 h⟩
    · exfalso
      unfold Inc at h; rw [ends_nokeep hk] at h; simp only at h
      rcases h with h | h <;> exact vo_ne_vi h.symm
  · exact Or.inr ⟨j, r, hr, rfl, inc_eg_vo h⟩

theorem inc_vg_cases {e : Fin (kpi D).m} {i : Fin k} {s : Nat} {hs : s < 4} (h : (kpi D).Inc e (vg i s hs)) :
    ∃ r hr, e = eg D i r hr ∧ ((s = 0 ∧ (r = 0 ∨ r = 1 ∨ r = 2)) ∨ (s = 1 ∧ (r = 2 ∨ r = 5 ∨ r = 7)) ∨
      (s = 2 ∧ (r = 3 ∨ r = 5 ∨ r = 6)) ∨ (s = 3 ∧ (r = 4 ∨ r = 6 ∨ r = 7))) := by
  rcases edge_cases e with ⟨f, rfl⟩ | ⟨j, r, hr, rfl⟩
  · exact absurd h not_inc_eo_vg
  · obtain ⟨hj, hc⟩ := inc_eg_vg h
    subst hj
    exact ⟨r, hr, rfl, hc⟩

theorem inc_eg (i : Fin k) (r : Nat) (hr : r < 8) (s : Nat) (hs : s < 4)
    (h : (s = 0 ∧ (r = 0 ∨ r = 1 ∨ r = 2)) ∨ (s = 1 ∧ (r = 2 ∨ r = 5 ∨ r = 7)) ∨
      (s = 2 ∧ (r = 3 ∨ r = 5 ∨ r = 6)) ∨ (s = 3 ∧ (r = 4 ∨ r = 6 ∨ r = 7))) :
    (kpi D).Inc (eg D i r hr) (vg i s hs) := by
  unfold Inc; rw [ends_eg]
  rcases h with ⟨rfl, h⟩ | ⟨rfl, h⟩ | ⟨rfl, h⟩ | ⟨rfl, h⟩ <;>
    rcases h with rfl | rfl | rfl <;> simp [gEnds] <;> first | exact Or.inl rfl | exact Or.inr rfl

/-! ### `PiLocal` -/

theorem kpi_local (hl : MGraph.Loopless X) (i : Fin k) : PiLocal (copyOf hl D i) where
  incA := fun f h => by
    have h' : (kpi D).Inc f (vo (D.p i)) := h
    rcases inc_vo_cases h' with ⟨g, rfl, hk, hg⟩ | ⟨j, r, hr, rfl, hc⟩
    · rcases D.incp i g hk.1 hg with e | e | e
      · exact absurd e (hk.2 i).1
      · exact absurd e (hk.2 i).2
      · subst e; exact Or.inr (Or.inr rfl)
    · rcases hc with ⟨hr', hx⟩ | ⟨_, hx⟩
      · have := p_inj hx; subst this
        rcases hr' with rfl | rfl
        · exact Or.inl rfl
        · exact Or.inr (Or.inl rfl)
      · exact absurd hx (p_ne_q i j)
  incB := fun f h => by
    have h' : (kpi D).Inc f (vo (D.q i)) := h
    rcases inc_vo_cases h' with ⟨g, rfl, hk, hg⟩ | ⟨j, r, hr, rfl, hc⟩
    · rcases D.incq i g hk.1 hg with e | e | e
      · exact absurd e (hk.2 i).1
      · exact absurd e (hk.2 i).2
      · subst e; exact Or.inr (Or.inr rfl)
    · rcases hc with ⟨_, hx⟩ | ⟨hr', hx⟩
      · exact absurd hx.symm (p_ne_q j i)
      · have := q_inj hx; subst this
        rcases hr' with rfl | rfl
        · exact Or.inl rfl
        · exact Or.inr (Or.inl rfl)
  incC := fun f h => by
    obtain ⟨r, hr, rfl, hc⟩ := inc_vg_cases (hs := by decide) (show (kpi D).Inc f (vg i 0 (by decide)) from h)
    rcases hc with ⟨_, h⟩ | ⟨h0, _⟩ | ⟨h0, _⟩ | ⟨h0, _⟩
    · rcases h with rfl | rfl | rfl
      · exact Or.inl rfl
      · exact Or.inr (Or.inl rfl)
      · exact Or.inr (Or.inr rfl)
    all_goals exact absurd h0 (by decide)
  incX := fun f h => by
    obtain ⟨r, hr, rfl, hc⟩ := inc_vg_cases (hs := by decide) (show (kpi D).Inc f (vg i 1 (by decide)) from h)
    rcases hc with ⟨h0, _⟩ | ⟨_, h⟩ | ⟨h0, _⟩ | ⟨h0, _⟩
    · exact absurd h0 (by decide)
    · rcases h with rfl | rfl | rfl
      · exact Or.inl rfl
      · exact Or.inr (Or.inl rfl)
      · exact Or.inr (Or.inr rfl)
    all_goals exact absurd h0 (by decide)
  incY := fun f h => by
    obtain ⟨r, hr, rfl, hc⟩ := inc_vg_cases (hs := by decide) (show (kpi D).Inc f (vg i 2 (by decide)) from h)
    rcases hc with ⟨h0, _⟩ | ⟨h0, _⟩ | ⟨_, h⟩ | ⟨h0, _⟩
    · exact absurd h0 (by decide)
    · exact absurd h0 (by decide)
    · rcases h with rfl | rfl | rfl
      · exact Or.inl rfl
      · exact Or.inr (Or.inl rfl)
      · exact Or.inr (Or.inr rfl)
    · exact absurd h0 (by decide)
  incZ := fun f h => by
    obtain ⟨r, hr, rfl, hc⟩ := inc_vg_cases (hs := by decide) (show (kpi D).Inc f (vg i 3 (by decide)) from h)
    rcases hc with ⟨h0, _⟩ | ⟨h0, _⟩ | ⟨h0, _⟩ | ⟨_, h⟩
    · exact absurd h0 (by decide)
    · exact absurd h0 (by decide)
    · exact absurd h0 (by decide)
    · rcases h with rfl | rfl | rfl
      · exact Or.inl rfl
      · exact Or.inr (Or.inr rfl)
      · exact Or.inr (Or.inl rfl)

/-! ### looplessness -/

theorem kpi_loopless (hl : MGraph.Loopless X) : MGraph.Loopless (kpi D) := by
  intro e
  rcases edge_cases e with ⟨f, rfl⟩ | ⟨j, r, hr, rfl⟩
  · by_cases hk : D.Keep f
    · rw [ends_keep hk]; exact fun h => hl f (vo_inj h)
    · rw [ends_nokeep hk]; intro h; simp only at h; have := (vi_inj h).2; omega
  · rw [ends_eg]
    rcases r8 hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp only [gEnds] <;>
      first | exact vo_ne_vg | exact vg_ne (by decide)

theorem kpi_loopless' (hl : MGraph.Loopless X) : PiRigidLean.Loopless (kpi D) := kpi_loopless hl

/-! ### the real edge set `R D` and the star transfer -/

/-- the edges of K^Π: kept old edges and gadget edges -/
def R (D : DigonList X P k) (e : Fin (kpi D).m) : Prop := ∀ h : e.val < X.m, D.Keep ⟨e.val, h⟩

theorem R_eo {f : Fin X.m} : R D (eo D f) ↔ D.Keep f := ⟨fun h => h f.isLt, fun h _ => h⟩
theorem R_eg {i : Fin k} {r : Nat} {hr : r < 8} : R D (eg D i r hr) := by
  intro h; exfalso; have : X.m + 8 * i.val + r < X.m := h; omega

theorem notR {e : Fin (kpi D).m} (h : ¬ R D e) : ∃ f, e = eo D f ∧ ¬ D.Keep f := by
  rcases edge_cases e with ⟨f, rfl⟩ | ⟨i, r, hr, rfl⟩
  · exact ⟨f, rfl, fun hk => h (R_eo.2 hk)⟩
  · exact absurd R_eg h

/-- an edge outside `R D` shares no vertex with any other edge -/
theorem isolated {a b : Fin (kpi D).m} (ha : ¬ R D a) (hab : a ≠ b) {x : Fin (NV X k)}
    (hax : (kpi D).Inc a x) (hbx : (kpi D).Inc b x) : False := by
  obtain ⟨f, rfl, hk⟩ := notR ha
  unfold Inc at hax; rw [ends_nokeep hk] at hax; simp only at hax
  rcases hax with rfl | rfl
  · exact hab (inc_vi hbx).1.symm
  · exact hab (inc_vi hbx).1.symm

/-- **star transfer**: a star 5-colouring of `R D` is a star 5-colouring of `kpi D` -/
theorem kpi_star {c : Fin (kpi D).m → Fin 5} (hc : StarOn (R D) 5 c) : (kpi D).Star 5 c := by
  refine ⟨fun a b hab _ _ => ?_, fun w _ _ _ _ => ?_⟩
  · by_cases ha : R D a
    · by_cases hb : R D b
      · exact hc.1 a b hab ha hb
      · obtain ⟨hne, x, hax, hbx⟩ := hab
        exact (isolated hb (Ne.symm hne) hbx hax).elim
    · obtain ⟨hne, x, hax, hbx⟩ := hab
      exact (isolated ha hne hax hbx).elim
  · by_cases h1 : R D w.e1
    · by_cases h2 : R D w.e2
      · by_cases h3 : R D w.e3
        · by_cases h4 : R D w.e4
          · exact hc.2 w h1 h2 h3 h4
          · exact (isolated h4 (Ne.symm (Walk4.e3_ne_e4 w)) (joins_inc_left w.h4) (joins_inc_right w.h3)).elim
        · exact (isolated h3 (Ne.symm (Walk4.e2_ne_e3 w)) (joins_inc_left w.h3) (joins_inc_right w.h2)).elim
      · exact (isolated h2 (Ne.symm (Walk4.e1_ne_e2 w)) (joins_inc_left w.h2) (joins_inc_right w.h1)).elim
    · exact (isolated h1 (Walk4.e1_ne_e2 w) (joins_inc_right w.h1) (joins_inc_left w.h2)).elim

/-! ### `R D` is cubic -/

theorem inc_eg0 (i : Fin k) : (kpi D).Inc (eg D i 0 (by decide)) (vo (D.p i)) := by
  unfold Inc; rw [ends_eg]; exact Or.inl rfl
theorem inc_eg3 (i : Fin k) : (kpi D).Inc (eg D i 3 (by decide)) (vo (D.p i)) := by
  unfold Inc; rw [ends_eg]; exact Or.inl rfl
theorem inc_eg1 (i : Fin k) : (kpi D).Inc (eg D i 1 (by decide)) (vo (D.q i)) := by
  unfold Inc; rw [ends_eg]; exact Or.inl rfl
theorem inc_eg4 (i : Fin k) : (kpi D).Inc (eg D i 4 (by decide)) (vo (D.q i)) := by
  unfold Inc; rw [ends_eg]; exact Or.inl rfl

theorem eg_ne {i : Fin k} {r s : Nat} {hr : r < 8} {hs : s < 8} (h : r ≠ s) : eg D i r hr ≠ eg D i s hs :=
  fun e => h (eg_inj e).2

theorem digon_of_notkeep {f : Fin X.m} (hf : P f) (hk : ¬ D.Keep f) : ∃ i, f = D.e6 i ∨ f = D.ey i := by
  apply Classical.byContradiction
  intro hn
  exact hk ⟨hf, fun i => ⟨fun h => hn ⟨i, Or.inl h⟩, fun h => hn ⟨i, Or.inr h⟩⟩⟩

theorem kpi_cubic (hcub : CubicOn P) : CubicOn (R D) := by
  intro v ⟨e0, he0, hv0⟩
  rcases vertex_cases v with ⟨x, rfl⟩ | ⟨i, s, hs, rfl⟩ | ⟨f, s, hs, rfl⟩
  · by_cases hp : ∃ i, x = D.p i
    · obtain ⟨i, rfl⟩ := hp
      refine ⟨eg D i 0 (by decide), eg D i 3 (by decide), eo D (D.pp i), R_eg, R_eg, R_eo.2 (keep_pp i),
        inc_eg0 i, inc_eg3 i, (inc_keep (keep_pp i)).2 (D.ipp i), eg_ne (by decide),
        fun h => eo_ne_eg h.symm, fun h => eo_ne_eg h.symm, ?_⟩
      intro d _ hdv
      rcases inc_vo_cases hdv with ⟨g, rfl, hk, hg⟩ | ⟨j, r, hr, rfl, hc⟩
      · rcases D.incp i g hk.1 hg with e | e | e
        · exact absurd e (hk.2 i).1
        · exact absurd e (hk.2 i).2
        · subst e; exact Or.inr (Or.inr rfl)
      · rcases hc with ⟨hr', hx⟩ | ⟨_, hx⟩
        · have := p_inj hx; subst this
          rcases hr' with rfl | rfl
          · exact Or.inl rfl
          · exact Or.inr (Or.inl rfl)
        · exact absurd hx (p_ne_q i j)
    · by_cases hq : ∃ i, x = D.q i
      · obtain ⟨i, rfl⟩ := hq
        refine ⟨eg D i 1 (by decide), eg D i 4 (by decide), eo D (D.pq i), R_eg, R_eg, R_eo.2 (keep_pq i),
          inc_eg1 i, inc_eg4 i, (inc_keep (keep_pq i)).2 (D.ipq i), eg_ne (by decide),
          fun h => eo_ne_eg h.symm, fun h => eo_ne_eg h.symm, ?_⟩
        intro d _ hdv
        rcases inc_vo_cases hdv with ⟨g, rfl, hk, hg⟩ | ⟨j, r, hr, rfl, hc⟩
        · rcases D.incq i g hk.1 hg with e | e | e
          · exact absurd e (hk.2 i).1
          · exact absurd e (hk.2 i).2
          · subst e; exact Or.inr (Or.inr rfl)
        · rcases hc with ⟨_, hx⟩ | ⟨hr', hx⟩
          · exact absurd hx.symm (p_ne_q j i)
          · have := q_inj hx; subst this
            rcases hr' with rfl | rfl
            · exact Or.inl rfl
            · exact Or.inr (Or.inl rfl)
      · have hx : ∀ j, x ≠ D.p j ∧ x ≠ D.q j := fun j => ⟨fun h => hp ⟨j, h⟩, fun h => hq ⟨j, h⟩⟩
        have keepAt : ∀ d, P d → X.Inc d x → D.Keep d := by
          intro d hd hdx
          refine ⟨hd, fun j => ⟨?_, ?_⟩⟩
          · intro h; subst h
            rcases inc_of_joins (D.j6 j) hdx with e | e
            · exact (hx j).1 e
            · exact (hx j).2 e
          · intro h; subst h
            rcases inc_of_joins (D.jy j) hdx with e | e
            · exact (hx j).1 e
            · exact (hx j).2 e
        rcases inc_vo_cases hv0 with ⟨g, rfl, hk, hg⟩ | ⟨j, r, hr, rfl, hc⟩
        · obtain ⟨a, b, c, pa, pb, pc, ia, ib, ic, hab, hac, hbc, hall⟩ := hcub x ⟨g, hk.1, hg⟩
          refine ⟨eo D a, eo D b, eo D c, R_eo.2 (keepAt a pa ia), R_eo.2 (keepAt b pb ib),
            R_eo.2 (keepAt c pc ic), (inc_keep (keepAt a pa ia)).2 ia, (inc_keep (keepAt b pb ib)).2 ib,
            (inc_keep (keepAt c pc ic)).2 ic, fun h => hab (eo_inj h), fun h => hac (eo_inj h),
            fun h => hbc (eo_inj h), ?_⟩
          intro d _ hdx
          rcases inc_vo_cases hdx with ⟨g', rfl, hk', hg'⟩ | ⟨j, r, hr, rfl, hc⟩
          · rcases hall g' hk'.1 hg' with rfl | rfl | rfl
            · exact Or.inl rfl
            · exact Or.inr (Or.inl rfl)
            · exact Or.inr (Or.inr rfl)
          · exfalso
            rcases hc with ⟨_, e⟩ | ⟨_, e⟩
            · exact (hx j).1 e
            · exact (hx j).2 e
        · exfalso
          rcases hc with ⟨_, e⟩ | ⟨_, e⟩
          · exact (hx j).1 e
          · exact (hx j).2 e
  · rcases (show s = 0 ∨ s = 1 ∨ s = 2 ∨ s = 3 by omega) with rfl | rfl | rfl | rfl
    · refine ⟨eg D i 0 (by decide), eg D i 1 (by decide), eg D i 2 (by decide), R_eg, R_eg, R_eg,
        inc_eg i 0 _ 0 hs (by decide), inc_eg i 1 _ 0 hs (by decide), inc_eg i 2 _ 0 hs (by decide),
        eg_ne (by decide), eg_ne (by decide), eg_ne (by decide), ?_⟩
      intro d _ hd
      obtain ⟨r, hr, rfl, hc⟩ := inc_vg_cases hd
      simp at hc
      rcases hc with rfl | rfl | rfl
      · exact Or.inl rfl
      · exact Or.inr (Or.inl rfl)
      · exact Or.inr (Or.inr rfl)
    · refine ⟨eg D i 2 (by decide), eg D i 5 (by decide), eg D i 7 (by decide), R_eg, R_eg, R_eg,
        inc_eg i 2 _ 1 hs (by decide), inc_eg i 5 _ 1 hs (by decide), inc_eg i 7 _ 1 hs (by decide),
        eg_ne (by decide), eg_ne (by decide), eg_ne (by decide), ?_⟩
      intro d _ hd
      obtain ⟨r, hr, rfl, hc⟩ := inc_vg_cases hd
      simp at hc
      rcases hc with rfl | rfl | rfl
      · exact Or.inl rfl
      · exact Or.inr (Or.inl rfl)
      · exact Or.inr (Or.inr rfl)
    · refine ⟨eg D i 3 (by decide), eg D i 5 (by decide), eg D i 6 (by decide), R_eg, R_eg, R_eg,
        inc_eg i 3 _ 2 hs (by decide), inc_eg i 5 _ 2 hs (by decide), inc_eg i 6 _ 2 hs (by decide),
        eg_ne (by decide), eg_ne (by decide), eg_ne (by decide), ?_⟩
      intro d _ hd
      obtain ⟨r, hr, rfl, hc⟩ := inc_vg_cases hd
      simp at hc
      rcases hc with rfl | rfl | rfl
      · exact Or.inl rfl
      · exact Or.inr (Or.inl rfl)
      · exact Or.inr (Or.inr rfl)
    · refine ⟨eg D i 4 (by decide), eg D i 6 (by decide), eg D i 7 (by decide), R_eg, R_eg, R_eg,
        inc_eg i 4 _ 3 hs (by decide), inc_eg i 6 _ 3 hs (by decide), inc_eg i 7 _ 3 hs (by decide),
        eg_ne (by decide), eg_ne (by decide), eg_ne (by decide), ?_⟩
      intro d _ hd
      obtain ⟨r, hr, rfl, hc⟩ := inc_vg_cases hd
      simp at hc
      rcases hc with rfl | rfl | rfl
      · exact Or.inl rfl
      · exact Or.inr (Or.inl rfl)
      · exact Or.inr (Or.inr rfl)
  · exfalso
    obtain ⟨rfl, hk⟩ := inc_vi hv0
    exact hk (R_eo.1 he0)

/-! ### `R D` is connected -/

theorem gadget_eqs (U : Fin (NV X k) → Bool) (i : Fin k)
    (hU : ∀ r (hr : r < 8), U ((kpi D).ends (eg D i r hr)).1 = U ((kpi D).ends (eg D i r hr)).2) :
    U (vo (D.p i)) = U (vC i) ∧ U (vo (D.q i)) = U (vC i) ∧ U (vC i) = U (vX i) ∧ U (vo (D.p i)) = U (vY i) ∧
      U (vo (D.q i)) = U (vZ i) := by
  have e0 := hU 0 (by decide); have e1 := hU 1 (by decide); have e2 := hU 2 (by decide)
  have e3 := hU 3 (by decide); have e4 := hU 4 (by decide)
  rw [ends_eg] at e0 e1 e2 e3 e4
  exact ⟨e0, e1, e2, e3, e4⟩

theorem kpi_connected (hconn : ConnectedOn P) : ConnectedOn (R D) := by
  intro U hU f g hf hg
  have hG : ∀ i, U (vo (D.p i)) = U (vC i) ∧ U (vo (D.q i)) = U (vC i) ∧ U (vC i) = U (vX i) ∧
      U (vo (D.p i)) = U (vY i) ∧ U (vo (D.q i)) = U (vZ i) :=
    fun i => gadget_eqs U i (fun r hr => hU _ R_eg)
  have hpq : ∀ i, U (vo (D.p i)) = U (vo (D.q i)) := fun i => (hG i).1.trans (hG i).2.1.symm
  have hV : ∀ f, P f → U (vo (X.ends f).1) = U (vo (X.ends f).2) := by
    intro f hf
    by_cases hk : D.Keep f
    · have := hU (eo D f) (R_eo.2 hk); rw [ends_keep hk] at this; exact this
    · obtain ⟨i, hi⟩ := digon_of_notkeep hf hk
      have hj : X.Joins f (D.p i) (D.q i) := by
        rcases hi with rfl | rfl
        · exact D.j6 i
        · exact D.jy i
      rcases hj with h | h <;> rw [h]
      · exact hpq i
      · exact (hpq i).symm
  have hc := hconn (fun x => U (vo x)) hV
  have key : ∀ e, R D e → ∃ g, P g ∧ U ((kpi D).ends e).1 = U (vo (X.ends g).1) := by
    intro e he
    rcases edge_cases e with ⟨f0, rfl⟩ | ⟨i, r, hr, rfl⟩
    · have hk := R_eo.1 he
      exact ⟨f0, hk.1, by rw [ends_keep hk]⟩
    · refine ⟨D.e6 i, D.P6 i, ?_⟩
      have h6 : U (vo (X.ends (D.e6 i)).1) = U (vo (D.p i)) := by
        rcases D.j6 i with h | h <;> rw [h]
        exact (hpq i).symm
      rw [h6, ends_eg]
      obtain ⟨g0, g1, g2, g3, g4⟩ := hG i
      rcases r8 hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp only [gEnds]
      · exact (hpq i).symm
      · exact g0.symm
      · exact (hpq i).symm
      · exact g2.symm.trans g0.symm
      · exact g3.symm
      · exact g2.symm.trans g0.symm
  obtain ⟨g1, pg1, h1⟩ := key f hf
  obtain ⟨g2, pg2, h2⟩ := key g hg
  rw [h1, h2]
  exact hc g1 g2 pg1 pg2

/-! ### `R D` is bridgeless -/

theorem kpi_bridgeless (hb : BridgelessOn P) : BridgelessOn (R D) := by
  intro e he B
  have hsepg : ∀ i r (hr : r < 8), eg D i r hr ≠ e → B.U (gEnds D i r).1 = B.U (gEnds D i r).2 := by
    intro i r hr hne
    have := B.sep _ R_eg hne
    rw [ends_eg] at this
    exact this
  rcases edge_cases e with ⟨f, rfl⟩ | ⟨i, r, hr, rfl⟩
  · have hk := R_eo.1 he
    apply bridgeless_sep hb hk.1 (fun x => B.U (vo x))
    · have hu := B.hu; have hv := B.hv
      rw [ends_keep hk] at hu hv
      simp only at hu hv
      rw [hu, hv]; decide
    · intro g hg hgf
      by_cases hkg : D.Keep g
      · have := B.sep (eo D g) (R_eo.2 hkg) (fun h => hgf (eo_inj h))
        rw [ends_keep hkg] at this; exact this
      · obtain ⟨i, hi⟩ := digon_of_notkeep hg hkg
        have a0 : B.U (vo (D.p i)) = B.U (vC i) := hsepg i 0 (by decide) (fun h => eo_ne_eg h.symm)
        have a1 : B.U (vo (D.q i)) = B.U (vC i) := hsepg i 1 (by decide) (fun h => eo_ne_eg h.symm)
        have hj : X.Joins g (D.p i) (D.q i) := by
          rcases hi with rfl | rfl
          · exact D.j6 i
          · exact D.jy i
        rcases hj with h | h <;> rw [h]
        · exact a0.trans a1.symm
        · exact a1.trans a0.symm
  · have hu := B.hu; have hv := B.hv
    rw [ends_eg] at hu hv
    have t : ∀ s (hs : s < 8), s ≠ r → B.U (gEnds D i s).1 = B.U (gEnds D i s).2 :=
      fun s hs hsr => hsepg i s hs (fun h => hsr (eg_inj h).2)
    have t0 := t 0 (by decide); have t1 := t 1 (by decide); have t2 := t 2 (by decide)
    have t3 := t 3 (by decide); have t4 := t 4 (by decide); have t5 := t 5 (by decide)
    have t6 := t 6 (by decide); have t7 := t 7 (by decide)
    simp only [gEnds] at t0 t1 t2 t3 t4 t5 t6 t7
    rcases r8 hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp only [gEnds] at hu hv <;>
      simp_all

/-! ### `R D` is simple -/

/-- no two distinct edges of `P` join the same pair of vertices -/
def SimpleOn {G : MGraph} (P : Fin G.m → Prop) : Prop :=
  ∀ f g x y, P f → P g → G.Joins f x y → G.Joins g x y → f = g

@[simp] theorem vo_eq_vg_iff {x : Fin X.n} {i : Fin k} {r : Nat} {hr : r < 4} :
    ((vo x : Fin (NV X k)) = vg i r hr) ↔ False := ⟨vo_ne_vg, False.elim⟩
@[simp] theorem vg_eq_vo_iff {x : Fin X.n} {i : Fin k} {r : Nat} {hr : r < 4} :
    ((vg i r hr : Fin (NV X k)) = vo x) ↔ False := ⟨fun h => vo_ne_vg h.symm, False.elim⟩
@[simp] theorem vo_eq_vo_iff {x y : Fin X.n} : ((vo x : Fin (NV X k)) = vo y) ↔ x = y :=
  ⟨vo_inj, fun h => h ▸ rfl⟩
@[simp] theorem vg_eq_vg_iff {i j : Fin k} {r s : Nat} {hr : r < 4} {hs : s < 4} :
    ((vg i r hr : Fin (NV X k)) = vg j s hs) ↔ i = j ∧ r = s :=
  ⟨vg_inj, fun ⟨h1, h2⟩ => by subst h1; subst h2; rfl⟩
@[simp] theorem p_eq_q_iff {i j : Fin k} : D.p i = D.q j ↔ False := ⟨p_ne_q i j, False.elim⟩
@[simp] theorem q_eq_p_iff {i j : Fin k} : D.q i = D.p j ↔ False := ⟨fun h => p_ne_q j i h.symm, False.elim⟩
@[simp] theorem p_eq_p_iff {i j : Fin k} : D.p i = D.p j ↔ i = j := ⟨p_inj, fun h => h ▸ rfl⟩
@[simp] theorem q_eq_q_iff {i j : Fin k} : D.q i = D.q j ↔ i = j := ⟨q_inj, fun h => h ▸ rfl⟩

theorem joins_keep_iff {f : Fin X.m} (hk : D.Keep f) {a b : Fin X.n} :
    (kpi D).Joins (eo D f) (vo a) (vo b) ↔ X.Joins f a b := by
  refine ⟨fun h => ?_, joins_kpi hk⟩
  unfold Joins at h; rw [ends_keep hk] at h
  rcases h with h | h
  · exact Or.inl (Prod.ext (vo_inj (Prod.mk.inj h).1) (vo_inj (Prod.mk.inj h).2))
  · exact Or.inr (Prod.ext (vo_inj (Prod.mk.inj h).1) (vo_inj (Prod.mk.inj h).2))

theorem joins_keep_old {f : Fin X.m} (hk : D.Keep f) {x y : Fin (NV X k)} (h : (kpi D).Joins (eo D f) x y) :
    ∃ a b, x = vo a ∧ y = vo b ∧ X.Joins f a b := by
  unfold Joins at h; rw [ends_keep hk] at h
  rcases h with h | h
  · exact ⟨_, _, (Prod.mk.inj h).1.symm, (Prod.mk.inj h).2.symm, Or.inl rfl⟩
  · exact ⟨_, _, (Prod.mk.inj h).2.symm, (Prod.mk.inj h).1.symm, Or.inr rfl⟩

/-- `Joins` at a gadget edge, with the equations stated in `Fin (NV X k)` (so that `simp` lemmas about `vo`/`vg` apply) -/
theorem joins_eg_iff {i : Fin k} {r : Nat} {hr : r < 8} {x y : Fin (kpi D).n} :
    (kpi D).Joins (eg D i r hr) x y ↔
      (@Eq (Fin (NV X k)) (gEnds D i r).1 x ∧ @Eq (Fin (NV X k)) (gEnds D i r).2 y) ∨
      (@Eq (Fin (NV X k)) (gEnds D i r).1 y ∧ @Eq (Fin (NV X k)) (gEnds D i r).2 x) := by
  unfold Joins; rw [ends_eg]
  constructor
  · intro h
    rcases h with h | h
    · exact Or.inl ⟨congrArg Prod.fst h, congrArg Prod.snd h⟩
    · exact Or.inr ⟨congrArg Prod.fst h, congrArg Prod.snd h⟩
  · intro h
    rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact Or.inl (Prod.ext h1 h2)
    · exact Or.inr (Prod.ext h1 h2)

theorem not_joins_eg_old {j : Fin k} {s : Nat} {hs : s < 8} {a b : Fin X.n} :
    ¬ (kpi D).Joins (eg D j s hs) (vo a) (vo b) := by
  intro h
  have h' := joins_eg_iff.1 h
  rcases r8 hs with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp [gEnds, vC, vX, vY, vZ] at h'

theorem kpi_simple : SimpleOn (R D) := by
  intro f g x y hf hg hfj hgj
  rcases edge_cases f with ⟨f0, rfl⟩ | ⟨i, r, hr, rfl⟩ <;> rcases edge_cases g with ⟨g0, rfl⟩ | ⟨j, s, hs, rfl⟩
  · have hkf := R_eo.1 hf
    have hkg := R_eo.1 hg
    obtain ⟨a, b, rfl, rfl, hab⟩ := joins_keep_old hkf hfj
    have hgab : X.Joins g0 a b := (joins_keep_iff hkg).1 hgj
    by_cases hfg : f0 = g0
    · rw [hfg]
    · obtain ⟨i, hi⟩ := D.allDig f0 g0 a b hkf.1 hkg.1 hfg hab hgab
      rcases hi with h | h
      · exact absurd h (hkf.2 i).1
      · exact absurd h (hkf.2 i).2
  · obtain ⟨a, b, rfl, rfl, -⟩ := joins_keep_old (R_eo.1 hf) hfj
    exact absurd hgj not_joins_eg_old
  · obtain ⟨a, b, rfl, rfl, -⟩ := joins_keep_old (R_eo.1 hg) hgj
    exact absurd hfj not_joins_eg_old
  · have hf' := joins_eg_iff.1 hfj
    have hg' := joins_eg_iff.1 hgj
    rcases hf' with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · obtain ⟨rfl, rfl⟩ : x = (gEnds D i r).1 ∧ y = (gEnds D i r).2 := ⟨h1.symm, h2.symm⟩
      rcases r8 hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
        rcases r8 hs with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
        simp [gEnds, vC, vX, vY, vZ] at hg' <;> simp_all
    · obtain ⟨rfl, rfl⟩ : y = (gEnds D i r).1 ∧ x = (gEnds D i r).2 := ⟨h1.symm, h2.symm⟩
      rcases r8 hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
        rcases r8 hs with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
        simp [gEnds, vC, vX, vY, vZ] at hg' <;> simp_all

/-! ### the colouring `c'` of the replacement lemma exists -/

section subcol
variable {G H : MGraph} {Q : Fin G.m → Prop} {k' : Nat}

theorem ey_ne_e6 (S : PiSubstOn G H Q k') (h6y : ∀ i, S.e6 i ≠ S.ey i) (i j : Fin k') : S.ey i ≠ S.e6 j := by
  intro h
  by_cases hij : i = j
  · subst hij; exact h6y i h.symm
  · have h1 := S.jy i
    rw [h] at h1
    rcases joins_unique h1 (S.j6 j) with ⟨e, _⟩ | ⟨e, _⟩
    · exact (S.disj i j hij).1 e
    · exact (S.disj i j hij).2.1 e

theorem ey_inj (S : PiSubstOn G H Q k') {i j : Fin k'} (h : S.ey i = S.ey j) : i = j := by
  apply Classical.byContradiction
  intro hij
  have h1 := S.jy i
  rw [h] at h1
  rcases joins_unique h1 (S.jy j) with ⟨e, _⟩ | ⟨e, _⟩
  · exact (S.disj i j hij).1 e
  · exact (S.disj i j hij).2.1 e

theorem subColour_exists (S : PiSubstOn G H Q k') (h6y : ∀ i, S.e6 i ≠ S.ey i) (c : Fin H.m → Fin 5) :
    ∃ c' : Fin G.m → Fin 6, SubColourOn S c c' := by
  refine ⟨fun f => if h : ∃ i, f = S.e6 i then Fin.last 5 else
    if h' : ∃ i, f = S.ey i then Fin.castSucc (twin (S.copy (Classical.choose h')) c)
    else Fin.castSucc (c (S.old f)), ⟨?_, ?_, ?_⟩⟩
  · intro i
    rw [dif_pos ⟨i, rfl⟩]
  · intro i
    have hn : ¬ ∃ j, S.ey i = S.e6 j := fun ⟨j, hj⟩ => ey_ne_e6 S h6y i j hj
    rw [dif_neg hn, dif_pos ⟨i, rfl⟩]
    have hs := Classical.choose_spec (⟨i, rfl⟩ : ∃ j, S.ey i = S.ey j)
    rw [← ey_inj S hs]
  · intro f _ ho
    have hn : ¬ ∃ j, f = S.e6 j := fun ⟨j, hj⟩ => (ho j).1 hj
    have hn' : ¬ ∃ j, f = S.ey j := fun ⟨j, hj⟩ => (ho j).2 hj
    rw [dif_neg hn, dif_neg hn']

end subcol

/-- a star 5-colouring of `R D` gives a star 6-colouring of `P` (replacement lemma, fact 3a172a440dfeed42) -/
theorem kpi_colour (hl : MGraph.Loopless X) (D : DigonList X P k) {c : Fin (kpi D).m → Fin 5}
    (hc : StarOn (R D) 5 c) : Colourable P 6 := by
  obtain ⟨c', hC⟩ := subColour_exists (kpi_subst hl D) D.h6y c
  exact ⟨c', pi_subst_on (kpi_subst hl D) c (kpi_star hc) c' hC⟩

/-- **The multigraph K^Π(𝒟) of fact 85bb5f970f208c0b.**  For a loopless multigraph `X`, an edge set `P` of `X` and a
    list `D` of `k` pairwise vertex-disjoint digons of `P` containing every pair of parallel `P`-edges, the edge set
