FlowerSnark.flower_star : ∀ (n : ℕ), n % 2 = 1 → 5 ≤ n → MGraph.Star 5 (FlowerSnark.flowerCol n)
GoldbergSnark.goldberg_star : ∀ (k : ℕ), k % 2 = 1 → 5 ≤ k → MGraph.Star 5 (GoldbergSnark.goldbergCol k)
GPetersen2.gp2_star : ∀ (k : ℕ), 5 ≤ k → MGraph.Star 6 (GPetersen2.gpCol k)
GPetersen2.gp2_spokes : ∀ (k : ℕ) (e : Fin (GPetersen2.gp2 k).m), ↑(GPetersen2.gpCol k e) = 5 ↔ ↑e % 3 = 1
GP2Five.star5 : ∀ (n : ℕ), 5 ≤ n → MGraph.Star 5 (GP2Five.col n)
GP3Five.star5 : ∀ (n : ℕ), 7 ≤ n → MGraph.Star 5 (GP3Five.col n)
FlowerSnark.flower_family : ∀ (n : ℕ), n % 2 = 1 → 5 ≤ n → StarFamily (FlowerSnark.flowerSnark n) 5
GoldbergSnark.goldberg_family : ∀ (k : ℕ), k % 2 = 1 → 5 ≤ k → StarFamily (GoldbergSnark.goldbergSnark k) 5
GPetersen2.gp2_spoke_family : ∀ (k : ℕ),
  5 ≤ k →
    (GPetersen2.gp2 k).Subcubic ∧
      (GPetersen2.gp2 k).Loopless ∧
        MGraph.Star 6 (GPetersen2.gpCol k) ∧ ∀ (e : Fin (GPetersen2.gp2 k).m), ↑(GPetersen2.gpCol k e) = 5 ↔ ↑e % 3 = 1
GP2Five.gp2_family : ∀ (n : ℕ), 5 ≤ n → StarFamily (GPetersen2.gp2 n) 5
GP3Five.gp3_family : ∀ (n : ℕ), 7 ≤ n → StarFamily (GP3Five.gp3 n) 5
def StarFamily : MGraph → ℕ → Prop :=
fun G k =>
  G.Subcubic ∧
    G.Loopless ∧ (∀ (P : Fin G.m → Prop), MGraph.Colourable P k) ∧ ∀ (P : Fin G.m → Prop), MGraph.Colourable P 6
def BlockStar.DMSfor : MGraph → Prop :=
fun G => G.Subcubic → G.Loopless → ∀ (P : Fin G.m → Prop), MGraph.Colourable P 6
dms_iff : RH2F.DMS ↔ ∀ (G : MGraph), DMSfor G
@starFamily_dms : ∀ {G : MGraph} {k : ℕ}, StarFamily G k → DMSfor G
